# Optional compiler features.
#
# Each feature is declared once with reussir_feature(). The declarations are
# the single list the rest of the build derives from: the C API table behind
# `reussirFeatureGet` (and the feature list in the drivers' `--help`), the
# frontend's diagnostics for programs that need a disabled feature, and the
# lit features of the integration tests.

# reussir_feature(<name> <enabled> <description>)
#   <name>         lowercase identifier shown to users and used as a lit feature
#   <enabled>      a CMake boolean
#   <description>  one line of plain text, shown in `--help`
function(reussir_feature name enabled description)
  if(NOT name MATCHES "^[a-z][a-z0-9-]*$")
    message(FATAL_ERROR "reussir_feature: invalid feature name '${name}'")
  endif()
  if(description MATCHES "[\"\\\\]")
    message(FATAL_ERROR "reussir_feature: description of '${name}' must not contain quotes or backslashes")
  endif()
  if(enabled)
    set(enabled 1)
  else()
    set(enabled 0)
  endif()
  set_property(GLOBAL APPEND PROPERTY REUSSIR_FEATURES ${name})
  set_property(GLOBAL PROPERTY REUSSIR_FEATURE_ENABLED_${name} ${enabled})
  set_property(GLOBAL PROPERTY REUSSIR_FEATURE_DESCRIPTION_${name} "${description}")
endfunction()

# reussir_write_features(<output>)
# Writes the declared features as `REUSSIR_FEATURE(name, enabled, "description")`
# lines for the C API, and sets REUSSIR_ENABLED_FEATURES in the caller's scope.
function(reussir_write_features output)
  get_property(features GLOBAL PROPERTY REUSSIR_FEATURES)
  set(content "// Generated by cmake/ReussirFeatures.cmake. Do not edit.\n")
  set(enabled_features "")
  foreach(name ${features})
    get_property(enabled GLOBAL PROPERTY REUSSIR_FEATURE_ENABLED_${name})
    get_property(description GLOBAL PROPERTY REUSSIR_FEATURE_DESCRIPTION_${name})
    string(APPEND content "REUSSIR_FEATURE(${name}, ${enabled}, \"${description}\")\n")
    if(enabled)
      list(APPEND enabled_features ${name})
    endif()
  endforeach()
  file(CONFIGURE OUTPUT ${output} CONTENT "${content}" @ONLY)
  set(REUSSIR_ENABLED_FEATURES "${enabled_features}" PARENT_SCOPE)
endfunction()
