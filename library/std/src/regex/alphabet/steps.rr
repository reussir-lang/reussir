//! In or out for every code point, changing at only a few of them.

import std::collections::pure::list::List;
import std::collections::pure::wavlmap::Entry;
import std::collections::pure::wavlmap::WavlMap;
import std::option::Option;

/// In or out for every code point, held as the code points at which that
/// changes: `first` is the value from zero, and the entry `(k, v)` says the
/// value is `v` from `k` up to the next key. Zero counts as a key.
pub struct Steps {
    first: bool,
    changes: WavlMap<u32, bool>
}

/// A stretch of code points with one value: `start` up to `end`, `end` not
/// included.
pub struct [value] Span {
    pub start: u32,
    pub end: u32,
    pub value: bool
}

// The span from `start` with `value`, then the entries as spans; the last
// one ends at `limit`.
fn spans_from(start: u32, value: bool, entries: List<Entry<u32, bool>>, limit: u32) -> List<Span> {
    match entries {
        Nil => List::Cons { Span { start: start, end: limit, value: value }, List::Nil },
        Cons(next, rest) => List::Cons {
            Span { start: start, end: next.key, value: value },
            spans_from(next.key, next.value, rest, limit)
        }
    }
}

fn remove_keys(changes: WavlMap<u32, bool>, entries: List<Entry<u32, bool>>) -> WavlMap<u32, bool> {
    match entries {
        Nil => changes,
        Cons(entry, rest) => remove_keys(changes.remove(entry.key), rest)
    }
}

impl Steps {
    /// `value` at every code point.
    pub fn constant(value: bool) -> Self {
        Steps { first: value, changes: WavlMap::new() }
    }

    /// The value at `point`. O(log n).
    pub fn at(self: Self, point: u32) -> bool {
        match self.changes.floor_entry(point) {
            Some(entry) => entry.value,
            None => self.first
        }
    }

    /// The number of code points at which the value is given.
    pub fn len(self: Self) -> u64 {
        self.changes.len() + 1
    }

    /// The first key after `point`.
    pub fn next_key(self: Self, point: u32) -> Option<u32> {
        self.changes.successor_entry(point).map(|entry| entry.key)
    }

    // Makes `point` a key with `value`.
    fn put(self: Self, point: u32, value: bool) -> Self {
        if point == 0 { Steps { first: value, changes: self.changes } } else {
            Steps { first: self.first, changes: self.changes.insert(point, value) }
        }
    }

    // Drops the key `point` when the value does not change there.
    fn join(self: Self, point: u32) -> Self {
        if point > 0 && self.changes.contains_key(point) && self.at(point - 1) == self.at(point) {
            Steps { first: self.first, changes: self.changes.remove(point) }
        } else {
            self
        }
    }

    /// `value` from `start` up to `end`, `end` not included, and the old
    /// values elsewhere. O(log n) and the keys in between.
    pub fn fill(self: Self, start: u32, end: u32, value: bool) -> Self {
        if start >= end { self } else {
            let after = self.at(end);
            let kept = remove_keys(self.changes, self.changes.range_to_list(start, end));
            let rest = Steps { first: self.first, changes: kept.insert(end, after) };
            rest.put(start, value).join(end).join(start)
        }
    }

    /// The spans in order; the last ends at `limit`.
    pub fn spans(self: Self, limit: u32) -> List<Span> {
        spans_from(0, self.first, self.changes.to_list(), limit)
    }
}

impl PartialEq for Steps {
    fn eq(self: Self, other: Self) -> bool {
        self.first == other.first && self.changes == other.changes
    }
}
