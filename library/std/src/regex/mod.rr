//! Regular expressions matched with derivatives, over bytes.
//!
//! - `alphabet`: sets of bytes and of characters, the classes of bytes, and
//!   the UTF-8 encodings of a set of characters.
//! - `tree`: the regex a caller builds, and the same regex over bytes only.
//! - `node`: regexes as nodes of a table, where equal regexes are the same
//!   node, and their derivatives.
//! - `automaton`: the states and transitions of a list of rules.
//! - `search`: finding in a text, from any place of it.

pub mod alphabet;
pub mod automaton;
pub mod node;
pub mod search;
pub mod tree;
