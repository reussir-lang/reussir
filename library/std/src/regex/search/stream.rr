//! The matches of a text, pulled one after another.

import std::regex::automaton::Found;
import std::regex::automaton::Match;
import std::regex::search::Occurrences;
import std::regex::search::Searcher;
import std::regex::search::Searching;
import std::regex::search::skip;
import std::text::TextView;

impl Occurrences {
    /// The first match that begins where the stream stands or after, and
    /// the stream after it. After `Nothing` the stream stays where it is:
    /// no match is left in the text, and pulling again searches the rest
    /// of the text again to say so. A stream that begins past the end of
    /// the text answers `Nothing` too.
    pub fn next(self: Self) -> (Occurrences, Found) {
        // The places are read first, so that taking `searching` is the
        // last use of `self` and moves it.
        let at = self.at;
        let barred = self.barred;
        let searching = self.searching;
        match searching.searcher.way {
            // The third word of such a stream is its credit.
            Skip => {
                let (last, start, end, credit) = searching.next_skipped(at, barred);
                if last == 0 { (Occurrences { searching, at, barred: credit }, Found::Nothing) } else {
                    let found = Match { rule: searching.searcher.rule(last), start, end };
                    (Occurrences { searching, at: end, barred: credit }, Found::Matched { found })
                }
            },
            _ => match searching.next_match(at, barred == at) {
                Matched(found) => {
                    let (at, barred) = Searching::after(found.start, found.end);
                    (Occurrences { searching, at, barred }, Found::Matched { found })
                },
                Nothing => (Occurrences { searching, at, barred }, Found::Nothing)
            }
        }
    }

    /// The index of the byte where the search for the next match begins:
    /// the end of the match before, or one byte after it when that match
    /// had no bytes; before any match, the place that the stream was made
    /// from. It is greater than the length of the text for a stream made
    /// past the end, and after a match of no bytes at the end.
    pub fn at(self: Self) -> u64 {
        self.at
    }

    /// Folds over the matches left in the stream, one after another, up
    /// to the end of the text.
    pub fn fold<A>(self: Self, initial: A, step: (A, Match) -> A) -> A {
        // `step` is passed along to the fold of the rest, which lets the
        // compiler specialize the fold for a closure written at the call;
        // a loop clones the closure for every match. A fold that hands
        // `step` to one of two folds is no faster than such a loop, so
        // the way of the searcher is asked for every match, in `next`,
        // and not once here.
        let (rest, found) = self.next();
        match found {
            Matched(found) => rest.fold(step(initial, found), step),
            Nothing => initial
        }
    }

    /// The number of matches left in the stream. No rule is looked up for
    /// them.
    pub fn count(self: Self) -> u64 {
        let at = self.at;
        let barred = self.barred;
        self.searching.count(at, barred)
    }
}

impl Searching {
    // Where a stream stands after a match from `start` to `end`, and the
    // place where a match of no bytes is not given, its end: the stream
    // stands one byte after a match of no bytes, so that it is not found
    // again, and else at the end of the match.
    fn after(start: u64, end: u64) -> (u64, u64) {
        if end == start {
            (end + 1, end)
        } else {
            (end, end)
        }
    }

    // The next match of a stream that stands at the byte `at`: its cell,
    // its beginning and its end, as `Searcher::sought` gives them. When
    // `ended` says that a match ended at `at`, a match of no bytes there
    // is passed over. The stream keeps `self` across the call, so the
    // searcher, its automaton and its finder are read here without
    // counting references.
    fn next_span(self: Self, at: u64, ended: bool) -> (u32, u64, u64) {
        let length = self.input.len();
        let (last, start, end) = self.searcher.sought(self.bytes, length, at);
        if ended && last != 0 && end == at {
            self.searcher.sought(self.bytes, length, at + 1)
        } else {
            (last, start, end)
        }
    }

    // The next match of a stream that stands at the byte `at` when the
    // searcher skips, as `next_span` gives it, and what is left of the
    // `credit` of the stream. No match of such a searcher is one of no
    // bytes. As in `next_span`, no reference is counted.
    fn next_skipped(self: Self, at: u64, credit: u64) -> (u32, u64, u64, u64) {
        let length = self.input.len();
        let (last, start, end, more, credit) = self.searcher.skipped(self.bytes, length, at, credit);
        if more {
            let (last, start, end) = self.searcher.sought(self.bytes, length, start);
            (last, start, end, credit)
        } else {
            (last, start, end, credit)
        }
    }

    // The next match of a stream that stands at the byte `at` when the
    // rules match one literal and nothing else, as `Searcher::spotted`
    // gives it: where it begins and where it ends, which is the same
    // place when there is none. A literal has bytes, so no match of none
    // is passed over. As in `next_span`, no reference is counted.
    fn next_place(self: Self, at: u64) -> (u64, u64) {
        self.searcher.spotted(self.bytes, self.input.len(), at)
    }

    // The next match of a stream that stands at the byte `at` when the
    // sets are sought, as `Searcher::fitted` gives it. Such a match has
    // bytes, so no match of none is passed over. As in `next_span`, no
    // reference is counted.
    fn next_fitted(self: Self, at: u64) -> (u32, u64, u64) {
        self.searcher.fitted(self.bytes, self.input.len(), at)
    }

    // The same as a match with its rule, for a searcher that does not
    // skip: the stream of one that skips asks `next_skipped`, which
    // keeps its credit. A literal that is all the rules match is found
    // without the automaton, and its rule is the first.
    fn next_match(self: Self, at: u64, ended: bool) -> Found {
        match self.searcher.way {
            Sets => {
                let (last, start, end) = self.next_fitted(at);
                if last == 0 { Found::Nothing } else {
                    Found::Matched { Match { rule: self.searcher.rule(last), start, end } }
                }
            },
            Literal => {
                let (start, end) = self.next_place(at);
                if start < end {
                    Found::Matched { Match { rule: 0, start, end } }
                } else {
                    Found::Nothing
                }
            },
            _ => {
                let (last, start, end) = self.next_span(at, ended);
                if last == 0 { Found::Nothing } else {
                    Found::Matched { Match { rule: self.searcher.rule(last), start, end } }
                }
            }
        }
    }

    // The number of matches of a stream that stands at the byte `at`,
    // after a match that ended at `barred`, which is the credit of the
    // stream when the searcher skips. The way is asked once, and each
    // way has its loop to itself.
    fn count(self: Self, at: u64, barred: u64) -> u64 {
        match self.searcher.way {
            Literal => self.count_places(at),
            Skip => self.count_skipped(at, barred),
            Sets => self.count_fitted(at),
            _ => self.count_spans(at, barred)
        }
    }

    // The same when the rules match one literal and nothing else: the
    // next place of the literal is sought from the end of the one before.
    fn count_places(self: Self, at: u64) -> u64 {
        let (_, count, _) = while [at = at, count = (0 as u64), going = true] (going) {
            let (start, end) = self.next_place(at);
            if start < end {
                (end, count + 1, true)
            } else {
                (at, count, false)
            }
        };
        count
    }

    // The same when the searcher skips, with `credit` for the places that
    // fail: the next search begins at the end of the match before.
    fn count_skipped(self: Self, at: u64, credit: u64) -> u64 {
        let (_, _, count, _) = while [at = at, credit = credit, count = (0 as u64), going = true] (going) {
            let (last, _, end, credit) = self.next_skipped(at, credit);
            if last == 0 { (at, credit, count, false) } else { (end, credit, count + 1, true) }
        };
        count
    }

    // The same when the sets are sought: the next search begins at the
    // end of the match before. The loop ends on the cell of no match and
    // has no flag for it: with one, the loop of the literal above was
    // built with two more values to carry for every match.
    fn count_fitted(self: Self, at: u64) -> u64 {
        let (_, count, _) = while [at = at, count = (0 as u64), last = (1 as u32)] (last != 0) {
            let (last, _, end) = self.next_fitted(at);
            (end, if last == 0 { count } else { count + 1 }, last)
        };
        count
    }

    // The same when the automaton matches at every place that is tried.
    fn count_spans(self: Self, at: u64, barred: u64) -> u64 {
        let (_, _, count, _) = while [at = at, barred = barred, count = (0 as u64), going = true] (going) {
            let (last, start, end) = self.next_span(at, barred == at);
            if last == 0 { (at, barred, count, false) } else {
                let (at, barred) = Searching::after(start, end);
                (at, barred, count + 1, true)
            }
        };
        count
    }
}

impl Searcher {
    /// The matches of the rules in `input`, one after another, from the
    /// byte `from` on. To take them all, pull from the stream, fold over
    /// it or count: that asks for the searcher once for the whole text.
    pub fn occurrences(self: Self, input: TextView, from: u64) -> Occurrences {
        let searching = Searching { searcher: self, bytes: input.unsafe_data_ptr(), input };
        // No match ended at `from` yet: any other place says so. A
        // searcher that skips has its credit there.
        let barred = match self.way {
            Skip => skip::allowance(),
            _ => if from == 0 {
                1
            } else {
                0
            }
        };
        Occurrences { searching, at: from, barred }
    }

    /// Folds over the matches of the rules in `input` from the byte `from`
    /// on, one after another, up to the end of the input.
    pub fn fold<A>(self: Self, input: TextView, from: u64, initial: A, step: (A, Match) -> A) -> A {
        self.occurrences(input, from).fold(initial, step)
    }

    /// The number of matches of the rules in `input` from the byte `from`
    /// on.
    pub fn count(self: Self, input: TextView, from: u64) -> u64 {
        self.occurrences(input, from).count()
    }
}
