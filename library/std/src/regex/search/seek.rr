//! One search: the first match from a place, and whether there is one.

import core::ptr::Generic;
import std::regex::automaton::Found;
import std::regex::automaton::Match;
import std::regex::automaton::native;
import std::regex::automaton::scan;
import std::regex::search::Searcher;
import std::text::TextView;

impl Searcher {
    /// The first match in `input` that begins at the byte `from` or after
    /// it: the one that begins first, and of those the longest. It may
    /// have no bytes. To go on after a match, pull from `occurrences`: a
    /// search from the end of a match of no bytes finds it again, and
    /// every call from another package counts a reference to the searcher
    /// and asks the text for its bytes, which the stream, `fold` and
    /// `count` do once for a text.
    pub fn find(self: Self, input: TextView, from: u64) -> Found {
        let (last, start, end) = self.sought(input.unsafe_data_ptr(), input.len(), from);
        // The length is asked for again so that the last use of `input`
        // comes after its bytes are read through the pointer.
        if last == 0 || end > input.len() { Found::Nothing } else {
            Found::Matched { Match { rule: self.rule(last), start, end } }
        }
    }

    /// Whether a rule matches somewhere in `input` from the byte `from`
    /// on. The search ends at the first state that accepts: at the first
    /// place that has a match, it does not wait for the end of the longest
    /// one. The places that have none cost what they cost `find`.
    pub fn is_match(self: Self, input: TextView, from: u64) -> bool {
        let found = self.any(input.unsafe_data_ptr(), input.len(), from);
        // As in `find`, the last use of `input` comes after the search.
        // Past the end `any` has said that there is none.
        if from <= input.len() {
            found
        } else {
            false
        }
    }

    // The earliest rule that accepts in the state of `cell`, the cell of a
    // match.
    fn rule(self: Self, cell: u32) -> u32 {
        scan::rule(self.automaton, cell)
    }

    // The next place to try from `at`: where a first byte is, or the end
    // of the bytes when there is none. Four bytes are tested one by one
    // before the finder is asked, which costs more than they do when a
    // first byte is that near.
    fn place(self: Self, bytes: ConstPtr<Generic>, length: u64, at: u64) -> u64 {
        if self.seeks {
            let (near, left) = while [near = at, left = (4 as u64)] (left > 0 && near < length && !scan::opens(self.automaton, native::byte_at(bytes, near))) {
                (near + 1, left - 1)
            };
            if left == 0 {
                self.finder.unsafe_find(bytes, length, near)
            } else {
                near
            }
        } else {
            at
        }
    }

    // The first match that begins at the byte `from` of the `length` bytes
    // at `bytes` or after it: the cell of the state that accepts it, where
    // it begins and where it ends; the cell 0 when there is none. Past the
    // end there is none.
    fn sought(self: Self, bytes: ConstPtr<Generic>, length: u64, from: u64) -> (u32, u64, u64) {
        // The automaton is taken once, and every place reads it without
        // counting a reference.
        let automaton = self.automaton;
        let (_, last, start, end, _) = while [at = from, last = 0, start = from, end = from, going = true] (going) {
            let place = self.place(bytes, length, at);
            let (last, end) = scan::scan(automaton, bytes, length, place);
            // Without a match the search goes on from the next byte.
            if last == 0 && place < length {
                (place + 1, last, place, end, true)
            } else {
                (place, last, place, end, false)
            }
        };
        (last, start, end)
    }

    // Whether a match begins at the byte `from` of those bytes or after
    // it.
    fn any(self: Self, bytes: ConstPtr<Generic>, length: u64, from: u64) -> bool {
        let automaton = self.automaton;
        let (_, found, _) = while [at = from, found = false, going = true] (going) {
            let place = self.place(bytes, length, at);
            let found = scan::begins(automaton, bytes, length, place);
            if !found && place < length {
                (place + 1, found, true)
            } else {
                (place, found, false)
            }
        };
        found
    }
}
