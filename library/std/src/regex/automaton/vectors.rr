//! The stretches of a set of bytes, and the vectors that compare with them.
//!
//! A single byte is one vector of sixteen copies of it. A longer stretch is
//! two: its first byte, and its length less one. A set whose stretches cost
//! at most four vectors is compared sixteen bytes at a time; `encoding`
//! lists the forms.

import std::collections::pure::list::List;
import std::option::Option;
import std::regex::alphabet::bits::Bits;
import std::regex::automaton::ByteRange;

/// The four bytes that the vectors of a run repeat.
pub struct [value] Four {
    a: u8,
    b: u8,
    c: u8,
    d: u8
}

/// The four bytes in one word, the first in its lowest byte.
pub fn packed(bytes: Four) -> u32 {
    let low = (bytes.a as u32) | ((bytes.b as u32) << 8);
    let high = ((bytes.c as u32) << 16) | ((bytes.d as u32) << 24);
    low | high
}

/// The byte at `lane`, 0 to 63, of the four vectors of sixteen bytes that
/// repeat the bytes of `word`.
pub fn lane(word: u32, lane: u64) -> u8 {
    let byte = (lane / 16) as u32;
    ((word >> (byte * 8)) & 255) as u8
}

/// Four bytes for a run that compares with no vectors.
pub fn blank() -> Four {
    Four { a: 0, b: 0, c: 0, d: 0 }
}

/// The stretches of `set`, in order.
pub fn stretches(set: Bits) -> List<ByteRange> {
    if set.is_empty() { List::Nil } else {
        let start = set.least();
        // The first byte above `start` that is no member, or 256.
        let gap = set.complement().subtract(Bits::range(0, start)).least();
        let stretch = ByteRange { start: start as u8, end: (gap - 1) as u8 };
        List::Cons { stretch, stretches(set.subtract(Bits::range(start, gap - 1))) }
    }
}

/// The number of vectors that `stretches` are compared with: one for a
/// single byte, two for a longer stretch.
pub fn cost(stretches: List<ByteRange>) -> u64 {
    stretches.fold_left(0, |cost: u64, stretch: ByteRange| {
        if stretch.start == stretch.end {
            cost + 1
        } else {
            cost + 2
        }
    })
}

/// The stretches of `set` when they cost at most four.
pub fn few(set: Bits) -> Option<List<ByteRange>> {
    let found = stretches(set);
    if cost(found) <= 4 {
        Option::Some { found }
    } else {
        Option::None
    }
}

// The stretches of one byte (`wide` false) or of more.
fn chosen(stretches: List<ByteRange>, wide: bool) -> List<ByteRange> {
    match stretches {
        Nil => List::Nil,
        Cons(stretch, rest) => if (stretch.start != stretch.end) == wide {
            List::Cons { stretch, chosen(rest, wide) }
        } else {
            chosen(rest, wide)
        }
    }
}

// The stretch at `place`, or `otherwise` when the list is shorter.
fn stretch_at(stretches: List<ByteRange>, place: u64, otherwise: ByteRange) -> ByteRange {
    match stretches {
        Nil => otherwise,
        Cons(stretch, _) if place == 0 => stretch,
        Cons(_, rest) => stretch_at(rest, place - 1, otherwise)
    }
}

/// The form and the four bytes of the vectors that match the bytes of
/// `stretches`, which are not empty and cost at most four. A place past the
/// bytes of the form repeats the first byte.
pub fn vectors_of(stretches: List<ByteRange>) -> (u64, Four) {
    let wide = chosen(stretches, true);
    let single = chosen(stretches, false);
    match wide {
        Nil => {
            let first = stretch_at(single, 0, ByteRange { start: 0, end: 0 });
            (single.len() - 1, Four { a: first.start, b: stretch_at(single, 1, first).start, c: stretch_at(single, 2, first).start, d: stretch_at(single, 3, first).start })
        },
        Cons(first, more) => match more {
            Nil => {
                let same = ByteRange { start: first.start, end: first.start };
                (4 + single.len(), Four { a: first.start, b: first.end - first.start, c: stretch_at(single, 0, same).start, d: stretch_at(single, 1, same).start })
            },
            Cons(second, _) => (7, Four { a: first.start, b: first.end - first.start, c: second.start, d: second.end - second.start })
        }
    }
}
