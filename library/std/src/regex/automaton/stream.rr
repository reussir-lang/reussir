//! The matches of a text, pulled one after another.

import core::intrinsic::array;
import std::regex::automaton::Automaton;
import std::regex::automaton::Found;
import std::regex::automaton::Match;
import std::regex::automaton::Matches;
import std::regex::automaton::Reading;
import std::regex::automaton::encoding;
import std::regex::automaton::scan;
import std::text::TextView;

impl Matches {
    /// The longest match that begins where the stream stands, and the
    /// stream after it. After `Nothing` the stream stays where it is: no
    /// rule matches there, the match has no bytes, or the text has ended.
    pub fn next(self: Self) -> (Matches, Found) {
        // The place is read first, so that taking `reading` is the last use
        // of `self` and moves it.
        let at = self.at;
        let reading = self.reading;
        match reading.next_match(at) {
            Matched(found) => (Matches { reading, at: found.end }, Found::Matched { found }),
            Nothing => (Matches { reading, at }, Found::Nothing)
        }
    }

    /// The index of the byte where the next match would begin.
    pub fn at(self: Self) -> u64 {
        self.at
    }
}

impl Reading {
    // The longest match from the byte `at`, when it has bytes. The stream
    // keeps `self` across the call, so the automaton and its tables are
    // read here without counting references.
    fn next_match(self: Self, at: u64) -> Found {
        let (last, end) = scan::scan(self.automaton, self.bytes, self.input.len(), at);
        if last == 0 || end == at {
            Found::Nothing
        } else {
            let place = encoding::place(last, self.automaton.shift);
            let rule = array::get(self.automaton.winners, place as i64);
            Found::Matched { Match { rule, start: at, end } }
        }
    }
}

impl Automaton {
    /// The matches of the rules in `input`, one after another, from the byte
    /// `from` on.
    pub fn matches(self: Self, input: TextView, from: u64) -> Matches {
        Matches { reading: Reading { automaton: self, bytes: input.unsafe_data_ptr(), input }, at: from }
    }
}
