//! Terminal detection and ANSI SGR colors and attributes.
//! Detection delegates to Rust's `std::io::IsTerminal`; unknown terminals return false.
//! Escape sequences follow https://invisible-island.net/xterm/ctlseqs/ctlseqs.html.

pub enum [value] Stream { Stdin, Stdout, Stderr }

/// Tests the selected standard stream, independently of the other streams.
pub fn is_tty(stream: Stream) -> bool {
    is_tty_ffi(match stream { Stdin => 0, Stdout => 1, Stderr => 2 })
}

impl Stream {
    pub fn is_tty(self: Self) -> bool { is_tty(self) }
}

#[ffi(import)]
fn is_tty_ffi(stream: u8) -> bool [{
    use std::io::IsTerminal;
    match stream {
        0 => std::io::stdin().is_terminal(),
        1 => std::io::stdout().is_terminal(),
        _ => std::io::stderr().is_terminal(),
    }
}];

/// Auto emits ANSI only when the destination is a terminal.
/// Always and Never override detection; no environment variables are consulted.
pub enum [value] ColorChoice { Auto, Always, Never }

impl ColorChoice {
    pub fn enabled(self: Self, stream: Stream) -> bool {
        match self { Auto => is_tty(stream), Always => true, Never => false }
    }
}

/// The terminal's sixteen palette colors, or its default foreground/background.
pub enum [value] Color {
    Default,
    Black, Red, Green, Yellow, Blue, Magenta, Cyan, White,
    BrightBlack, BrightRed, BrightGreen, BrightYellow,
    BrightBlue, BrightMagenta, BrightCyan, BrightWhite
}

/// An SGR change. Format::Ansi scopes it to a document and restores its parent.
pub enum [value] Ansi {
    Foreground(Color), Background(Color),
    Bold, Dim, Italic, Underline, Reverse, Strikethrough, Reset
}

impl Ansi {
    /// The complete escape sequence; it occupies no display columns.
    pub fn escape(self: Self) -> str {
        match self {
            Foreground(color) => match color {
                Default => "\u{1b}[39m",
                Black => "\u{1b}[30m",
                Red => "\u{1b}[31m",
                Green => "\u{1b}[32m",
                Yellow => "\u{1b}[33m",
                Blue => "\u{1b}[34m",
                Magenta => "\u{1b}[35m",
                Cyan => "\u{1b}[36m",
                White => "\u{1b}[37m",
                BrightBlack => "\u{1b}[90m",
                BrightRed => "\u{1b}[91m",
                BrightGreen => "\u{1b}[92m",
                BrightYellow => "\u{1b}[93m",
                BrightBlue => "\u{1b}[94m",
                BrightMagenta => "\u{1b}[95m",
                BrightCyan => "\u{1b}[96m",
                BrightWhite => "\u{1b}[97m"
            },
            Background(color) => match color {
                Default => "\u{1b}[49m",
                Black => "\u{1b}[40m",
                Red => "\u{1b}[41m",
                Green => "\u{1b}[42m",
                Yellow => "\u{1b}[43m",
                Blue => "\u{1b}[44m",
                Magenta => "\u{1b}[45m",
                Cyan => "\u{1b}[46m",
                White => "\u{1b}[47m",
                BrightBlack => "\u{1b}[100m",
                BrightRed => "\u{1b}[101m",
                BrightGreen => "\u{1b}[102m",
                BrightYellow => "\u{1b}[103m",
                BrightBlue => "\u{1b}[104m",
                BrightMagenta => "\u{1b}[105m",
                BrightCyan => "\u{1b}[106m",
                BrightWhite => "\u{1b}[107m"
            },
            Bold => "\u{1b}[1m",
            Dim => "\u{1b}[2m",
            Italic => "\u{1b}[3m",
            Underline => "\u{1b}[4m",
            Reverse => "\u{1b}[7m",
            Strikethrough => "\u{1b}[9m",
            Reset => "\u{1b}[0m"
        }
    }
}
