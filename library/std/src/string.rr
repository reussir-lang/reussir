//! A growable UTF-8 string backed by the runtime's Rust `String`.
//!
//! `str` is the immutable static literal; this is the buildable
//! counterpart (*agentic-note*: design-str): one heap buffer behind an rc box,
//! crossing the polymorphic FFI the same way the `cow` collections do.
//! Appends on a uniquely owned string mutate in place; appends on a
//! shared string clone the buffer once (copy-on-write).
//!
//! The buffer is always valid UTF-8, so every `str` fed to it must be
//! too: literals and whole-literal slices are, but `str::slice` is
//! byte-granular and can cut a multi-byte character in half — pushing
//! such a slice is not allowed.

extern "rust" [{
    use reussir_rt::collections::string::String as RString;
}];

/// The raw runtime string. Operations consume the handle (the boundary
/// owns its arguments); [`String`] wraps it.
#[ffi(rust = "::reussir_rt::collections::string::String")]
pub struct RawString;

#[ffi(import)]
fn raw_new() -> RawString [{ RString::new() }];

#[ffi(import)]
fn raw_len(s : RawString) -> u64 [{ s.len() as u64 }];

#[ffi(import)]
fn raw_data_ptr(s : RawString) -> ConstPtr<core::ptr::Generic> [{
    s.as_str().as_ptr() as *const ::std::ffi::c_void
}];

#[ffi(import)]
fn raw_push_char(s : RawString, ch : char) -> RawString [{ s.push(ch) }];

#[ffi(import)]
fn raw_push_str(s : RawString, tail : str) -> RawString [{ s.push_str(tail) }];

#[ffi(import)]
fn raw_eq(lhs : RawString, rhs : RawString) -> bool [{
    lhs.as_str() == rhs.as_str()
}];

#[ffi(import)]
fn raw_eq_str(s : RawString, other : str) -> bool [{
    s.as_str().as_bytes() == other.as_bytes()
}];

#[ffi(import)]
fn raw_byte_at(s: RawString, index: u64) -> u8 [{ s.as_str().as_bytes()[index as usize] }];

#[ffi(import)]
fn raw_push_string(s: RawString, tail: RawString) -> RawString [{ s.append(tail) }];

#[ffi(import)]
fn raw_push_str_range(s: RawString, tail: str, start: u64, end: u64) -> RawString [{
    s.append_str_range(tail, start as usize, end as usize)
}];

#[ffi(import)]
fn raw_push_string_range(s: RawString, tail: RawString, start: u64, end: u64) -> RawString [{
    s.append_range(tail, start as usize, end as usize)
}];

/// A growable copy-on-write string.
pub struct String {
    raw : RawString
}

impl String {
    /// Creates an empty string. O(1).
    pub fn new() -> Self {
        String { raw: raw_new() }
    }

    /// Wraps a raw runtime string, such as one an `#[ffi(import)]` body
    /// built. O(1).
    pub fn from_raw(raw : RawString) -> Self {
        String { raw: raw }
    }

    /// Creates a string holding a copy of `value`. O(n).
    pub fn from_str(value : str) -> Self {
        String::new().push_str(value)
    }

    /// Transfers the owned runtime buffer without copying it.
    pub fn into_raw(self: Self) -> RawString { self.raw }

    /// Reads a UTF-8 byte. Panics when `index` is out of bounds.
    pub fn byte_at(self: Self, index: u64) -> u8 {
        if index >= self.len() { core::intrinsic::panic::panic() }
        else { raw_byte_at(self.raw, index) }
    }

    /// Appends owned text, copying the destination only when it is shared.
    pub fn push_string(self: Self, tail: Self) -> Self {
        String { raw: raw_push_string(self.raw, tail.raw) }
    }

    /// Appends a UTF-8 byte range. Bounds must lie on character boundaries.
    pub fn push_str_range(self: Self, tail: str, start: u64, end: u64) -> Self {
        if start > end || end > core::intrinsic::str::len(tail) { core::intrinsic::panic::panic() }
        else { String { raw: raw_push_str_range(self.raw, tail, start, end) } }
    }

    /// Appends a UTF-8 byte range from an owned string.
    pub fn push_string_range(self: Self, tail: Self, start: u64, end: u64) -> Self {
        if start > end || end > tail.len() { core::intrinsic::panic::panic() }
        else { String { raw: raw_push_string_range(self.raw, tail.raw, start, end) } }
    }

    /// Returns the length in bytes (a multi-byte character counts by its
    /// UTF-8 length). O(1).
    pub fn len(self : Self) -> u64 {
        raw_len(self.raw)
    }

    /// Returns whether the string has no bytes. O(1).
    pub fn is_empty(self : Self) -> bool {
        raw_len(self.raw) == 0
    }

    /// Returns the pointer to the first byte. The pointer does not keep the
    /// string alive, and an update of the string may move its bytes.
    pub fn unsafe_data_ptr(self : Self) -> ConstPtr<core::ptr::Generic> {
        raw_data_ptr(self.raw)
    }

    /// Appends one character. Amortized O(1); O(n) when a shared buffer
    /// is cloned first.
    pub fn push_char(self : Self, ch : char) -> Self {
        String { raw: raw_push_char(self.raw, ch) }
    }

    /// Appends a string literal, which must not split a character (see
    /// the module header). O(len of `tail`); O(n) when a shared buffer
    /// is cloned first.
    pub fn push_str(self : Self, tail : str) -> Self {
        String { raw: raw_push_str(self.raw, tail) }
    }

    /// Returns whether the contents equal the literal, byte-wise. O(n).
    pub fn eq_str(self : Self, other : str) -> bool {
        raw_eq_str(self.raw, other)
    }
}

impl PartialEq for String {
    fn eq(self : Self, other : Self) -> bool {
        raw_eq(self.raw, other.raw)
    }
}

impl Eq for String {}
