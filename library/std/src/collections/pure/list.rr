import core::intrinsic::array;
import std::option::Option;

pub enum List<T> {
    Cons(T, List<T>),
    Nil
}

impl<T> List<T> {
    fn len_impl(self: Self, acc : u64) -> u64 {
        match self {
            Nil => acc,
            Cons(_, tail) => tail.len_impl(acc + 1)
        }
    }
    pub fn len(self: Self) -> u64 {
        self.len_impl(0)
    }
    pub fn head(self: Self) -> Option<T> {
	match self {
            Nil => Option::None,
            Cons(h, _) => Option::Some { h }
        }
    }
    pub fn tail(self : Self) -> List<T> {
	match self {
	    Nil => List::Nil,
            Cons(_, t) => t
	}
    }
    pub fn is_nil(self : Self) -> bool {
        match self {
            Nil => true,
            Cons(_, _) => false
        }
    }
    pub fn is_cons(self : Self) -> bool {
        !self.is_nil()
    }
    fn reverse_impl(self : Self, acc : Self) -> Self {
        match self {
            Nil => acc,
            Cons(h, t) => t.reverse_impl(List::Cons { h, acc })
        }
    }
    pub fn reverse(self : Self) -> Self {
        self.reverse_impl(List::Nil)
    }
    pub fn map<U>(self : Self, f : T -> U) -> List<U> {
        match self {
            Nil => List::Nil,
            Cons(h, t) => List::Cons { f(h), t.map(f) }
        }
    }
    /// Combines the elements from head to tail while threading an accumulator.
    pub fn fold_left<U>(self : Self, initial : U, f : (U, T) -> U) -> U {
        match self {
            Nil => initial,
            Cons(h, t) => t.fold_left(f(initial, h), f)
        }
    }
    fn count_if_impl(
        self : Self,
        predicate : T -> bool,
        count : u64
    ) -> u64 {
        match self {
            Nil => count,
            Cons(h, t) => t.count_if_impl(
                predicate,
                if predicate(h) { count + 1 } else { count }
            )
        }
    }
    /// Counts the elements for which `predicate` returns true.
    pub fn count_if(self : Self, predicate : T -> bool) -> u64 {
        self.count_if_impl(predicate, 0)
    }
    /// Returns the first element for which `predicate` returns true.
    pub fn find_first(self : Self, predicate : T -> bool) -> Option<T> {
        match self {
            Nil => Option::None,
            Cons(h, _) if predicate(h) => Option::Some { h },
            Cons(_, t) => t.find_first(predicate)
        }
    }
    /// Retains matching elements in their original order.
    pub fn filter(self : Self, predicate : T -> bool) -> Self {
        match self {
            Nil => List::Nil,
            Cons(h, t) if predicate(h) => List::Cons { h, t.filter(predicate) },
            Cons(_, t) => t.filter(predicate)
        }
    }
    /// Returns true if at least one element satisfies `predicate`.
    pub fn any(self : Self, predicate : T -> bool) -> bool {
        match self {
            Nil => false,
            Cons(h, _) if predicate(h) => true,
            Cons(_, t) => t.any(predicate)
        }
    }
    /// Returns true if every element satisfies `predicate`.
    pub fn all(self : Self, predicate : T -> bool) -> bool {
        match self {
            Nil => true,
            Cons(h, t) if predicate(h) => t.all(predicate),
            Cons(_, _) => false
        }
    }
}

enum [value] Helper<X, Y> { Pair(X, Y) }

// Selection works on a flat copy of the list: `kth_min` and `kth_max` return
// one element, so there is no list to rebuild, and an array gives the
// partition constant-time access to both ends of a range. The array is
// threaded linearly through the helpers below, so every `set` is in place.

fn fill_array<T>(a : [T; ?], list : List<T>, i : i64) -> [T; ?] {
    match list {
        List::Nil => a,
        List::Cons(x, rest) => fill_array(array::set(a, i, x), rest, i + 1)
    }
}

fn swap<T>(a : [T; ?], i : i64, j : i64) -> [T; ?] {
    let x = array::get(a, i);
    let y = array::get(a, j);
    array::set(array::set(a, i, y), j, x)
}

// Sinks `a[j]` into the sorted range `a[lo..j]`.
fn sink<T : Ord>(a : [T; ?], lo : i64, j : i64) -> [T; ?] {
    if j > lo && array::get(a, j - 1) > array::get(a, j) {
        sink(swap(a, j - 1, j), lo, j - 1)
    } else {
        a
    }
}

// Insertion sort of `a[lo..=hi]`, given that `a[lo..j]` is sorted.
fn insertion_sort<T : Ord>(a : [T; ?], lo : i64, hi : i64, j : i64) -> [T; ?] {
    if j > hi {
        a
    } else {
        insertion_sort(sink(a, lo, j), lo, hi, j + 1)
    }
}

fn lesser<T : Ord>(x : T, y : T) -> T {
    if y < x { y } else { x }
}

fn greater<T : Ord>(x : T, y : T) -> T {
    if y < x { x } else { y }
}

fn median_of_three<T : Ord>(x : T, y : T, z : T) -> T {
    greater(lesser(x, y), lesser(greater(x, y), z))
}

// Moves the median of every full group of five in `a[i..=hi]` to `a[next]`,
// `a[next + 1]`, ... and returns the index past the last median.
fn gather_medians<T : Ord>(a : [T; ?], hi : i64, i : i64, next : i64) -> ([T; ?], i64) {
    if i + 4 > hi {
        (a, next)
    } else {
        let sorted = insertion_sort(a, i, i + 4, i + 1);
        gather_medians(swap(sorted, i + 2, next), hi, i + 5, next + 1)
    }
}

// The median of the medians of groups of five. At least three tenths of
// `a[lo..=hi]`, less a few elements, lie on each side of it.
fn median_of_medians<T : Ord>(a : [T; ?], lo : i64, hi : i64) -> ([T; ?], T) {
    let (gathered, end) = gather_medians(a, hi, lo, lo);
    select(gathered, lo, end - 1, lo + (end - lo) / 2, false)
}

// Three-way partition of `a[i..=gt]` around `pivot`, given that the part of
// the range before `lt` is below the pivot, `a[lt..i]` equals it, and the
// part after `gt` is above it. Returns the bounds of the elements equal to
// the pivot.
fn partition<T : Ord>(a : [T; ?], pivot : T, lt : i64, i : i64, gt : i64) -> ([T; ?], i64, i64) {
    if i > gt {
        (a, lt, gt)
    } else {
        let x = array::get(a, i);
        match x.cmp(pivot) {
            Ordering::Less => partition(
                array::set(array::set(a, i, array::get(a, lt)), lt, x),
                pivot, lt + 1, i + 1, gt
            ),
            Ordering::Equal => partition(a, pivot, lt, i + 1, gt),
            Ordering::Greater => partition(
                array::set(array::set(a, i, array::get(a, gt)), gt, x),
                pivot, lt, i, gt - 1
            )
        }
    }
}

// Returns the element that sorting `a[lo..=hi]` would place at index `k`,
// together with the permuted array. A median of three is the usual pivot.
// When a partition discards less than an eighth of its range, the next pivot
// is a median of medians (`careful`), which is guaranteed to discard about
// three tenths, so the worst case stays linear.
fn select<T : Ord>(a : [T; ?], lo : i64, hi : i64, k : i64, careful : bool) -> ([T; ?], T) {
    if hi - lo < 16 {
        let sorted = insertion_sort(a, lo, hi, lo + 1);
        let found = array::get(sorted, k);
        (sorted, found)
    } else {
        let (a, pivot) = if careful {
            median_of_medians(a, lo, hi)
        } else {
            let pivot = median_of_three(
                array::get(a, lo),
                array::get(a, lo + (hi - lo) / 2),
                array::get(a, hi)
            );
            (a, pivot)
        };
        let (a, lt, gt) = partition(a, pivot, lo, lo, hi);
        if k >= lt && k <= gt {
            (a, pivot)
        } else {
            let (lo2, hi2) = if k < lt { (lo, lt - 1) } else { (gt + 1, hi) };
            select(a, lo2, hi2, k, (hi2 - lo2) * 8 > (hi - lo) * 7)
        }
    }
}

impl<T : Ord> List<T> {
   fn min_impl(self : Self, candidate : Option<T>) -> Option<T> {
       match (Helper::Pair {self, candidate}) {
           Pair(Nil, _) => candidate,
           Pair(Cons(h, t), Some(x)) if x < h => t.min_impl(Option::Some { x }),
           Pair(Cons(h, t), _) => t.min_impl(Option::Some { h })
       }
   }
   pub fn min(self : Self) -> Option<T> {
       self.min_impl(Option::None)
   }
   fn max_impl(self : Self, candidate : Option<T>) -> Option<T> {
       match (Helper::Pair {self, candidate}) {
           Pair(Nil, _) => candidate,
           Pair(Cons(h, t), Some(x)) if x > h => t.max_impl(Option::Some { x }),
           Pair(Cons(h, t), _) => t.max_impl(Option::Some { h })
       }
   }
   /// Returns the greatest element, or `None` when the list is empty.
   pub fn max(self : Self) -> Option<T> {
       self.max_impl(Option::None)
   }
   // Merges two ascending lists onto `acc` in descending order. Each step
   // builds its cells before the tail call, so the cells the match just
   // freed are reused. Equal elements keep the reverse of their input order.
   fn rev_merge(self : Self, other : Self, acc : Self) -> Self {
       match self {
           Nil => other.reverse_impl(acc),
           Cons(x, xs) => match other {
               Nil => List::Cons { x, xs }.reverse_impl(acc),
               Cons(y, ys) => if x <= y {
                   xs.rev_merge(List::Cons { y, ys }, List::Cons { x, acc })
               } else {
                   List::Cons { x, xs }.rev_merge(ys, List::Cons { y, acc })
               }
           }
       }
   }
   // The mirror of `rev_merge`: merges two descending lists onto `acc` in
   // ascending order, restoring the input order of equal elements.
   fn rev_merge_desc(self : Self, other : Self, acc : Self) -> Self {
       match self {
           Nil => other.reverse_impl(acc),
           Cons(x, xs) => match other {
               Nil => List::Cons { x, xs }.reverse_impl(acc),
               Cons(y, ys) => if x > y {
                   xs.rev_merge_desc(List::Cons { y, ys }, List::Cons { x, acc })
               } else {
                   List::Cons { x, xs }.rev_merge_desc(ys, List::Cons { y, acc })
               }
           }
       }
   }
   // Sorts the first `n >= 1` elements in ascending order and returns them
   // with the unsorted remainder. The halves are sorted in descending order
   // so that the reversing merge yields the ascending result directly.
   fn sort_prefix(self : Self, n : u64) -> (Self, Self) {
       match self {
           Cons(x, rest) if n == 1 => (List::Cons { x, List::Nil }, rest),
           Cons(x, Cons(y, rest)) if n == 2 => if x <= y {
               (List::Cons { x, List::Cons { y, List::Nil } }, rest)
           } else {
               (List::Cons { y, List::Cons { x, List::Nil } }, rest)
           },
           whole => {
               let half = n / 2;
               let (front, back) = whole.sort_prefix_desc(half);
               let (middle, rest) = back.sort_prefix_desc(n - half);
               (front.rev_merge_desc(middle, List::Nil), rest)
           }
       }
   }
   // `sort_prefix` with the sorted prefix in descending order, equal
   // elements reversed.
   fn sort_prefix_desc(self : Self, n : u64) -> (Self, Self) {
       match self {
           Cons(x, rest) if n == 1 => (List::Cons { x, List::Nil }, rest),
           Cons(x, Cons(y, rest)) if n == 2 => if x > y {
               (List::Cons { x, List::Cons { y, List::Nil } }, rest)
           } else {
               (List::Cons { y, List::Cons { x, List::Nil } }, rest)
           },
           whole => {
               let half = n / 2;
               let (front, back) = whole.sort_prefix(half);
               let (middle, rest) = back.sort_prefix(n - half);
               (front.rev_merge(middle, List::Nil), rest)
           }
       }
   }
   // The element of rank `k` among the `n` elements of the list.
   fn select_rank(self : Self, n : u64, k : u64) -> Option<T> {
       match self {
           Cons(first, _) if k < n => {
               let a = fill_array(array::splat<[T; ?]>(n, first), self, 0);
               let (_, found) = select(a, 0, (n as i64) - 1, k as i64, false);
               Option::Some { found }
           },
           _ => Option::None
       }
   }
   /// Returns the element that would be at index `k` if the list were sorted
   /// in ascending order, so `kth_min(0)` is the minimum; `None` when `k` is
   /// out of range. O(n), using a temporary array of the elements.
   pub fn kth_min(self : Self, k : u64) -> Option<T> {
       self.select_rank(self.len(), k)
   }
   /// Returns the element that would be at index `k` if the list were sorted
   /// in descending order, so `kth_max(0)` is the maximum; `None` when `k` is
   /// out of range. O(n), using a temporary array of the elements.
   pub fn kth_max(self : Self, k : u64) -> Option<T> {
       let n = self.len();
       if k < n {
           self.select_rank(n, n - 1 - k)
       } else {
           Option::None
       }
   }
   /// Sorts the list in ascending order with a stable merge sort: equal
   /// elements keep their relative order.
   pub fn sort(self : Self) -> Self {
       let n = self.len();
       if n < 2 {
           self
       } else {
           let (sorted, _) = self.sort_prefix(n);
           sorted
       }
   }
}

impl<T : Eq> List<T> {
    /// Returns true if an element compares equal to `value`.
    pub fn contains(self : Self, value : T) -> bool {
        match self {
            Nil => false,
            Cons(h, _) if h == value => true,
            Cons(_, t) => t.contains(value)
        }
    }
}
