import std::option::Option;

pub enum List<T> {
    Cons(T, List<T>),
    Nil
}

impl<T> List<T> {
    fn len_impl(self: Self, acc : u64) -> u64 {
        match self {
            Nil => acc,
            Cons(_, tail) => tail.len_impl(acc + 1)
        }
    }
    pub fn len(self: Self) -> u64 {
        self.len_impl(0)
    }
    pub fn head(self: Self) -> Option<T> {
	match self {
            Nil => Option::None,
            Cons(h, _) => Option::Some { h }
        }
    }
    pub fn tail(self : Self) -> List<T> {
	match self {
	    Nil => List::Nil,
            Cons(_, t) => t
	}
    }
    pub fn is_nil(self : Self) -> bool {
        match self {
            Nil => true,
            Cons(_, _) => false
        }
    }
    pub fn is_cons(self : Self) -> bool {
        !self.is_nil()
    }
    fn reverse_impl(self : Self, acc : Self) -> Self {
        match self {
            Nil => acc,
            Cons(h, t) => t.reverse_impl(List::Cons { h, acc })
        }
    }
    pub fn reverse(self : Self) -> Self {
        self.reverse_impl(List::Nil)
    }
    pub fn map<U>(self : Self, f : T -> U) -> List<U> {
        match self {
            Nil => List::Nil,
            Cons(h, t) => List::Cons { f(h), t.map(f) }
        }
    }
    /// Combines the elements from head to tail while threading an accumulator.
    pub fn fold_left<U>(self : Self, initial : U, f : (U, T) -> U) -> U {
        match self {
            Nil => initial,
            Cons(h, t) => t.fold_left(f(initial, h), f)
        }
    }
    fn count_if_impl(
        self : Self,
        predicate : T -> bool,
        count : u64
    ) -> u64 {
        match self {
            Nil => count,
            Cons(h, t) => t.count_if_impl(
                predicate,
                if predicate(h) { count + 1 } else { count }
            )
        }
    }
    /// Counts the elements for which `predicate` returns true.
    pub fn count_if(self : Self, predicate : T -> bool) -> u64 {
        self.count_if_impl(predicate, 0)
    }
    /// Returns the first element for which `predicate` returns true.
    pub fn find_first(self : Self, predicate : T -> bool) -> Option<T> {
        match self {
            Nil => Option::None,
            Cons(h, _) if predicate(h) => Option::Some { h },
            Cons(_, t) => t.find_first(predicate)
        }
    }
    /// Retains matching elements in their original order.
    pub fn filter(self : Self, predicate : T -> bool) -> Self {
        match self {
            Nil => List::Nil,
            Cons(h, t) if predicate(h) => List::Cons { h, t.filter(predicate) },
            Cons(_, t) => t.filter(predicate)
        }
    }
    /// Returns true if at least one element satisfies `predicate`.
    pub fn any(self : Self, predicate : T -> bool) -> bool {
        match self {
            Nil => false,
            Cons(h, _) if predicate(h) => true,
            Cons(_, t) => t.any(predicate)
        }
    }
    /// Returns true if every element satisfies `predicate`.
    pub fn all(self : Self, predicate : T -> bool) -> bool {
        match self {
            Nil => true,
            Cons(h, t) if predicate(h) => t.all(predicate),
            Cons(_, _) => false
        }
    }
}

enum [value] Helper<X, Y> { Pair(X, Y) }

impl<T : Ord> List<T> {
   fn min_impl(self : Self, candidate : Option<T>) -> Option<T> {
       match (Helper::Pair {self, candidate}) {
           Pair(Nil, _) => candidate,
           Pair(Cons(h, t), Some(x)) if x < h => t.min_impl(Option::Some { x }),
           Pair(Cons(h, t), _) => t.min_impl(Option::Some { h })
       }
   }
   pub fn min(self : Self) -> Option<T> {
       self.min_impl(Option::None)
   }
   fn max_impl(self : Self, candidate : Option<T>) -> Option<T> {
       match (Helper::Pair {self, candidate}) {
           Pair(Nil, _) => candidate,
           Pair(Cons(h, t), Some(x)) if x > h => t.max_impl(Option::Some { x }),
           Pair(Cons(h, t), _) => t.max_impl(Option::Some { h })
       }
   }
   /// Returns the greatest element, or `None` when the list is empty.
   pub fn max(self : Self) -> Option<T> {
       self.max_impl(Option::None)
   }
   // Merges two ascending lists onto `acc` in descending order. Each step
   // builds its cells before the tail call, so the cells the match just
   // freed are reused. Equal elements keep the reverse of their input order.
   fn rev_merge(self : Self, other : Self, acc : Self) -> Self {
       match self {
           Nil => other.reverse_impl(acc),
           Cons(x, xs) => match other {
               Nil => List::Cons { x, xs }.reverse_impl(acc),
               Cons(y, ys) => if x <= y {
                   xs.rev_merge(List::Cons { y, ys }, List::Cons { x, acc })
               } else {
                   List::Cons { x, xs }.rev_merge(ys, List::Cons { y, acc })
               }
           }
       }
   }
   // The mirror of `rev_merge`: merges two descending lists onto `acc` in
   // ascending order, restoring the input order of equal elements.
   fn rev_merge_desc(self : Self, other : Self, acc : Self) -> Self {
       match self {
           Nil => other.reverse_impl(acc),
           Cons(x, xs) => match other {
               Nil => List::Cons { x, xs }.reverse_impl(acc),
               Cons(y, ys) => if x > y {
                   xs.rev_merge_desc(List::Cons { y, ys }, List::Cons { x, acc })
               } else {
                   List::Cons { x, xs }.rev_merge_desc(ys, List::Cons { y, acc })
               }
           }
       }
   }
   // Sorts the first `n >= 1` elements in ascending order and returns them
   // with the unsorted remainder. The halves are sorted in descending order
   // so that the reversing merge yields the ascending result directly.
   fn sort_prefix(self : Self, n : u64) -> (Self, Self) {
       match self {
           Cons(x, rest) if n == 1 => (List::Cons { x, List::Nil }, rest),
           Cons(x, Cons(y, rest)) if n == 2 => if x <= y {
               (List::Cons { x, List::Cons { y, List::Nil } }, rest)
           } else {
               (List::Cons { y, List::Cons { x, List::Nil } }, rest)
           },
           whole => {
               let half = n / 2;
               let (front, back) = whole.sort_prefix_desc(half);
               let (middle, rest) = back.sort_prefix_desc(n - half);
               (front.rev_merge_desc(middle, List::Nil), rest)
           }
       }
   }
   // `sort_prefix` with the sorted prefix in descending order, equal
   // elements reversed.
   fn sort_prefix_desc(self : Self, n : u64) -> (Self, Self) {
       match self {
           Cons(x, rest) if n == 1 => (List::Cons { x, List::Nil }, rest),
           Cons(x, Cons(y, rest)) if n == 2 => if x > y {
               (List::Cons { x, List::Cons { y, List::Nil } }, rest)
           } else {
               (List::Cons { y, List::Cons { x, List::Nil } }, rest)
           },
           whole => {
               let half = n / 2;
               let (front, back) = whole.sort_prefix(half);
               let (middle, rest) = back.sort_prefix(n - half);
               (front.rev_merge(middle, List::Nil), rest)
           }
       }
   }
   /// Sorts the list in ascending order with a stable merge sort: equal
   /// elements keep their relative order.
   pub fn sort(self : Self) -> Self {
       let n = self.len();
       if n < 2 {
           self
       } else {
           let (sorted, _) = self.sort_prefix(n);
           sorted
       }
   }
}

impl<T : Eq> List<T> {
    /// Returns true if an element compares equal to `value`.
    pub fn contains(self : Self, value : T) -> bool {
        match self {
            Nil => false,
            Cons(h, _) if h == value => true,
            Cons(_, t) => t.contains(value)
        }
    }
}
