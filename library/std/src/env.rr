//! Process arguments and environment variables.

import std::collections::cow::vec::RawVec;
import std::collections::cow::vec::Vec;
import std::collections::pure::list::List;
import std::format::Display;
import std::format::Format;
import std::result::Result;
import std::string::RawString;
import std::string::String;
import std::text::Text;

extern "rust" [{
    use reussir_rt::collections::string::String as RString;
}];

/// Reason an environment variable lookup failed.
pub enum [value] VarError {
    NotPresent,
    NotUnicode
}

impl PartialEq for VarError {
    fn eq(self: Self, other: Self) -> bool {
        match self {
            NotPresent => match other { NotPresent => true, NotUnicode => false },
            NotUnicode => match other { NotPresent => false, NotUnicode => true }
        }
    }
}

impl Eq for VarError {}

impl Display for VarError {
    fn fmt(self: Self) -> Format {
        Format::Text {
            Text::Literal {
                match self {
                    NotPresent => "NotPresent",
                    NotUnicode => "NotUnicode"
                }
            }
        }
    }
}

#[ffi(import)]
fn raw_args() -> RawVec<RawString> [{
    std::env::args().map(RString::from).collect()
}];

#[ffi(import)]
fn raw_var_status_str(key: str) -> u8 [{
    match std::str::from_utf8(key.as_bytes()) {
        Ok(key) => match std::env::var(key) {
            Ok(_) => 0,
            Err(std::env::VarError::NotPresent) => 1,
            Err(std::env::VarError::NotUnicode(_)) => 2,
        },
        Err(_) => 1,
    }
}];

#[ffi(import)]
fn raw_var_str(key: str) -> RawString [{
    match std::str::from_utf8(key.as_bytes()) {
        Ok(key) => RString::from(std::env::var(key).unwrap_or_default()),
        Err(_) => RString::new(),
    }
}];

#[ffi(import)]
fn raw_var_status_string(key: RawString) -> u8 [{
    match std::env::var(key.as_str()) {
        Ok(_) => 0,
        Err(std::env::VarError::NotPresent) => 1,
        Err(std::env::VarError::NotUnicode(_)) => 2,
    }
}];

#[ffi(import)]
fn raw_var_string(key: RawString) -> RawString [{
    RString::from(std::env::var(key.as_str()).unwrap_or_default())
}];

/// The command-line arguments of the current process.
/// Panics if any argument is not valid UTF-8.
pub fn args() -> List<String> {
    let raw = Vec::from_raw(raw_args());
    let (_, out) = while [i = raw.len(), out = List::Nil] (i > 0) {
        let next = i - 1;
        (next, List::Cons { String::from_raw(raw.get(next).unwrap_or_panic()), out })
    };
    out
}

/// Fetches the environment variable `key` from the current process.
pub fn var(key: Text) -> Result<String, VarError> {
    match key {
        Literal(s) => match raw_var_status_str(s) {
            0 => Result::Ok { String::from_raw(raw_var_str(s)) },
            1 => Result::Err { VarError::NotPresent },
            _ => Result::Err { VarError::NotUnicode }
        },
        Owned(s) => {
            let raw = s.into_raw();
            match raw_var_status_string(raw) {
                0 => Result::Ok { String::from_raw(raw_var_string(raw)) },
                1 => Result::Err { VarError::NotPresent },
                _ => Result::Err { VarError::NotUnicode }
            }
        }
    }
}
