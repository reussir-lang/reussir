//! Input specifications for test cases and filtered test suites.
//!
//! Each test case in a [`TestTree`](test::tree::TestTree) carries a
//! [`ValueSpec`] describing the wire layout and domain constraints of its
//! input inside a `Vec<u8>` buffer. Filtering a tree produces a
//! [`SuiteSpec`] listing the active cases in declaration order together
//! with their [`ValueSpec`]s.
//!
//! A [`ValueSpec`] or [`SuiteSpec`] serves two roles:
//! 1. **Generation / mutation**: a random generator (or external mutator)
//!    consumes the spec and produces a `Vec<u8>` conforming to the schema,
//!    which the runner then feeds back into the test case.
//! 2. **Serialization**: [`ValueSpec::to_bytes`] / [`ValueSpec::from_bytes`]
//!    and [`SuiteSpec::to_bytes`] / [`SuiteSpec::from_bytes`] implement a
//!    complete binary round trip so an external fuzzing harness can load
//!    the exact specification derived at startup.
//!
//! # Wire Format (CBNF)
//!
//! All multi-byte integers and IEEE-754 floats are encoded in little-endian
//! byte order.
//!
//! ```text
//! <u8>           ::= BYTE
//! <bool-flag>    ::= 0x00 | 0x01
//! <u16-le>       ::= <u8>{2}
//! <u32-le>       ::= <u8>{4}
//! <u64-le>       ::= <u8>{8}
//! <i64-le>       ::= <u8>{8}                       ; two's-complement signed i64
//! <f32-le>       ::= <u8>{4}                       ; IEEE-754 binary32 bits
//! <f64-le>       ::= <u8>{8}                       ; IEEE-754 binary64 bits
//! <utf8-string>  ::= <byte-len: u64-le> <utf8-byte: u8>{byte-len}
//!
//! <int-width>    ::= 0x00                          ; IntWidth::I8
//!                  | 0x01                          ; IntWidth::I16
//!                  | 0x02                          ; IntWidth::I32
//!                  | 0x03                          ; IntWidth::I64
//!
//! <float-width>  ::= 0x00                          ; FloatWidth::F32
//!                  | 0x01                          ; FloatWidth::F64
//!
//! <charset>      ::= 0x00                          ; Charset::Ascii
//!                  | 0x01                          ; Charset::AsciiPrintable
//!                  | 0x02                          ; Charset::Alphanumeric
//!                  | 0x03                          ; Charset::Alpha
//!                  | 0x04                          ; Charset::Digits
//!                  | 0x05                          ; Charset::Identifier
//!                  | 0x06                          ; Charset::Utf8
//!
//! ; --- Specification serialization (ValueSpec::to_bytes / SuiteSpec::to_bytes) ---
//!
//! <value-spec-blob> ::= "RVSP" 0x01 <value-spec>
//! <suite-spec-blob> ::= "RTSP" 0x01 <case-count: u64-le> <case-spec>{case-count}
//! <case-spec>       ::= <seg-count: u64-le> <utf8-string>{seg-count} <value-spec>
//!
//! <value-spec>      ::= 0x00                                                                      ; Unit
//!                     | 0x01                                                                      ; Bool
//!                     | 0x02 <width: int-width> <min: i64-le> <max: i64-le>                       ; Int
//!                     | 0x03 <width: int-width> <min: u64-le> <max: u64-le>                       ; UInt
//!                     | 0x04 <width: float-width> <min: f64-le> <max: f64-le>
//!                            <allow-nan: bool-flag> <allow-inf: bool-flag>                        ; Float
//!                     | 0x05 <charset: charset>                                                   ; Char
//!                     | 0x06 <charset: charset> <min-len: u64-le> <max-len: u64-le>               ; String
//!                     | 0x07 <min-len: u64-le> <max-len: u64-le> <elem: value-spec>               ; Array
//!                     | 0x08 <arity: u64-le> <item: value-spec>{arity}                            ; Tuple
//!
//! ; --- Test input payload (Vec<u8> consumed by Domain::decode / runner) ---
//!
//! <suite-input>     ::= <case-idx: u64-le> <value-payload>
//! <value-payload>   ::= ""                                                                        ; Unit
//!                     | <u8>                                                                      ; Bool / Int(I8) / UInt(I8)
//!                     | <u16-le>                                                                  ; Int(I16) / UInt(I16)
//!                     | <u32-le>                                                                  ; Int(I32) / UInt(I32) / Char
//!                     | <f32-le>                                                                  ; Float(F32)
//!                     | <u64-le>                                                                  ; Int(I64) / UInt(I64)
//!                     | <f64-le>                                                                  ; Float(F64)
//!                     | <utf8-string>                                                             ; String
//!                     | <elem-count: u64-le> <value-payload>{elem-count}                          ; Array
//!                     | <value-payload>{arity}                                                    ; Tuple
//! ```

import std::collections::cow::vec::Vec;
import std::collections::pure::list::List;
import std::format::Display;
import std::format::Format;
import std::format::brackets;
import std::format::call;
import std::format::comma_list;
import std::format::join;
import std::format::parens;
import std::option::Option;
import std::random::RandomState;
import std::random::Rng;
import std::string::RawString;
import std::string::String;
import std::text::Text;

extern "rust" [{
    use reussir_rt::collections::string::String as RString;
}];

#[ffi(import)]
fn raw_f64_to_bits(value: f64) -> u64 [{ value.to_bits() }];

#[ffi(import)]
fn raw_f64_from_bits(bits: u64) -> f64 [{ f64::from_bits(bits) }];

#[ffi(import)]
fn raw_f32_to_bits(value: f32) -> u32 [{ value.to_bits() }];

#[ffi(import)]
fn raw_f32_from_bits(bits: u32) -> f32 [{ f32::from_bits(bits) }];

#[ffi(import)]
fn raw_format_f64(value: f64) -> RawString [{ RString::from(format!("{value:?}")) }];

#[ffi(import)]
fn raw_format_f32(value: f32) -> RawString [{ RString::from(format!("{value:?}")) }];

#[ffi(import)]
fn raw_scalar_to_char(value: u32) -> char [{ char::from_u32(value).unwrap_or('\u{fffd}') }];

#[ffi(import)]
fn raw_is_valid_scalar(value: u32) -> bool [{ char::from_u32(value).is_some() }];

/// Converts an `f64` to its raw IEEE-754 bits.
pub fn f64_to_bits(value: f64) -> u64 { raw_f64_to_bits(value) }

/// Reconstructs an `f64` from its raw IEEE-754 bits.
pub fn f64_from_bits(bits: u64) -> f64 { raw_f64_from_bits(bits) }

/// Converts an `f32` to its raw IEEE-754 bits.
pub fn f32_to_bits(value: f32) -> u32 { raw_f32_to_bits(value) }

/// Reconstructs an `f32` from its raw IEEE-754 bits.
pub fn f32_from_bits(bits: u32) -> f32 { raw_f32_from_bits(bits) }

/// Formats an `f64` for diagnostic output.
pub fn format_f64(value: f64) -> Format {
    Format::Text { Text::Owned { String::from_raw(raw_format_f64(value)) } }
}

/// Formats an `f32` for diagnostic output.
pub fn format_f32(value: f32) -> Format {
    Format::Text { Text::Owned { String::from_raw(raw_format_f32(value)) } }
}

/// Bit width of a fixed-size integer domain.
pub enum [value] IntWidth {
    I8,
    I16,
    I32,
    I64
}

impl IntWidth {
    fn to_tag(self: Self) -> u8 {
        match self {
            I8 => 0,
            I16 => 1,
            I32 => 2,
            I64 => 3
        }
    }

    fn from_tag(tag: u8) -> Option<Self> {
        match tag {
            0 => Option::Some { IntWidth::I8 },
            1 => Option::Some { IntWidth::I16 },
            2 => Option::Some { IntWidth::I32 },
            3 => Option::Some { IntWidth::I64 },
            _ => Option::None
        }
    }

    /// Minimum signed value representable at this width.
    pub fn signed_min(self: Self) -> i64 {
        match self {
            I8 => -128,
            I16 => -32768,
            I32 => -2147483648,
            I64 => (-9223372036854775807) - 1
        }
    }

    /// Maximum signed value representable at this width.
    pub fn signed_max(self: Self) -> i64 {
        match self {
            I8 => 127,
            I16 => 32767,
            I32 => 2147483647,
            I64 => 9223372036854775807
        }
    }

    /// Maximum unsigned value representable at this width.
    pub fn unsigned_max(self: Self) -> u64 {
        match self {
            I8 => 255,
            I16 => 65535,
            I32 => 4294967295,
            I64 => 0xffffffffffffffff
        }
    }
}

impl PartialEq for IntWidth {
    fn eq(self: Self, other: Self) -> bool {
        self.to_tag() == other.to_tag()
    }
}

impl Eq for IntWidth {}

impl Display for IntWidth {
    fn fmt(self: Self) -> Format {
        lit(match self {
            I8 => "8",
            I16 => "16",
            I32 => "32",
            I64 => "64"
        })
    }
}

/// Bit width of an IEEE-754 floating-point domain.
pub enum [value] FloatWidth {
    F32,
    F64
}

impl FloatWidth {
    fn to_tag(self: Self) -> u8 {
        match self {
            F32 => 0,
            F64 => 1
        }
    }

    fn from_tag(tag: u8) -> Option<Self> {
        match tag {
            0 => Option::Some { FloatWidth::F32 },
            1 => Option::Some { FloatWidth::F64 },
            _ => Option::None
        }
    }
}

impl PartialEq for FloatWidth {
    fn eq(self: Self, other: Self) -> bool {
        self.to_tag() == other.to_tag()
    }
}

impl Eq for FloatWidth {}

impl Display for FloatWidth {
    fn fmt(self: Self) -> Format {
        lit(match self {
            F32 => "f32",
            F64 => "f64"
        })
    }
}

/// Character class constraint for character and string domains.
pub enum [value] Charset {
    /// Any ASCII byte (`0x00..=0x7F`).
    Ascii,
    /// Printable ASCII characters (`0x20..=0x7E`, space through `~`).
    AsciiPrintable,
    /// ASCII letters and digits (`A-Z`, `a-z`, `0-9`).
    Alphanumeric,
    /// ASCII letters (`A-Z`, `a-z`).
    Alpha,
    /// ASCII decimal digits (`0-9`).
    Digits,
    /// ASCII identifier characters (`A-Z`, `a-z`, `0-9`, `_`).
    Identifier,
    /// Arbitrary valid Unicode scalar values.
    Utf8
}

impl Charset {
    fn to_tag(self: Self) -> u8 {
        match self {
            Ascii => 0,
            AsciiPrintable => 1,
            Alphanumeric => 2,
            Alpha => 3,
            Digits => 4,
            Identifier => 5,
            Utf8 => 6
        }
    }

    fn from_tag(tag: u8) -> Option<Self> {
        match tag {
            0 => Option::Some { Charset::Ascii },
            1 => Option::Some { Charset::AsciiPrintable },
            2 => Option::Some { Charset::Alphanumeric },
            3 => Option::Some { Charset::Alpha },
            4 => Option::Some { Charset::Digits },
            5 => Option::Some { Charset::Identifier },
            6 => Option::Some { Charset::Utf8 },
            _ => Option::None
        }
    }

    /// Whether `ch` belongs to this character set.
    pub fn contains(self: Self, ch: char) -> bool {
        let code = ch as u32;
        match self {
            Ascii => code <= 127,
            AsciiPrintable => code >= 32 && code <= 126,
            Alphanumeric => is_digit(code) || is_alpha(code),
            Alpha => is_alpha(code),
            Digits => is_digit(code),
            Identifier => is_digit(code) || is_alpha(code) || code == 95,
            Utf8 => true
        }
    }

    /// Maps an arbitrary `u64` word into a character of this set.
    pub fn map_word(self: Self, word: u64) -> char {
        match self {
            Ascii => raw_scalar_to_char((word % 128) as u32),
            AsciiPrintable => raw_scalar_to_char((32 + (word % 95)) as u32),
            Digits => raw_scalar_to_char((48 + (word % 10)) as u32),
            Alpha => {
                let idx = (word % 52) as u32;
                if idx < 26 {
                    raw_scalar_to_char(65 + idx)
                } else {
                    raw_scalar_to_char(97 + (idx - 26))
                }
            },
            Alphanumeric => {
                let idx = (word % 62) as u32;
                if idx < 10 {
                    raw_scalar_to_char(48 + idx)
                } else { if idx < 36 {
                    raw_scalar_to_char(65 + (idx - 10))
                } else {
                    raw_scalar_to_char(97 + (idx - 36))
                } }
            },
            Identifier => {
                let idx = (word % 63) as u32;
                if idx < 10 {
                    raw_scalar_to_char(48 + idx)
                } else { if idx < 36 {
                    raw_scalar_to_char(65 + (idx - 10))
                } else { if idx < 62 {
                    raw_scalar_to_char(97 + (idx - 36))
                } else {
                    '_'
                } } }
            },
            Utf8 => {
                // 0..=0x10ffff excluding surrogates 0xd800..=0xdfff (2048 values)
                // Total valid scalars = 1_112_064.
                let mode = word & 3;
                if mode < 2 {
                    raw_scalar_to_char((32 + ((word >> 2) % 95)) as u32)
                } else {
                    let raw = ((word >> 2) % 1112064) as u32;
                    let code = if raw >= 55296 { raw + 2048 } else { raw };
                    raw_scalar_to_char(code)
                }
            }
        }
    }
}

fn is_digit(code: u32) -> bool { code >= 48 && code <= 57 }
fn is_alpha(code: u32) -> bool { (code >= 65 && code <= 90) || (code >= 97 && code <= 122) }

impl PartialEq for Charset {
    fn eq(self: Self, other: Self) -> bool {
        self.to_tag() == other.to_tag()
    }
}

impl Eq for Charset {}

impl Display for Charset {
    fn fmt(self: Self) -> Format {
        lit(match self {
            Ascii => "ascii",
            AsciiPrintable => "printable",
            Alphanumeric => "alphanumeric",
            Alpha => "alpha",
            Digits => "digits",
            Identifier => "identifier",
            Utf8 => "utf8"
        })
    }
}

/// Schema and constraints for one test input or sub-value.
pub enum ValueSpec {
    /// Zero-argument unit input (0 bytes).
    Unit,
    /// Boolean input (1 byte: `0` = false, non-zero = true).
    Bool,
    /// Signed integer of `width` in the inclusive range `[min, max]`.
    Int(IntWidth, i64, i64),
    /// Unsigned integer of `width` in the inclusive range `[min, max]`.
    UInt(IntWidth, u64, u64),
    /// IEEE-754 float of `width` in `[min, max]`, with `(allow_nan, allow_inf)`.
    Float(FloatWidth, f64, f64, bool, bool),
    /// Single character from `charset` (4-byte little-endian `u32` scalar).
    Char(Charset),
    /// UTF-8 string with character count in `[min_len, max_len]` from `charset`.
    String(Charset, u64, u64),
    /// Homogeneous sequence of `elem` with length in `[min_len, max_len]`.
    Array(ValueSpec, u64, u64),
    /// Fixed-arity product of values encoded sequentially.
    Tuple(List<ValueSpec>)
}

impl ValueSpec {
    /// Whether this specification is `ValueSpec::Unit`.
    pub fn is_unit(self: Self) -> bool {
        match self {
            Unit => true,
            _ => false
        }
    }

    /// Generates a random byte buffer conforming to this specification.
    pub fn generate<R: RandomState>(self: Self, rng: Rng<R>) -> Vec<u8> {
        self.write_random(rng, empty_bytes())
    }

    /// Appends a random value conforming to `self` onto `out`.
    pub fn write_random<R: RandomState>(self: Self, rng: Rng<R>, out: Vec<u8>) -> Vec<u8> {
        match self {
            Unit => out,
            Bool => write_u8(out, (rng.next() & 1) as u8),
            Int(width, min, max) => {
                let value = sample_i64(rng, min, max);
                write_int_le(out, width, value)
            },
            UInt(width, min, max) => {
                let value = sample_u64(rng, min, max);
                write_uint_le(out, width, value)
            },
            Float(width, min, max, allow_nan, allow_inf) => {
                let value = sample_f64(rng, min, max, allow_nan, allow_inf);
                match width {
                    F32 => write_u32_le(out, f32_to_bits(value as f32)),
                    F64 => write_u64_le(out, f64_to_bits(value))
                }
            },
            Char(charset) => {
                let ch = charset.map_word(rng.next());
                write_u32_le(out, ch as u32)
            },
            ValueSpec::String(charset, min_len, max_len) => {
                let char_count = sample_u64(rng, min_len, max_len);
                let (_, generated) = while [i = (0 as u64), s = String::new()] (i < char_count) {
                    (i + 1, s.push_char(charset.map_word(rng.next())))
                };
                write_string_bytes(out, Text::Owned { generated })
            },
            Array(elem, min_len, max_len) => {
                let count = sample_u64(rng, min_len, max_len);
                let out = write_u64_le(out, count);
                let (_, out) = while [i = (0 as u64), buf = out] (i < count) {
                    (i + 1, elem.write_random(rng, buf))
                };
                out
            },
            Tuple(items) => {
                items.fold_left(out, |buf: Vec<u8>, item: ValueSpec| item.write_random(rng, buf))
            }
        }
    }

    /// Serializes `self` into a self-contained binary representation.
    pub fn to_bytes(self: Self) -> Vec<u8> {
        let header = write_u8(write_magic(Vec::new(), 0x52, 0x56, 0x53, 0x50), 1);
        self.encode_spec(header)
    }

    /// Reconstructs a [`ValueSpec`] from bytes produced by [`ValueSpec::to_bytes`].
    pub fn from_bytes(bytes: Vec<u8>) -> Option<Self> {
        read_magic(ByteCursor::new(bytes), 0x52, 0x56, 0x53, 0x50)
            .and_then(|cursor: ByteCursor| cursor.read_u8())
            .and_then(|ver_and_cursor: (u8, ByteCursor)| {
                let (version, cursor) = ver_and_cursor;
                if version != 1 { Option::None } else { decode_value_spec(cursor) }
            })
            .and_then(|res: (ValueSpec, ByteCursor)| {
                let (spec, rest) = res;
                if rest.is_eof() { Option::Some { spec } } else { Option::None }
            })
    }

    fn encode_spec(self: Self, out: Vec<u8>) -> Vec<u8> {
        match self {
            Unit => write_u8(out, 0),
            Bool => write_u8(out, 1),
            Int(width, min, max) => {
                let out = write_u8(write_u8(out, 2), width.to_tag());
                write_u64_le(write_u64_le(out, min as u64), max as u64)
            },
            UInt(width, min, max) => {
                let out = write_u8(write_u8(out, 3), width.to_tag());
                write_u64_le(write_u64_le(out, min), max)
            },
            Float(width, min, max, allow_nan, allow_inf) => {
                let out = write_u8(write_u8(out, 4), width.to_tag());
                let out = write_u64_le(write_u64_le(out, f64_to_bits(min)), f64_to_bits(max));
                let out = write_u8(out, if allow_nan { 1 } else { 0 });
                write_u8(out, if allow_inf { 1 } else { 0 })
            },
            Char(charset) => write_u8(write_u8(out, 5), charset.to_tag()),
            ValueSpec::String(charset, min_len, max_len) => {
                let out = write_u8(write_u8(out, 6), charset.to_tag());
                write_u64_le(write_u64_le(out, min_len), max_len)
            },
            Array(elem, min_len, max_len) => {
                let out = write_u64_le(write_u64_le(write_u8(out, 7), min_len), max_len);
                elem.encode_spec(out)
            },
            Tuple(items) => {
                let out = write_u64_le(write_u8(out, 8), items.len());
                items.fold_left(out, |buf: Vec<u8>, item: ValueSpec| item.encode_spec(buf))
            }
        }
    }
}

fn decode_value_spec(cursor: ByteCursor) -> Option<(ValueSpec, ByteCursor)> {
    cursor.read_u8().and_then(|tag_and_cursor: (u8, ByteCursor)| {
        let (tag, cursor) = tag_and_cursor;
        match tag {
            0 => Option::Some { (ValueSpec::Unit, cursor) },
            1 => Option::Some { (ValueSpec::Bool, cursor) },
            2 => cursor.read_u8()
                .and_then(|w_and_c: (u8, ByteCursor)| {
                    let (w_tag, c1) = w_and_c;
                    IntWidth::from_tag(w_tag).map(|width: IntWidth| (width, c1))
                })
                .and_then(|w_and_c: (IntWidth, ByteCursor)| {
                    let (width, c1) = w_and_c;
                    c1.read_u64_le().and_then(|min_and_c: (u64, ByteCursor)| {
                        let (min_u, c2) = min_and_c;
                        c2.read_u64_le().map(|max_and_c: (u64, ByteCursor)| {
                            let (max_u, c3) = max_and_c;
                            (ValueSpec::Int { width, min_u as i64, max_u as i64 }, c3)
                        })
                    })
                }),
            3 => cursor.read_u8()
                .and_then(|w_and_c: (u8, ByteCursor)| {
                    let (w_tag, c1) = w_and_c;
                    IntWidth::from_tag(w_tag).map(|width: IntWidth| (width, c1))
                })
                .and_then(|w_and_c: (IntWidth, ByteCursor)| {
                    let (width, c1) = w_and_c;
                    c1.read_u64_le().and_then(|min_and_c: (u64, ByteCursor)| {
                        let (min_u, c2) = min_and_c;
                        c2.read_u64_le().map(|max_and_c: (u64, ByteCursor)| {
                            let (max_u, c3) = max_and_c;
                            (ValueSpec::UInt { width, min_u, max_u }, c3)
                        })
                    })
                }),
            4 => cursor.read_u8()
                .and_then(|w_and_c: (u8, ByteCursor)| {
                    let (w_tag, c1) = w_and_c;
                    FloatWidth::from_tag(w_tag).map(|width: FloatWidth| (width, c1))
                })
                .and_then(|w_and_c: (FloatWidth, ByteCursor)| {
                    let (width, c1) = w_and_c;
                    c1.read_u64_le().and_then(|min_and_c: (u64, ByteCursor)| {
                        let (min_bits, c2) = min_and_c;
                        c2.read_u64_le().and_then(|max_and_c: (u64, ByteCursor)| {
                            let (max_bits, c3) = max_and_c;
                            c3.read_u8().and_then(|nan_and_c: (u8, ByteCursor)| {
                                let (nan_flag, c4) = nan_and_c;
                                c4.read_u8().and_then(|inf_and_c: (u8, ByteCursor)| {
                                    let (inf_flag, c5) = inf_and_c;
                                    if nan_flag > 1 || inf_flag > 1 {
                                        Option::None
                                    } else {
                                        Option::Some { (
                                            ValueSpec::Float {
                                                width,
                                                f64_from_bits(min_bits),
                                                f64_from_bits(max_bits),
                                                nan_flag == 1,
                                                inf_flag == 1
                                            },
                                            c5
                                        ) }
                                    }
                                })
                            })
                        })
                    })
                }),
            5 => cursor.read_u8().and_then(|cs_and_c: (u8, ByteCursor)| {
                let (cs_tag, c1) = cs_and_c;
                Charset::from_tag(cs_tag).map(|cs: Charset| (ValueSpec::Char { cs }, c1))
            }),
            6 => cursor.read_u8()
                .and_then(|cs_and_c: (u8, ByteCursor)| {
                    let (cs_tag, c1) = cs_and_c;
                    Charset::from_tag(cs_tag).map(|cs: Charset| (cs, c1))
                })
                .and_then(|cs_and_c: (Charset, ByteCursor)| {
                    let (cs, c1) = cs_and_c;
                    c1.read_u64_le().and_then(|min_and_c: (u64, ByteCursor)| {
                        let (min_len, c2) = min_and_c;
                        c2.read_u64_le().map(|max_and_c: (u64, ByteCursor)| {
                            let (max_len, c3) = max_and_c;
                            (ValueSpec::String { cs, min_len, max_len }, c3)
                        })
                    })
                }),
            7 => cursor.read_u64_le().and_then(|min_and_c: (u64, ByteCursor)| {
                let (min_len, c1) = min_and_c;
                c1.read_u64_le().and_then(|max_and_c: (u64, ByteCursor)| {
                    let (max_len, c2) = max_and_c;
                    decode_value_spec(c2).map(|elem_and_c: (ValueSpec, ByteCursor)| {
                        let (elem, c3) = elem_and_c;
                        (ValueSpec::Array { elem, min_len, max_len }, c3)
                    })
                })
            }),
            8 => cursor.read_u64_le().and_then(|arity_and_c: (u64, ByteCursor)| {
                let (arity, c1) = arity_and_c;
                decode_value_spec_list(c1, arity, List::Nil).map(
                    |items_and_c: (List<ValueSpec>, ByteCursor)| {
                        let (items, c2) = items_and_c;
                        (ValueSpec::Tuple { items }, c2)
                    }
                )
            }),
            _ => Option::None
        }
    })
}

fn decode_value_spec_list(
    cursor: ByteCursor,
    remaining: u64,
    acc: List<ValueSpec>
) -> Option<(List<ValueSpec>, ByteCursor)> {
    if remaining == 0 {
        Option::Some { (acc.reverse(), cursor) }
    } else {
        decode_value_spec(cursor).and_then(|item_and_c: (ValueSpec, ByteCursor)| {
            let (item, next_cursor) = item_and_c;
            decode_value_spec_list(next_cursor, remaining - 1, List::Cons { item, acc })
        })
    }
}

impl PartialEq for ValueSpec {
    fn eq(self: Self, other: Self) -> bool {
        match (self, other) {
            (Unit, Unit) => true,
            (Bool, Bool) => true,
            (Int(w1, min1, max1), Int(w2, min2, max2)) =>
                w1 == w2 && min1 == min2 && max1 == max2,
            (UInt(w1, min1, max1), UInt(w2, min2, max2)) =>
                w1 == w2 && min1 == min2 && max1 == max2,
            (Float(w1, min1, max1, nan1, inf1), Float(w2, min2, max2, nan2, inf2)) =>
                w1 == w2
                    && f64_to_bits(min1) == f64_to_bits(min2)
                    && f64_to_bits(max1) == f64_to_bits(max2)
                    && nan1 == nan2
                    && inf1 == inf2,
            (Char(cs1), Char(cs2)) => cs1 == cs2,
            (ValueSpec::String(cs1, min1, max1), ValueSpec::String(cs2, min2, max2)) =>
                cs1 == cs2 && min1 == min2 && max1 == max2,
            (Array(elem1, min1, max1), Array(elem2, min2, max2)) if min1 == min2 && max1 == max2 =>
                elem1 == elem2,
            (Tuple(items1), Tuple(items2)) => list_eq(items1, items2),
            _ => false
        }
    }
}

fn list_eq<T: PartialEq>(a: List<T>, b: List<T>) -> bool {
    match (a, b) {
        (Nil, Nil) => true,
        (Cons(x, xs), Cons(y, ys)) if x == y => list_eq(xs, ys),
        _ => false
    }
}

impl Eq for ValueSpec {}

impl Display for ValueSpec {
    fn fmt(self: Self) -> Format {
        match self {
            Unit => lit("unit"),
            Bool => lit("bool"),
            Int(width, min, max) => lit("i").append(width.fmt())
                .append(brackets(min.fmt().append(lit("..=")).append(max.fmt()))),
            UInt(width, min, max) => lit("u").append(width.fmt())
                .append(brackets(min.fmt().append(lit("..=")).append(max.fmt()))),
            Float(width, min, max, allow_nan, allow_inf) => {
                let base = width.fmt()
                    .append(brackets(format_f64(min).append(lit("..=")).append(format_f64(max))));
                let with_nan = if allow_nan { base.append(lit("+nan")) } else { base };
                if allow_inf { with_nan.append(lit("+inf")) } else { with_nan }
            },
            Char(charset) => call(lit("char"), List::Cons { charset.fmt(), List::Nil }, 2),
            ValueSpec::String(charset, min_len, max_len) => {
                lit("string").append(parens(charset.fmt()))
                    .append(brackets(min_len.fmt().append(lit("..=")).append(max_len.fmt())))
            },
            Array(elem, min_len, max_len) => {
                lit("array").append(parens(elem.fmt()))
                    .append(brackets(min_len.fmt().append(lit("..=")).append(max_len.fmt())))
            },
            Tuple(items) => {
                parens(comma_list(items.map(|item: ValueSpec| item.fmt())))
            }
        }
    }
}

/// Specification of a single test case within a [`SuiteSpec`].
pub struct CaseSpec {
    pub path: List<Text>,
    pub input: ValueSpec
}

impl CaseSpec {
    /// Generates a random input buffer for this case.
    pub fn generate<R: RandomState>(self: Self, rng: Rng<R>) -> Vec<u8> {
        self.input.generate(rng)
    }
}

impl PartialEq for CaseSpec {
    fn eq(self: Self, other: Self) -> bool {
        list_eq(self.path, other.path) && self.input == other.input
    }
}

impl Eq for CaseSpec {}

impl Display for CaseSpec {
    fn fmt(self: Self) -> Format {
        join(lit("/"), self.path.map(|seg: Text| seg.fmt()))
            .append(lit(": "))
            .append(self.input.fmt())
    }
}

/// Complete specification derived from a (possibly filtered) `TestTree`.
pub struct SuiteSpec {
    pub cases: List<CaseSpec>
}

impl SuiteSpec {
    /// Number of cases in this suite specification.
    pub fn len(self: Self) -> u64 {
        self.cases.len()
    }

    /// Whether the suite specification contains no cases.
    pub fn is_empty(self: Self) -> bool {
        self.cases.is_nil()
    }

    /// Generates a suite-level input buffer: an 8-byte little-endian case
    /// index followed by a random payload for that case's [`ValueSpec`].
    pub fn generate<R: RandomState>(self: Self, rng: Rng<R>) -> Vec<u8> {
        let count = self.cases.len();
        if count == 0 {
            empty_bytes()
        } else {
            let index = sample_u64(rng, 0, count - 1);
            match nth_case(self.cases, index) {
                None => empty_bytes(),
                Some(case_spec) => {
                    let prefix = write_u64_le(empty_bytes(), index);
                    case_spec.input.write_random(rng, prefix)
                }
            }
        }
    }

    /// Serializes this `SuiteSpec` to bytes with a complete round-trip guarantee.
    pub fn to_bytes(self: Self) -> Vec<u8> {
        let out = write_u8(write_magic(Vec::new(), 0x52, 0x54, 0x53, 0x50), 1);
        let out = write_u64_le(out, self.cases.len());
        self.cases.fold_left(out, |buf: Vec<u8>, c: CaseSpec| {
            let buf = write_u64_le(buf, c.path.len());
            let buf = c.path.fold_left(buf, |b: Vec<u8>, seg: Text| write_string_bytes(b, seg));
            c.input.encode_spec(buf)
        })
    }

    /// Reconstructs a `SuiteSpec` from bytes produced by [`SuiteSpec::to_bytes`].
    pub fn from_bytes(bytes: Vec<u8>) -> Option<Self> {
        read_magic(ByteCursor::new(bytes), 0x52, 0x54, 0x53, 0x50)
            .and_then(|c1: ByteCursor| c1.read_u8())
            .and_then(|ver_and_c: (u8, ByteCursor)| {
                let (version, c2) = ver_and_c;
                if version != 1 { Option::None } else { c2.read_u64_le() }
            })
            .and_then(|count_and_c: (u64, ByteCursor)| {
                let (count, c3) = count_and_c;
                decode_case_specs(c3, count, List::Nil)
            })
            .and_then(|cases_and_c: (List<CaseSpec>, ByteCursor)| {
                let (cases, rest) = cases_and_c;
                if rest.is_eof() { Option::Some { SuiteSpec { cases: cases } } } else { Option::None }
            })
    }
}

impl PartialEq for SuiteSpec {
    fn eq(self: Self, other: Self) -> bool {
        list_eq(self.cases, other.cases)
    }
}

impl Eq for SuiteSpec {}

impl Display for SuiteSpec {
    fn fmt(self: Self) -> Format {
        join(Format::Hardline, self.cases.map(|c: CaseSpec| c.fmt()))
    }
}

fn nth_case(cases: List<CaseSpec>, index: u64) -> Option<CaseSpec> {
    match cases {
        Nil => Option::None,
        Cons(head, _) if index == 0 => Option::Some { head },
        Cons(_, tail) => nth_case(tail, index - 1)
    }
}

fn decode_case_specs(
    cursor: ByteCursor,
    remaining: u64,
    acc: List<CaseSpec>
) -> Option<(List<CaseSpec>, ByteCursor)> {
    if remaining == 0 {
        Option::Some { (acc.reverse(), cursor) }
    } else {
        cursor.read_u64_le()
            .and_then(|plen_and_c: (u64, ByteCursor)| {
                let (path_len, c1) = plen_and_c;
                decode_path_segments(c1, path_len, List::Nil)
            })
            .and_then(|path_and_c: (List<Text>, ByteCursor)| {
                let (path, c2) = path_and_c;
                decode_value_spec(c2).and_then(|spec_and_c: (ValueSpec, ByteCursor)| {
                    let (input, c3) = spec_and_c;
                    decode_case_specs(
                        c3,
                        remaining - 1,
                        List::Cons { CaseSpec { path: path, input: input }, acc }
                    )
                })
            })
    }
}

fn decode_path_segments(
    cursor: ByteCursor,
    remaining: u64,
    acc: List<Text>
) -> Option<(List<Text>, ByteCursor)> {
    if remaining == 0 {
        Option::Some { (acc.reverse(), cursor) }
    } else {
        cursor.read_exact_utf8(acc).and_then(|next_and_c: (List<Text>, ByteCursor)| {
            let (next_acc, c1) = next_and_c;
            decode_path_segments(c1, remaining - 1, next_acc)
        })
    }
}

/// Non-allocating cursor over a `Vec<u8>`.
pub struct [value] ByteCursor {
    bytes: Vec<u8>,
    offset: u64
}

impl ByteCursor {
    /// Starts a cursor at the beginning of `bytes`.
    pub fn new(bytes: Vec<u8>) -> Self {
        ByteCursor { bytes: bytes, offset: 0 }
    }

    /// Number of unread bytes remaining.
    pub fn remaining(self: Self) -> u64 {
        let len = self.bytes.len();
        if self.offset >= len { 0 } else { len - self.offset }
    }

    /// Whether all bytes have been consumed.
    pub fn is_eof(self: Self) -> bool {
        self.offset >= self.bytes.len()
    }

    /// Copies the remaining unread bytes into a fresh `Vec<u8>`.
    pub fn slice_remaining(self: Self) -> Vec<u8> {
        let len = self.bytes.len();
        let (_, out) = while [i = self.offset, out = Vec::new()] (i < len) {
            (i + 1, out.push(self.bytes.get(i).unwrap_or(0)))
        };
        out
    }

    /// Reads one byte.
    pub fn read_u8(self: Self) -> Option<(u8, Self)> {
        if self.offset >= self.bytes.len() {
            Option::None
        } else {
            let b = self.bytes.get(self.offset).unwrap_or(0);
            Option::Some { (b, ByteCursor { bytes: self.bytes, offset: self.offset + 1 }) }
        }
    }

    /// Reads a 16-bit little-endian unsigned integer.
    pub fn read_u16_le(self: Self) -> Option<(u16, Self)> {
        if self.remaining() < 2 {
            Option::None
        } else {
            let b0 = self.bytes.get(self.offset).unwrap_or(0) as u16;
            let b1 = self.bytes.get(self.offset + 1).unwrap_or(0) as u16;
            Option::Some { (b0 | (b1 << 8), ByteCursor { bytes: self.bytes, offset: self.offset + 2 }) }
        }
    }

    /// Reads a 32-bit little-endian unsigned integer.
    pub fn read_u32_le(self: Self) -> Option<(u32, Self)> {
        if self.remaining() < 4 {
            Option::None
        } else {
            let b0 = self.bytes.get(self.offset).unwrap_or(0) as u32;
            let b1 = self.bytes.get(self.offset + 1).unwrap_or(0) as u32;
            let b2 = self.bytes.get(self.offset + 2).unwrap_or(0) as u32;
            let b3 = self.bytes.get(self.offset + 3).unwrap_or(0) as u32;
            let value = b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
            Option::Some { (value, ByteCursor { bytes: self.bytes, offset: self.offset + 4 }) }
        }
    }

    /// Reads a 64-bit little-endian unsigned integer.
    pub fn read_u64_le(self: Self) -> Option<(u64, Self)> {
        if self.remaining() < 8 {
            Option::None
        } else {
            let (_, value) = while [i = (0 as u64), acc = (0 as u64)] (i < 8) {
                let b = self.bytes.get(self.offset + i).unwrap_or(0) as u64;
                (i + 1, acc | (b << (i * 8)))
            };
            Option::Some { (value, ByteCursor { bytes: self.bytes, offset: self.offset + 8 }) }
        }
    }

    /// Reads a length-prefixed UTF-8 string and validates that every byte
    /// sequence is well-formed UTF-8.
    fn read_exact_utf8(self: Self, acc: List<Text>) -> Option<(List<Text>, Self)> {
        self.read_u64_le().and_then(|len_and_c: (u64, Self)| {
            let (byte_len, c1) = len_and_c;
            if c1.remaining() < byte_len {
                Option::None
            } else {
                decode_utf8_range(c1.bytes, c1.offset, c1.offset + byte_len, String::new())
                    .map(|s: String| (
                        List::Cons { Text::from_string(s), acc },
                        ByteCursor { bytes: c1.bytes, offset: c1.offset + byte_len }
                    ))
            }
        })
    }
}

/// Decodes a UTF-8 byte slice `start..end` in `bytes` into a `String`,
/// returning `None` on malformed UTF-8.
pub fn decode_utf8_range(bytes: Vec<u8>, start: u64, end: u64, out: String) -> Option<String> {
    let (pos, result, ok) = while [i = start, s = out, valid = true] (i < end && valid) {
        let first = bytes.get(i).unwrap_or(0) as u32;
        if first < 128 {
            (i + 1, s.push_char(raw_scalar_to_char(first)), true)
        } else {
            let (count, init, min_scalar) =
                if first >= 194 && first <= 223 { ((2 as u64), first - 192, (128 as u32)) }
                else { if first >= 224 && first <= 239 { ((3 as u64), first - 224, (2048 as u32)) }
                else { if first >= 240 && first <= 244 { ((4 as u64), first - 240, (65536 as u32)) }
                else { ((0 as u64), (0 as u32), (0 as u32)) } } };
            if count == 0 || i + count > end {
                (i, s, false)
            } else {
                let (_, scalar, cont_ok) = while [k = (1 as u64), val = init, ok = true] (k < count && ok) {
                    let b = bytes.get(i + k).unwrap_or(0) as u32;
                    (k + 1, (val << 6) | (b & 63), b >= 128 && b <= 191)
                };
                if !cont_ok || scalar < min_scalar || !raw_is_valid_scalar(scalar) {
                    (i, s, false)
                } else {
                    (i + count, s.push_char(raw_scalar_to_char(scalar)), true)
                }
            }
        }
    };
    if ok && pos == end { Option::Some { result } } else { Option::None }
}

/// Creates an empty `Vec<u8>`.
pub fn empty_bytes() -> Vec<u8> {
    Vec::new()
}

/// Appends one byte to `out`.
pub fn write_u8(out: Vec<u8>, value: u8) -> Vec<u8> {
    out.push(value)
}

/// Appends a 16-bit unsigned integer in little-endian order.
pub fn write_u16_le(out: Vec<u8>, value: u16) -> Vec<u8> {
    out.push((value & 255) as u8).push(((value >> 8) & 255) as u8)
}

/// Appends a 32-bit unsigned integer in little-endian order.
pub fn write_u32_le(out: Vec<u8>, value: u32) -> Vec<u8> {
    out.push((value & 255) as u8)
        .push(((value >> 8) & 255) as u8)
        .push(((value >> 16) & 255) as u8)
        .push(((value >> 24) & 255) as u8)
}

/// Appends a 64-bit unsigned integer in little-endian order.
pub fn write_u64_le(out: Vec<u8>, value: u64) -> Vec<u8> {
    let (_, buf) = while [i = (0 as u64), buf = out] (i < 8) {
        (i + 1, buf.push(((value >> (i * 8)) & 255) as u8))
    };
    buf
}

fn write_int_le(out: Vec<u8>, width: IntWidth, value: i64) -> Vec<u8> {
    match width {
        I8 => write_u8(out, (value as i8) as u8),
        I16 => write_u16_le(out, (value as i16) as u16),
        I32 => write_u32_le(out, (value as i32) as u32),
        I64 => write_u64_le(out, value as u64)
    }
}

fn write_uint_le(out: Vec<u8>, width: IntWidth, value: u64) -> Vec<u8> {
    match width {
        I8 => write_u8(out, value as u8),
        I16 => write_u16_le(out, value as u16),
        I32 => write_u32_le(out, value as u32),
        I64 => write_u64_le(out, value)
    }
}

fn write_string_bytes(out: Vec<u8>, text: Text) -> Vec<u8> {
    let n = text.len();
    let out = write_u64_le(out, n);
    let (_, out) = while [i = (0 as u64), buf = out] (i < n) {
        (i + 1, buf.push(text.byte_at(i)))
    };
    out
}

fn write_magic(out: Vec<u8>, b0: u8, b1: u8, b2: u8, b3: u8) -> Vec<u8> {
    out.push(b0).push(b1).push(b2).push(b3)
}

fn read_magic(cursor: ByteCursor, b0: u8, b1: u8, b2: u8, b3: u8) -> Option<ByteCursor> {
    if cursor.remaining() < 4 {
        Option::None
    } else {
        let ok = cursor.bytes.get(cursor.offset).unwrap_or(0) == b0
            && cursor.bytes.get(cursor.offset + 1).unwrap_or(0) == b1
            && cursor.bytes.get(cursor.offset + 2).unwrap_or(0) == b2
            && cursor.bytes.get(cursor.offset + 3).unwrap_or(0) == b3;
        if ok {
            Option::Some { ByteCursor { bytes: cursor.bytes, offset: cursor.offset + 4 } }
        } else {
            Option::None
        }
    }
}

/// Projects an arbitrary `u64` into `[min, max]`.
pub fn project_u64(raw: u64, min: u64, max: u64) -> u64 {
    if min >= max {
        min
    } else { if raw >= min && raw <= max {
        raw
    } else { if min == 0 && max == 0xffffffffffffffff {
        raw
    } else {
        let span: u128 = (max as u128) - (min as u128) + 1;
        min + (((raw as u128) % span) as u64)
    } } }
}

/// Projects an arbitrary `i64` into `[min, max]`.
pub fn project_i64(raw: i64, min: i64, max: i64) -> i64 {
    if min >= max {
        min
    } else { if raw >= min && raw <= max {
        raw
    } else {
        let sign_bit: u64 = 0x8000000000000000;
        let u_min = (min as u64) ^ sign_bit;
        let u_max = (max as u64) ^ sign_bit;
        let u_raw = (raw as u64) ^ sign_bit;
        let projected = project_u64(u_raw, u_min, u_max);
        (projected ^ sign_bit) as i64
    } }
}

/// Projects an arbitrary `f64` (or its raw bits) into `[min, max]`, honoring
/// `allow_nan` and `allow_inf`.
pub fn project_f64(raw: f64, bits: u64, min: f64, max: f64, allow_nan: bool, allow_inf: bool) -> f64 {
    let raw_bits = f64_to_bits(raw);
    if is_nan_bits(raw_bits) {
        if allow_nan { raw } else { interpolate_f64(bits, min, max) }
    } else { if is_inf_bits(raw_bits) {
        if allow_inf { raw } else { interpolate_f64(bits, min, max) }
    } else { if raw >= min && raw <= max {
        raw
    } else {
        interpolate_f64(bits, min, max)
    } } }
}

fn is_nan_bits(bits: u64) -> bool {
    ((bits & 0x7ff0000000000000) == 0x7ff0000000000000) && ((bits & 0x000fffffffffffff) != 0)
}

fn is_inf_bits(bits: u64) -> bool {
    (bits & 0x7fffffffffffffff) == 0x7ff0000000000000
}

fn interpolate_f64(bits: u64, min: f64, max: f64) -> f64 {
    if min >= max {
        min
    } else {
        let u = ((bits >> 11) as f64) * (1.0 / 9007199254740992.0);
        let v = (1.0 - u) * min + u * max;
        if v < min { min } else { if v > max { max } else { v } }
    }
}

fn sample_u64<R: RandomState>(rng: Rng<R>, min: u64, max: u64) -> u64 {
    project_u64(rng.next(), min, max)
}

fn sample_i64<R: RandomState>(rng: Rng<R>, min: i64, max: i64) -> i64 {
    project_i64(rng.next() as i64, min, max)
}

fn sample_f64<R: RandomState>(
    rng: Rng<R>,
    min: f64,
    max: f64,
    allow_nan: bool,
    allow_inf: bool
) -> f64 {
    let pick = rng.next();
    let tag = pick & 31;
    if allow_nan && tag == 0 {
        f64_from_bits(0x7ff8000000000000)
    } else { if allow_inf && tag == 1 {
        f64_from_bits(0x7ff0000000000000)
    } else { if allow_inf && tag == 2 {
        f64_from_bits(0xfff0000000000000)
    } else { if tag == 3 {
        min
    } else { if tag == 4 {
        max
    } else { if tag == 5 && min <= 0.0 && max >= 0.0 {
        0.0
    } else {
        interpolate_f64(rng.next(), min, max)
    } } } } } }
}

fn lit(s: str) -> Format {
    Format::Text { Text::from_str(s) }
}
