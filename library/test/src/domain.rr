//! FuzzTest-style input domain combinators.
//!
//! A [`Domain<T>`] pairs a serializable [`ValueSpec`] with a byte-stream
//! decoder and a counterexample formatter. Constraint methods such as
//! [`Domain::in_range`], [`Domain::positive`], [`Domain::non_empty`], and
//! [`Domain::with_len_range`] refine the underlying [`ValueSpec`] directly,
//! so both the derived [`SuiteSpec`](test::spec::SuiteSpec) and the runtime
//! decoder stay in lockstep:
//!
//! ```text
//! let tree = TestTree::group("math")
//!     .with_fuzz(
//!         "bounded sum",
//!         domain::tuple2(
//!             domain::i64().in_range(-100, 100),
//!             domain::i64().non_negative().at_most(50)
//!         ),
//!         |pair: (i64, i64)| {
//!             let (a, b) = pair;
//!             expect(a + b >= -100 && a + b <= 150, "within bounds")
//!         }
//!     );
//! ```

import core::intrinsic::array;
import std::collections::cow::vec::Vec;
import std::collections::pure::list::List;
import std::format::Display;
import std::format::Format;
import std::format::brackets;
import std::format::comma_list;
import std::format::parens;
import std::option::Option;
import std::random::RandomState;
import std::random::Rng;
import std::string::String;
import std::text::Text;
import test::spec::ByteCursor;
import test::spec::Charset;
import test::spec::FloatWidth;
import test::spec::IntWidth;
import test::spec::ValueSpec;
import test::spec::decode_utf8_range;
import test::spec::f32_from_bits;
import test::spec::f64_from_bits;
import test::spec::format_f32;
import test::spec::format_f64;
import test::spec::project_f64;
import test::spec::project_i64;
import test::spec::project_u64;

/// A typed input domain backed by a [`ValueSpec`].
pub struct Domain<T> {
    spec: ValueSpec,
    decode: (ValueSpec, ByteCursor) -> Option<(T, ByteCursor)>,
    format: T -> Format
}

impl<T> Domain<T> {
    /// Creates a domain from its specification, decoder, and formatter.
    pub fn new(
        spec: ValueSpec,
        decode: (ValueSpec, ByteCursor) -> Option<(T, ByteCursor)>,
        format: T -> Format
    ) -> Self {
        Domain { spec: spec, decode: decode, format: format }
    }

    /// Returns the input specification of this domain.
    pub fn spec(self: Self) -> ValueSpec {
        self.spec
    }

    /// Decodes a value from `cursor`, returning the value and advanced cursor.
    pub fn decode(self: Self, cursor: ByteCursor) -> Option<(T, ByteCursor)> {
        (self.decode)(self.spec, cursor)
    }

    /// Decodes a value from a complete `Vec<u8>` buffer.
    pub fn decode_bytes(self: Self, bytes: Vec<u8>) -> Option<T> {
        self.decode(ByteCursor::new(bytes)).map(|val_and_c: (T, ByteCursor)| {
            let (val, _) = val_and_c;
            val
        })
    }

    /// Formats a materialized value for failure counterexamples.
    pub fn format(self: Self, value: T) -> Format {
        (self.format)(value)
    }

    /// Generates a random byte buffer from `self.spec()` using `rng` and
    /// decodes it into a value of type `T`.
    pub fn sample<R: RandomState>(self: Self, rng: Rng<R>) -> T {
        let bytes = self.spec.generate(rng);
        // `bytes` was generated from `self.spec`, so decoding against the same spec succeeds.
        self.decode_bytes(bytes).unwrap_or_panic()
    }

    fn with_spec(self: Self, spec: ValueSpec) -> Self {
        Domain { spec: spec, decode: self.decode, format: self.format }
    }

    /// Restricts a numeric domain to the inclusive signed range `[min, max]`.
    pub fn in_range(self: Self, min: i64, max: i64) -> Self {
        let (lo, hi) = if min <= max { (min, max) } else { (max, min) };
        let next_spec = match self.spec {
            Int(w, _, _) => ValueSpec::Int {
                w,
                clamp_i64(lo, w.signed_min(), w.signed_max()),
                clamp_i64(hi, w.signed_min(), w.signed_max())
            },
            UInt(w, _, _) => {
                let u_lo = if lo < 0 { 0 } else { lo as u64 };
                let u_hi = if hi < 0 { 0 } else { hi as u64 };
                ValueSpec::UInt {
                    w,
                    clamp_u64(u_lo, 0, w.unsigned_max()),
                    clamp_u64(u_hi, 0, w.unsigned_max())
                }
            },
            Float(w, _, _, nan, inf) => ValueSpec::Float { w, lo as f64, hi as f64, nan, inf },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Restricts an unsigned integer domain to `[min, max]`.
    pub fn in_range_u64(self: Self, min: u64, max: u64) -> Self {
        let (lo, hi) = if min <= max { (min, max) } else { (max, min) };
        let next_spec = match self.spec {
            UInt(w, _, _) => ValueSpec::UInt {
                w,
                clamp_u64(lo, 0, w.unsigned_max()),
                clamp_u64(hi, 0, w.unsigned_max())
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Restricts a floating-point domain to `[min, max]`.
    pub fn in_range_f64(self: Self, min: f64, max: f64) -> Self {
        let (lo, hi) = if min <= max { (min, max) } else { (max, min) };
        let next_spec = match self.spec {
            Float(w, _, _, nan, inf) => ValueSpec::Float { w, lo, hi, nan, inf },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Sets the inclusive lower bound on a signed integer domain.
    pub fn at_least(self: Self, min: i64) -> Self {
        let next_spec = match self.spec {
            Int(w, _, cur_max) => {
                let lo = clamp_i64(min, w.signed_min(), w.signed_max());
                let hi = if cur_max < lo { lo } else { cur_max };
                ValueSpec::Int { w, lo, hi }
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Sets the inclusive upper bound on a signed integer domain.
    pub fn at_most(self: Self, max: i64) -> Self {
        let next_spec = match self.spec {
            Int(w, cur_min, _) => {
                let hi = clamp_i64(max, w.signed_min(), w.signed_max());
                let lo = if cur_min > hi { hi } else { cur_min };
                ValueSpec::Int { w, lo, hi }
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Restricts a numeric domain to strictly positive values (`> 0`).
    pub fn positive(self: Self) -> Self {
        let next_spec = match self.spec {
            Int(w, _, cur_max) => {
                let hi = if cur_max < 1 { w.signed_max() } else { cur_max };
                ValueSpec::Int { w, 1, hi }
            },
            UInt(w, _, cur_max) => {
                let hi = if cur_max < 1 { w.unsigned_max() } else { cur_max };
                ValueSpec::UInt { w, 1, hi }
            },
            Float(w, _, cur_max, _, _) => {
                let hi = if cur_max <= 0.0 { 1000000.0 } else { cur_max };
                let lo = if hi < 0.000001 { hi } else { 0.000001 };
                ValueSpec::Float { w, lo, hi, false, false }
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Restricts a numeric domain to non-negative values (`>= 0`).
    pub fn non_negative(self: Self) -> Self {
        let next_spec = match self.spec {
            Int(w, _, cur_max) => {
                let hi = if cur_max < 0 { w.signed_max() } else { cur_max };
                ValueSpec::Int { w, 0, hi }
            },
            UInt(w, _, cur_max) => ValueSpec::UInt { w, 0, cur_max },
            Float(w, _, cur_max, _, _) => {
                let hi = if cur_max < 0.0 { 1000000.0 } else { cur_max };
                ValueSpec::Float { w, 0.0, hi, false, false }
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Restricts a numeric domain to strictly negative values (`< 0`).
    pub fn negative(self: Self) -> Self {
        let next_spec = match self.spec {
            Int(w, cur_min, _) => {
                let lo = if cur_min >= 0 { w.signed_min() } else { cur_min };
                ValueSpec::Int { w, lo, -1 }
            },
            Float(w, cur_min, _, _, _) => {
                let lo = if cur_min >= 0.0 { -1000000.0 } else { cur_min };
                let hi = if lo > -0.000001 { lo } else { -0.000001 };
                ValueSpec::Float { w, lo, hi, false, false }
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Restricts a numeric domain to non-positive values (`<= 0`).
    pub fn non_positive(self: Self) -> Self {
        let next_spec = match self.spec {
            Int(w, cur_min, _) => {
                let lo = if cur_min > 0 { w.signed_min() } else { cur_min };
                ValueSpec::Int { w, lo, 0 }
            },
            UInt(w, _, _) => ValueSpec::UInt { w, 0, 0 },
            Float(w, cur_min, _, _, _) => {
                let lo = if cur_min > 0.0 { -1000000.0 } else { cur_min };
                ValueSpec::Float { w, lo, 0.0, false, false }
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Excludes `NaN` and `±Inf` from a floating-point domain.
    pub fn finite(self: Self) -> Self {
        let next_spec = match self.spec {
            Float(w, lo, hi, _, _) => ValueSpec::Float { w, lo, hi, false, false },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Permits `NaN` in a floating-point domain.
    pub fn allow_nan(self: Self) -> Self {
        let next_spec = match self.spec {
            Float(w, lo, hi, _, inf) => ValueSpec::Float { w, lo, hi, true, inf },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Permits `±Inf` in a floating-point domain.
    pub fn allow_inf(self: Self) -> Self {
        let next_spec = match self.spec {
            Float(w, lo, hi, nan, _) => ValueSpec::Float { w, lo, hi, nan, true },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Permits both `NaN` and `±Inf` in a floating-point domain.
    pub fn any_float(self: Self) -> Self {
        let next_spec = match self.spec {
            Float(w, lo, hi, _, _) => ValueSpec::Float { w, lo, hi, true, true },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Restricts a floating-point domain to the finite interval `[0.0, 1.0]`.
    pub fn unit_interval(self: Self) -> Self {
        let next_spec = match self.spec {
            Float(w, _, _, _, _) => ValueSpec::Float { w, 0.0, 1.0, false, false },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Sets the character class of a character or string domain.
    pub fn with_charset(self: Self, charset: Charset) -> Self {
        let next_spec = match self.spec {
            Char(_) => ValueSpec::Char { charset },
            ValueSpec::String(_, lo, hi) => ValueSpec::String { charset, lo, hi },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Restricts a character or string domain to ASCII (`0x00..=0x7F`).
    pub fn ascii(self: Self) -> Self {
        self.with_charset(Charset::Ascii)
    }

    /// Restricts a character or string domain to printable ASCII (`0x20..=0x7E`).
    pub fn printable(self: Self) -> Self {
        self.with_charset(Charset::AsciiPrintable)
    }

    /// Restricts a character or string domain to ASCII letters and digits.
    pub fn alphanumeric(self: Self) -> Self {
        self.with_charset(Charset::Alphanumeric)
    }

    /// Restricts a character or string domain to ASCII letters.
    pub fn alpha(self: Self) -> Self {
        self.with_charset(Charset::Alpha)
    }

    /// Restricts a character or string domain to ASCII decimal digits (`0..=9`).
    pub fn digits(self: Self) -> Self {
        self.with_charset(Charset::Digits)
    }

    /// Restricts a character or string domain to identifier characters (`A-Z`, `a-z`, `0-9`, `_`).
    pub fn identifier(self: Self) -> Self {
        self.with_charset(Charset::Identifier)
    }

    /// Allows arbitrary valid Unicode scalar values in a character or string domain.
    pub fn utf8(self: Self) -> Self {
        self.with_charset(Charset::Utf8)
    }

    /// Fixes the exact length of a string or array/vector/list domain to `len`.
    pub fn with_len(self: Self, len: u64) -> Self {
        self.with_len_range(len, len)
    }

    /// Restricts the length of a string or array/vector/list domain to `[min_len, max_len]`.
    pub fn with_len_range(self: Self, min_len: u64, max_len: u64) -> Self {
        let (lo, hi) = if min_len <= max_len { (min_len, max_len) } else { (max_len, min_len) };
        let next_spec = match self.spec {
            ValueSpec::String(cs, _, _) => ValueSpec::String { cs, lo, hi },
            Array(elem, _, _) => ValueSpec::Array { elem, lo, hi },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Requires a string or array/vector/list domain to have length at least 1.
    pub fn non_empty(self: Self) -> Self {
        let next_spec = match self.spec {
            ValueSpec::String(cs, lo, hi) => {
                let next_lo = if lo < 1 { 1 } else { lo };
                let next_hi = if hi < next_lo { next_lo } else { hi };
                ValueSpec::String { cs, next_lo, next_hi }
            },
            Array(elem, lo, hi) => {
                let next_lo = if lo < 1 { 1 } else { lo };
                let next_hi = if hi < next_lo { next_lo } else { hi };
                ValueSpec::Array { elem, next_lo, next_hi }
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Caps the maximum length of a string or array/vector/list domain at `max_len`.
    pub fn max_len(self: Self, max_len: u64) -> Self {
        let next_spec = match self.spec {
            ValueSpec::String(cs, lo, _) => {
                let next_lo = if lo > max_len { max_len } else { lo };
                ValueSpec::String { cs, next_lo, max_len }
            },
            Array(elem, lo, _) => {
                let next_lo = if lo > max_len { max_len } else { lo };
                ValueSpec::Array { elem, next_lo, max_len }
            },
            other => other
        };
        self.with_spec(next_spec)
    }

    /// Maps values produced by `self` through `f`, using `format` to display
    /// mapped counterexamples.
    pub fn map<U>(self: Self, f: T -> U, format: U -> Format) -> Domain<U> {
        let inner_decode = self.decode;
        Domain {
            spec: self.spec,
            decode: |spec: ValueSpec, cursor: ByteCursor| {
                inner_decode(spec, cursor).map(|val_and_c: (T, ByteCursor)| {
                    let (v, next_c) = val_and_c;
                    (f(v), next_c)
                })
            },
            format: format
        }
    }

    /// Maps values produced by `self` through `f` for any `Display` target type.
    pub fn map_display<U: Display>(self: Self, f: T -> U) -> Domain<U> {
        self.map(f, |v: U| v.fmt())
    }

    /// Lifts `self` into a `Domain<Vec<T>>` with default length `0..=16`.
    pub fn vec(self: Self) -> Domain<Vec<T>> {
        vec_of(self)
    }

    /// Lifts `self` into a `Domain<Vec<T>>` with length in `[min_len, max_len]`.
    pub fn vec_with_len(self: Self, min_len: u64, max_len: u64) -> Domain<Vec<T>> {
        vec_of(self).with_len_range(min_len, max_len)
    }

    /// Lifts `self` into a `Domain<List<T>>` with default length `0..=16`.
    pub fn list(self: Self) -> Domain<List<T>> {
        list_of(self)
    }

    /// Lifts `self` into a `Domain<List<T>>` with length in `[min_len, max_len]`.
    pub fn list_with_len(self: Self, min_len: u64, max_len: u64) -> Domain<List<T>> {
        list_of(self).with_len_range(min_len, max_len)
    }

    /// Lifts `self` into a 1D dynamic array `Domain<[T; ?]>` with default length `0..=16`.
    pub fn array(self: Self, default: T) -> Domain<[T; ?]> {
        array_of(self, default)
    }

    /// Lifts `self` into a 1D dynamic array `Domain<[T; ?]>` with length in `[min_len, max_len]`.
    pub fn array_with_len(self: Self, min_len: u64, max_len: u64, default: T) -> Domain<[T; ?]> {
        array_of(self, default).with_len_range(min_len, max_len)
    }
}

/// Boolean domain (`true` or `false`).
pub fn bool_domain() -> Domain<bool> {
    Domain {
        spec: ValueSpec::Bool,
        decode: |unused_spec: ValueSpec, cursor: ByteCursor| {
            cursor.read_u8().map(|b_and_c: (u8, ByteCursor)| {
                let (b, c1) = b_and_c;
                ((b & 1) != 0, c1)
            })
        },
        format: |v: bool| v.fmt()
    }
}

/// Signed 8-bit integer domain (`-128..=127` by default).
pub fn i8_domain() -> Domain<i8> {
    let w = IntWidth::I8;
    Domain {
        spec: ValueSpec::Int { w, w.signed_min(), w.signed_max() },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            decode_signed(spec, cursor).map(|v_and_c: (i64, ByteCursor)| {
                let (v, c1) = v_and_c;
                (v as i8, c1)
            })
        },
        format: |v: i8| v.fmt()
    }
}

/// Signed 16-bit integer domain (`-32768..=32767` by default).
pub fn i16_domain() -> Domain<i16> {
    let w = IntWidth::I16;
    Domain {
        spec: ValueSpec::Int { w, w.signed_min(), w.signed_max() },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            decode_signed(spec, cursor).map(|v_and_c: (i64, ByteCursor)| {
                let (v, c1) = v_and_c;
                (v as i16, c1)
            })
        },
        format: |v: i16| v.fmt()
    }
}

/// Signed 32-bit integer domain (`i32::MIN..=i32::MAX` by default).
pub fn i32_domain() -> Domain<i32> {
    let w = IntWidth::I32;
    Domain {
        spec: ValueSpec::Int { w, w.signed_min(), w.signed_max() },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            decode_signed(spec, cursor).map(|v_and_c: (i64, ByteCursor)| {
                let (v, c1) = v_and_c;
                (v as i32, c1)
            })
        },
        format: |v: i32| v.fmt()
    }
}

/// Signed 64-bit integer domain (`i64::MIN..=i64::MAX` by default).
pub fn i64_domain() -> Domain<i64> {
    let w = IntWidth::I64;
    Domain {
        spec: ValueSpec::Int { w, w.signed_min(), w.signed_max() },
        decode: decode_signed,
        format: |v: i64| v.fmt()
    }
}

/// Signed 64-bit integer domain restricted to `[min, max]`.
pub fn in_range(min: i64, max: i64) -> Domain<i64> {
    i64_domain().in_range(min, max)
}

/// Unsigned 8-bit integer domain (`0..=255` by default).
pub fn u8_domain() -> Domain<u8> {
    let w = IntWidth::I8;
    Domain {
        spec: ValueSpec::UInt { w, 0, w.unsigned_max() },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            decode_unsigned(spec, cursor).map(|v_and_c: (u64, ByteCursor)| {
                let (v, c1) = v_and_c;
                (v as u8, c1)
            })
        },
        format: |v: u8| v.fmt()
    }
}

/// Unsigned 16-bit integer domain (`0..=65535` by default).
pub fn u16_domain() -> Domain<u16> {
    let w = IntWidth::I16;
    Domain {
        spec: ValueSpec::UInt { w, 0, w.unsigned_max() },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            decode_unsigned(spec, cursor).map(|v_and_c: (u64, ByteCursor)| {
                let (v, c1) = v_and_c;
                (v as u16, c1)
            })
        },
        format: |v: u16| v.fmt()
    }
}

/// Unsigned 32-bit integer domain (`0..=u32::MAX` by default).
pub fn u32_domain() -> Domain<u32> {
    let w = IntWidth::I32;
    Domain {
        spec: ValueSpec::UInt { w, 0, w.unsigned_max() },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            decode_unsigned(spec, cursor).map(|v_and_c: (u64, ByteCursor)| {
                let (v, c1) = v_and_c;
                (v as u32, c1)
            })
        },
        format: |v: u32| v.fmt()
    }
}

/// Unsigned 64-bit integer domain (`0..=u64::MAX` by default).
pub fn u64_domain() -> Domain<u64> {
    let w = IntWidth::I64;
    Domain {
        spec: ValueSpec::UInt { w, 0, w.unsigned_max() },
        decode: decode_unsigned,
        format: |v: u64| v.fmt()
    }
}

/// Unsigned 64-bit integer domain restricted to `[min, max]`.
pub fn in_range_u64(min: u64, max: u64) -> Domain<u64> {
    u64_domain().in_range_u64(min, max)
}

/// 32-bit floating-point domain (finite values in `[-1e6, 1e6]` by default).
pub fn f32_domain() -> Domain<f32> {
    Domain {
        spec: ValueSpec::Float { FloatWidth::F32, -1000000.0, 1000000.0, false, false },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            let (min, max, nan, inf) = float_bounds(spec);
            cursor.read_u32_le().map(|bits_and_c: (u32, ByteCursor)| {
                let (bits, c1) = bits_and_c;
                let raw = f32_from_bits(bits) as f64;
                let ext_bits = (bits as u64) << 32;
                let projected = project_f64(raw, ext_bits, min, max, nan, inf) as f32;
                (projected, c1)
            })
        },
        format: |v: f32| format_f32(v)
    }
}

/// 64-bit floating-point domain (finite values in `[-1e6, 1e6]` by default).
pub fn f64_domain() -> Domain<f64> {
    Domain {
        spec: ValueSpec::Float { FloatWidth::F64, -1000000.0, 1000000.0, false, false },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            let (min, max, nan, inf) = float_bounds(spec);
            cursor.read_u64_le().map(|bits_and_c: (u64, ByteCursor)| {
                let (bits, c1) = bits_and_c;
                let raw = f64_from_bits(bits);
                let projected = project_f64(raw, bits, min, max, nan, inf);
                (projected, c1)
            })
        },
        format: |v: f64| format_f64(v)
    }
}

/// 64-bit floating-point domain restricted to `[min, max]`.
pub fn in_range_f64(min: f64, max: f64) -> Domain<f64> {
    f64_domain().in_range_f64(min, max)
}

/// Single-character domain (printable ASCII by default; use `.utf8()`,
/// `.alphanumeric()`, etc. to change character class).
pub fn char_domain() -> Domain<char> {
    Domain {
        spec: ValueSpec::Char { Charset::AsciiPrintable },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            let cs = match spec {
                Char(c) => c,
                _ => Charset::AsciiPrintable
            };
            cursor.read_u32_le().map(|raw_and_c: (u32, ByteCursor)| {
                let (raw, c1) = raw_and_c;
                let candidate = cs.map_word(raw as u64);
                let ch = if raw <= 1114111 && !(raw >= 55296 && raw <= 57343) {
                    let c = char_from_u32_or(raw, candidate);
                    if cs.contains(c) { c } else { candidate }
                } else {
                    candidate
                };
                (ch, c1)
            })
        },
        format: |ch: char| Format::Text { Text::from_str("'") }
            .append(ch.fmt())
            .append(Format::Text { Text::from_str("'") })
    }
}

/// Growable `String` domain (printable ASCII of length `0..=32` by default).
pub fn string() -> Domain<String> {
    Domain {
        spec: ValueSpec::String { Charset::AsciiPrintable, 0, 32 },
        decode: decode_string_spec,
        format: |s: String| quote_text(Text::Owned { s })
    }
}

/// `Text` domain (printable ASCII of length `0..=32` by default).
pub fn text() -> Domain<Text> {
    Domain {
        spec: ValueSpec::String { Charset::AsciiPrintable, 0, 32 },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            decode_string_spec(spec, cursor).map(|s_and_c: (String, ByteCursor)| {
                let (s, c1) = s_and_c;
                (Text::Owned { s }, c1)
            })
        },
        format: |t: Text| quote_text(t)
    }
}

/// Printable ASCII `String` domain (`0..=32` chars by default).
pub fn ascii() -> Domain<String> {
    string().printable()
}

/// Printable ASCII `Text` domain (`0..=32` chars by default).
pub fn ascii_text() -> Domain<Text> {
    text().printable()
}

/// Alphanumeric `String` domain (`A-Z`, `a-z`, `0-9`, length `0..=32`).
pub fn alphanumeric() -> Domain<String> {
    string().alphanumeric()
}

/// Alphabetic `String` domain (`A-Z`, `a-z`, length `0..=32`).
pub fn alpha() -> Domain<String> {
    string().alpha()
}

/// Decimal digit `String` domain (`0-9`, length `0..=32`).
pub fn digits() -> Domain<String> {
    string().digits()
}

/// Identifier `String` domain (`A-Z`, `a-z`, `0-9`, `_`, length `1..=32`).
pub fn identifier() -> Domain<String> {
    string().identifier().with_len_range(1, 32)
}

/// Homogeneous `Vec<T>` domain with elements from `elem` (length `0..=16` by default).
pub fn vec_of<T>(elem: Domain<T>) -> Domain<Vec<T>> {
    let elem_decode = elem.decode;
    let elem_fmt = elem.format;
    Domain {
        spec: ValueSpec::Array { elem.spec(), 0, 16 },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            let (elem_spec, min_len, max_len) = array_bounds(spec, elem.spec());
            cursor.read_u64_le().and_then(|raw_and_c: (u64, ByteCursor)| {
                let (raw_len, c1) = raw_and_c;
                let len = project_u64(raw_len, min_len, max_len);
                decode_vec_elems(elem_spec, elem_decode, c1, len, Vec::new())
            })
        },
        format: |v: Vec<T>| format_vec(v, elem_fmt)
    }
}

/// Homogeneous `List<T>` domain with elements from `elem` (length `0..=16` by default).
pub fn list_of<T>(elem: Domain<T>) -> Domain<List<T>> {
    let elem_decode = elem.decode;
    let elem_fmt = elem.format;
    Domain {
        spec: ValueSpec::Array { elem.spec(), 0, 16 },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            let (elem_spec, min_len, max_len) = array_bounds(spec, elem.spec());
            cursor.read_u64_le().and_then(|raw_and_c: (u64, ByteCursor)| {
                let (raw_len, c1) = raw_and_c;
                let len = project_u64(raw_len, min_len, max_len);
                decode_list_elems(elem_spec, elem_decode, c1, len, List::Nil)
            })
        },
        format: |items: List<T>| brackets(comma_list(items.map(elem_fmt)))
    }
}

/// 1D dynamic-extent array `[T; ?]` domain with elements from `elem` and
/// length `0..=16` by default. `default` initializes the backing allocation.
pub fn array_of<T>(elem: Domain<T>, default: T) -> Domain<[T; ?]> {
    let elem_decode = elem.decode;
    let elem_fmt = elem.format;
    Domain {
        spec: ValueSpec::Array { elem.spec(), 0, 16 },
        decode: |spec: ValueSpec, cursor: ByteCursor| {
            let (elem_spec, min_len, max_len) = array_bounds(spec, elem.spec());
            cursor.read_u64_le().and_then(|raw_and_c: (u64, ByteCursor)| {
                let (raw_len, c1) = raw_and_c;
                let len = project_u64(raw_len, min_len, max_len);
                let initial = array::splat<[T; ?]>(len, default);
                decode_array_elems(elem_spec, elem_decode, c1, 0, len, initial)
            })
        },
        format: |arr: [T; ?]| format_array(arr, elem_fmt)
    }
}

/// 1D dynamic array `[i64; ?]` domain (`0..=16` elements by default).
pub fn i64_array() -> Domain<[i64; ?]> {
    array_of(i64_domain(), 0)
}

/// 1D dynamic array `[i32; ?]` domain (`0..=16` elements by default).
pub fn i32_array() -> Domain<[i32; ?]> {
    array_of(i32_domain(), 0)
}

/// 1D dynamic array `[u64; ?]` domain (`0..=16` elements by default).
pub fn u64_array() -> Domain<[u64; ?]> {
    array_of(u64_domain(), 0)
}

/// 1D dynamic array `[u8; ?]` domain (`0..=16` elements by default).
pub fn u8_array() -> Domain<[u8; ?]> {
    array_of(u8_domain(), 0)
}

/// 1D dynamic array `[f64; ?]` domain (`0..=16` elements by default).
pub fn f64_array() -> Domain<[f64; ?]> {
    array_of(f64_domain(), 0.0)
}

/// 1D dynamic array `[f32; ?]` domain (`0..=16` elements by default).
pub fn f32_array() -> Domain<[f32; ?]> {
    array_of(f32_domain(), 0.0)
}

/// 1D dynamic array `[bool; ?]` domain (`0..=16` elements by default).
pub fn bool_array() -> Domain<[bool; ?]> {
    array_of(bool_domain(), false)
}

/// Product of two domains.
pub fn tuple2<A, B>(a: Domain<A>, b: Domain<B>) -> Domain<(A, B)> {
    let spec = ValueSpec::Tuple {
        List::Cons { a.spec(), List::Cons { b.spec(), List::Nil } }
    };
    Domain {
        spec: spec,
        decode: |unused_spec: ValueSpec, cursor: ByteCursor| {
            a.decode(cursor).and_then(|va_and_c: (A, ByteCursor)| {
                let (va, c1) = va_and_c;
                b.decode(c1).map(|vb_and_c: (B, ByteCursor)| {
                    let (vb, c2) = vb_and_c;
                    ((va, vb), c2)
                })
            })
        },
        format: |pair: (A, B)| {
            let (va, vb) = pair;
            parens(comma_list(List::Cons { a.format(va), List::Cons { b.format(vb), List::Nil } }))
        }
    }
}

/// Product of three domains.
pub fn tuple3<A, B, C>(a: Domain<A>, b: Domain<B>, c: Domain<C>) -> Domain<(A, B, C)> {
    let spec = ValueSpec::Tuple {
        List::Cons {
            a.spec(),
            List::Cons { b.spec(), List::Cons { c.spec(), List::Nil } }
        }
    };
    Domain {
        spec: spec,
        decode: |unused_spec: ValueSpec, cursor: ByteCursor| {
            a.decode(cursor).and_then(|va_and_c: (A, ByteCursor)| {
                let (va, c1) = va_and_c;
                b.decode(c1).and_then(|vb_and_c: (B, ByteCursor)| {
                    let (vb, c2) = vb_and_c;
                    c.decode(c2).map(|vc_and_c: (C, ByteCursor)| {
                        let (vc, c3) = vc_and_c;
                        ((va, vb, vc), c3)
                    })
                })
            })
        },
        format: |triple: (A, B, C)| {
            let (va, vb, vc) = triple;
            parens(comma_list(List::Cons {
                a.format(va),
                List::Cons { b.format(vb), List::Cons { c.format(vc), List::Nil } }
            }))
        }
    }
}

/// Product of four domains.
pub fn tuple4<A, B, C, D>(
    a: Domain<A>,
    b: Domain<B>,
    c: Domain<C>,
    d: Domain<D>
) -> Domain<(A, B, C, D)> {
    let spec = ValueSpec::Tuple {
        List::Cons {
            a.spec(),
            List::Cons {
                b.spec(),
                List::Cons { c.spec(), List::Cons { d.spec(), List::Nil } }
            }
        }
    };
    Domain {
        spec: spec,
        decode: |unused_spec: ValueSpec, cursor: ByteCursor| {
            a.decode(cursor).and_then(|va_and_c: (A, ByteCursor)| {
                let (va, c1) = va_and_c;
                b.decode(c1).and_then(|vb_and_c: (B, ByteCursor)| {
                    let (vb, c2) = vb_and_c;
                    c.decode(c2).and_then(|vc_and_c: (C, ByteCursor)| {
                        let (vc, c3) = vc_and_c;
                        d.decode(c3).map(|vd_and_c: (D, ByteCursor)| {
                            let (vd, c4) = vd_and_c;
                            ((va, vb, vc, vd), c4)
                        })
                    })
                })
            })
        },
        format: |quad: (A, B, C, D)| {
            let (va, vb, vc, vd) = quad;
            parens(comma_list(List::Cons {
                a.format(va),
                List::Cons {
                    b.format(vb),
                    List::Cons { c.format(vc), List::Cons { d.format(vd), List::Nil } }
                }
            }))
        }
    }
}

fn clamp_i64(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { lo } else { if v > hi { hi } else { v } }
}

fn clamp_u64(v: u64, lo: u64, hi: u64) -> u64 {
    if v < lo { lo } else { if v > hi { hi } else { v } }
}

fn decode_signed(spec: ValueSpec, cursor: ByteCursor) -> Option<(i64, ByteCursor)> {
    let (width, min, max) = match spec {
        Int(w, lo, hi) => (w, lo, hi),
        _ => (IntWidth::I64, IntWidth::I64.signed_min(), IntWidth::I64.signed_max())
    };
    let raw_opt = match width {
        I8 => cursor.read_u8().map(|x: (u8, ByteCursor)| {
            let (b, c) = x;
            ((b as i8) as i64, c)
        }),
        I16 => cursor.read_u16_le().map(|x: (u16, ByteCursor)| {
            let (w, c) = x;
            ((w as i16) as i64, c)
        }),
        I32 => cursor.read_u32_le().map(|x: (u32, ByteCursor)| {
            let (d, c) = x;
            ((d as i32) as i64, c)
        }),
        I64 => cursor.read_u64_le().map(|x: (u64, ByteCursor)| {
            let (q, c) = x;
            (q as i64, c)
        })
    };
    raw_opt.map(|x: (i64, ByteCursor)| {
        let (raw, c1) = x;
        (project_i64(raw, min, max), c1)
    })
}

fn decode_unsigned(spec: ValueSpec, cursor: ByteCursor) -> Option<(u64, ByteCursor)> {
    let (width, min, max) = match spec {
        UInt(w, lo, hi) => (w, lo, hi),
        _ => (IntWidth::I64, 0, IntWidth::I64.unsigned_max())
    };
    let raw_opt = match width {
        I8 => cursor.read_u8().map(|x: (u8, ByteCursor)| {
            let (b, c) = x;
            (b as u64, c)
        }),
        I16 => cursor.read_u16_le().map(|x: (u16, ByteCursor)| {
            let (w, c) = x;
            (w as u64, c)
        }),
        I32 => cursor.read_u32_le().map(|x: (u32, ByteCursor)| {
            let (d, c) = x;
            (d as u64, c)
        }),
        I64 => cursor.read_u64_le()
    };
    raw_opt.map(|x: (u64, ByteCursor)| {
        let (raw, c1) = x;
        (project_u64(raw, min, max), c1)
    })
}

fn float_bounds(spec: ValueSpec) -> (f64, f64, bool, bool) {
    match spec {
        Float(_, lo, hi, nan, inf) => (lo, hi, nan, inf),
        _ => (-1000000.0, 1000000.0, false, false)
    }
}

#[ffi(import)]
fn raw_try_char(value: u32, fallback: char) -> char [{
    char::from_u32(value).unwrap_or(fallback)
}];

fn char_from_u32_or(value: u32, fallback: char) -> char {
    raw_try_char(value, fallback)
}

fn decode_string_spec(spec: ValueSpec, cursor: ByteCursor) -> Option<(String, ByteCursor)> {
    let (charset, min_len, max_len) = match spec {
        ValueSpec::String(cs, lo, hi) => (cs, lo, hi),
        _ => (Charset::AsciiPrintable, 0, 32)
    };
    cursor.read_u64_le().and_then(|len_and_c: (u64, ByteCursor)| {
        let (byte_len, c1) = len_and_c;
        if c1.remaining() < byte_len {
            Option::None
        } else {
            let (raw_bytes, next_cursor) = read_cursor_bytes(c1, byte_len);
            let decoded = match decode_utf8_range(raw_bytes, 0, byte_len, String::new()) {
                Some(valid) => sanitize_string(valid, charset, min_len, max_len),
                None => sanitize_bytes_to_string(raw_bytes, charset, min_len, max_len)
            };
            Option::Some { (decoded, next_cursor) }
        }
    })
}

fn read_cursor_bytes(cursor: ByteCursor, count: u64) -> (Vec<u8>, ByteCursor) {
    let (_, next_c, out) = while [i = (0 as u64), cur = cursor, buf = Vec::new()] (i < count) {
        match cur.read_u8() {
            None => (count, cur, buf),
            Some(b_and_c) => {
                let (b, next_c) = b_and_c;
                (i + 1, next_c, buf.push(b))
            }
        }
    };
    (out, next_c)
}

fn sanitize_string(s: String, charset: Charset, min_len: u64, max_len: u64) -> String {
    let text = Text::Owned { s };
    let n = text.len();
    let (_, count, out) = while [idx = (0 as u64), count = (0 as u64), out = String::new()]
        (idx < n && count < max_len) {
        match text.decode_char(idx) {
            None => (n, count, out),
            Some(ch_and_next) => {
                let (ch, next_idx) = ch_and_next;
                let clean = if charset.contains(ch) {
                    ch
                } else {
                    charset.map_word(ch as u64)
                };
                (next_idx, count + 1, out.push_char(clean))
            }
        }
    };
    let (_, padded) = while [c = count, acc = out] (c < min_len) {
        (c + 1, acc.push_char(charset.map_word(c)))
    };
    padded
}

fn sanitize_bytes_to_string(bytes: Vec<u8>, charset: Charset, min_len: u64, max_len: u64) -> String {
    let n = bytes.len();
    let target = project_u64(n, min_len, max_len);
    let (_, out) = while [i = (0 as u64), acc = String::new()] (i < target) {
        let word = if i < n { bytes.get(i).unwrap_or(0) as u64 } else { i };
        (i + 1, acc.push_char(charset.map_word(word)))
    };
    out
}

fn array_bounds(spec: ValueSpec, fallback_elem: ValueSpec) -> (ValueSpec, u64, u64) {
    match spec {
        Array(elem, lo, hi) => (elem, lo, hi),
        _ => (fallback_elem, 0, 16)
    }
}

fn decode_vec_elems<T>(
    elem_spec: ValueSpec,
    elem_decode: (ValueSpec, ByteCursor) -> Option<(T, ByteCursor)>,
    cursor: ByteCursor,
    remaining: u64,
    acc: Vec<T>
) -> Option<(Vec<T>, ByteCursor)> {
    if remaining == 0 {
        Option::Some { (acc, cursor) }
    } else {
        elem_decode(elem_spec, cursor).and_then(|val_and_c: (T, ByteCursor)| {
            let (val, next_c) = val_and_c;
            decode_vec_elems(elem_spec, elem_decode, next_c, remaining - 1, acc.push(val))
        })
    }
}

fn decode_list_elems<T>(
    elem_spec: ValueSpec,
    elem_decode: (ValueSpec, ByteCursor) -> Option<(T, ByteCursor)>,
    cursor: ByteCursor,
    remaining: u64,
    acc: List<T>
) -> Option<(List<T>, ByteCursor)> {
    if remaining == 0 {
        Option::Some { (acc.reverse(), cursor) }
    } else {
        elem_decode(elem_spec, cursor).and_then(|val_and_c: (T, ByteCursor)| {
            let (val, next_c) = val_and_c;
            decode_list_elems(
                elem_spec,
                elem_decode,
                next_c,
                remaining - 1,
                List::Cons { val, acc }
            )
        })
    }
}

fn decode_array_elems<T>(
    elem_spec: ValueSpec,
    elem_decode: (ValueSpec, ByteCursor) -> Option<(T, ByteCursor)>,
    cursor: ByteCursor,
    index: u64,
    total: u64,
    acc: [T; ?]
) -> Option<([T; ?], ByteCursor)> {
    if index >= total {
        Option::Some { (acc, cursor) }
    } else {
        elem_decode(elem_spec, cursor).and_then(|val_and_c: (T, ByteCursor)| {
            let (val, next_c) = val_and_c;
            let updated = array::set(acc, index as i64, val);
            decode_array_elems(elem_spec, elem_decode, next_c, index + 1, total, updated)
        })
    }
}

fn format_vec<T>(v: Vec<T>, elem_fmt: T -> Format) -> Format {
    let n = v.len();
    let (_, docs) = while [i = n, acc = List::Nil] (i > 0) {
        let idx = i - 1;
        let item = v.get(idx).unwrap_or_panic();
        (idx, List::Cons { elem_fmt(item), acc })
    };
    brackets(comma_list(docs))
}

fn format_array<T>(arr: [T; ?], elem_fmt: T -> Format) -> Format {
    let n = array::dim(arr, 0);
    let (_, docs) = while [i = n, acc = List::Nil] (i > 0) {
        let idx = i - 1;
        let item = array::get(arr, idx as i64);
        (idx, List::Cons { elem_fmt(item), acc })
    };
    brackets(comma_list(docs))
}

fn quote_text(t: Text) -> Format {
    let quote = Format::Text { Text::from_str("\"") };
    quote.append(t.fmt()).append(quote)
}
