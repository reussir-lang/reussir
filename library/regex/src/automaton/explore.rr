//! The search for the states of a list of rules.
//!
//! The states are numbered in the order they are found; the state of the
//! rules as written is 0. A state holds the rules that can still match,
//! each with the node of what is left of it; a rule whose node matches
//! nothing is left out:
//!
//! ```text
//! rules    0: [a-z]+    1: [0-9]+
//!
//! state    rules left                accepts    letter    digit    other
//! 0        0: [a-z]+ , 1: [0-9]+                1         2        3
//! 1        0: [a-z]*                 rule 0     1         3        3
//! 2        1: [0-9]*                 rule 1     3         2        3
//! 3                                             3         3        3
//! ```

import std::collections::cow::vec::Vec;
import std::collections::pure::hashmap::HashMap;
import std::collections::pure::list::List;
import std::hash::Hash;
import std::hash::Hasher;
import std::option::Option;
import regex::alphabet::byte_classes::ByteClasses;
import regex::automaton::TooManyStates;
import regex::node::Node;
import regex::node::Nodes;
import regex::tree::ByteRegex;
import std::result::Result;

/// The states of a list of rules as the search found them.
pub struct Explored {
    /// The number of classes of bytes.
    pub classes: u64,
    /// The state after each state on each class, row after row.
    pub next: Vec<u32>,
    /// The earliest rule that accepts in each state.
    pub winners: Vec<Option<u32>>
}

impl Explored {
    /// The number of states.
    pub fn states(self: Self) -> u64 {
        self.winners.len()
    }
}

/// A rule that can still match, and the node of what is left of it.
pub struct [value] Live {
    rule: u32,
    node: Node
}

impl PartialEq for Live {
    fn eq(self: Self, other: Self) -> bool {
        self.rule == other.rule && self.node == other.node
    }
}

impl Eq for Live {}

impl Hash for Live {
    fn hash<H: Hasher>(self: Self, state: H) -> H {
        state.write_u32(self.rule).write(self.node)
    }
}

// The states found so far.
struct StateTable {
    nodes: Nodes,
    // The rules left in every state, by number.
    states: Vec<List<Live>>,
    // The number of every state, by the rules left in it.
    numbers: HashMap<List<Live>, u32>,
    // The transitions of the states expanded so far, row after row.
    next: Vec<u32>
}

// `others` with `rule` in front of them, unless `node` matches nothing: the
// derivative of nothing is nothing, so such a rule never matches again.
fn keep(rule: u32, node: Node, others: List<Live>) -> List<Live> {
    if node == Node::nothing() {
        others
    } else {
        List::Cons { Live { rule, node }, others }
    }
}

// The rules that can match at all, numbered from `rule`, in their order.
fn add_all(nodes: Nodes, rules: List<ByteRegex>, classes: ByteClasses, rule: u32) -> (Nodes, List<Live>) {
    match rules {
        Nil => (nodes, List::Nil),
        Cons(first, rest) => {
            let (nodes, node) = nodes.add(first, classes);
            let (nodes, others) = add_all(nodes, rest, classes, rule + 1);
            (nodes, keep(rule, node, others))
        }
    }
}

// The rules of a state that can still match after a byte of `class`.
fn derive_all(nodes: Nodes, state: List<Live>, class: u64) -> (Nodes, List<Live>) {
    match state {
        Nil => (nodes, List::Nil),
        Cons(first, rest) => {
            let (nodes, derived) = nodes.derive(first.node, class);
            let (nodes, others) = derive_all(nodes, rest, class);
            (nodes, keep(first.rule, derived, others))
        }
    }
}

// The earliest rule whose node matches the empty string. The rules of a
// state are in their order.
fn earliest(nodes: Nodes, state: List<Live>) -> Option<u32> {
    match state {
        Nil => Option::None,
        Cons(first, _) if nodes.accepts_empty(first.node) => Option::Some { first.rule },
        Cons(_, rest) => earliest(nodes, rest)
    }
}

impl StateTable {
    fn new(nodes: Nodes) -> Self {
        StateTable { nodes, states: Vec::new(), numbers: HashMap::new(), next: Vec::new() }
    }

    // The number of the state with these rules left. A new state takes the
    // next number and is entered under them.
    fn allocate(self: Self, state: List<Live>) -> (Self, u32) {
        match self.numbers.get(state) {
            Some(number) => (self, number),
            None => {
                // The fields leave `self` first: a field that `self` still
                // holds is copied by its update.
                let nodes = self.nodes;
                let states = self.states;
                let numbers = self.numbers;
                let next = self.next;
                let number = states.len() as u32;
                let grown = StateTable {
                    nodes,
                    states: states.push(state),
                    numbers: numbers.insert(state, number),
                    next
                };
                (grown, number)
            }
        }
    }

    // The rules left where `state` leads to on `class`.
    fn derive(self: Self, state: List<Live>, class: u64) -> (Self, List<Live>) {
        // The nodes leave `self` first, so that a new node is added to
        // them in place.
        let nodes = self.nodes;
        let states = self.states;
        let numbers = self.numbers;
        let next = self.next;
        let (nodes, target) = derive_all(nodes, state, class);
        (StateTable { nodes, states, numbers, next }, target)
    }

    // One more transition of the row that is being written.
    fn push(self: Self, to: u32) -> Self {
        StateTable { nodes: self.nodes, states: self.states, numbers: self.numbers, next: self.next.push(to) }
    }

    // One row: where `state` goes on every class.
    fn expand(self: Self, state: List<Live>, classes: u64) -> Self {
        let (_, table) = while [class = 0, table = self] (class < classes) {
            let (table, target) = table.derive(state, class);
            let (table, number) = table.allocate(target);
            (class + 1, table.push(number))
        };
        table
    }

    // The earliest rule that accepts in each state.
    fn winners(self: Self) -> Vec<Option<u32>> {
        let (_, winners) = while [state = 0, winners = Vec::new()] (state < self.states.len()) {
            (state + 1, winners.push(earliest(self.nodes, self.states.get(state).unwrap_or(List::Nil))))
        };
        winners
    }
}

// The states of `start` and those that follow them, each expanded in the
// order it was found, over `classes` classes of bytes.
fn follow(start: StateTable, classes: u64, limit: u64) -> Result<Explored, TooManyStates> {
    let (_, table) = while [at = 0, table = start] (at < table.states.len() && table.states.len() <= limit) {
        let state = table.states.get(at).unwrap_or(List::Nil);
        (at + 1, table.expand(state, classes))
    };
    if table.states.len() > limit { Result::Err { TooManyStates { limit } } } else {
        Result::Ok { Explored { classes, next: table.next, winners: table.winners() } }
    }
}

/// The states of `rules` over the classes `sets`, each expanded in the
/// order it was found. The search gives up when it has found more than
/// `limit` states.
pub fn explore(rules: List<ByteRegex>, sets: ByteClasses, limit: u64) -> Result<Explored, TooManyStates> {
    let (nodes, first) = add_all(Nodes::new(), rules, sets, 0);
    let (start, _) = StateTable::new(nodes).allocate(first);
    follow(start, sets.len(), limit)
}

/// The states of each list of `lists` alone, in one table, and the state
/// that each list begins in. The rules of every list are numbered from 0,
/// so a state that two lists come to with the same rules left is one
/// state. The search gives up when it has found more than `limit` states.
pub fn explore_each(lists: List<List<ByteRegex>>, sets: ByteClasses, limit: u64) -> Result<(Explored, Vec<u32>), TooManyStates> {
    let (start, begins) = lists.fold_left((StateTable::new(Nodes::new()), Vec::new()), |so_far: (StateTable, Vec<u32>), rules: List<ByteRegex>| {
        let (table, begins) = so_far;
        // The fields leave the table first, as in `allocate`.
        let nodes = table.nodes;
        let states = table.states;
        let numbers = table.numbers;
        let next = table.next;
        let (nodes, first) = add_all(nodes, rules, sets, 0);
        let (table, number) = StateTable { nodes, states, numbers, next }.allocate(first);
        (table, begins.push(number))
    });
    match follow(start, sets.len(), limit) {
        Ok(found) => Result::Ok { (found, begins) },
        Err(error) => Result::Err { error }
    }
}
