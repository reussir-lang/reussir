//! The questions of the rules, in the order they are asked.
//!
//! A question is asked of a stretch of bytes that is known to match a
//! part of a rule, and says where the parts inside it are. The places are
//! kept in registers: the first two are the beginning and the end of the
//! match, and every question fills one more, which the questions after it
//! read. A group is two registers, known when the questions are written:
//!
//! ```text
//! rule      ([0-9]+) ("-" ([0-9]+) | [a-z]+)
//!
//! r2        where [0-9]+ ends in the bytes from r0 to r1, with
//!           "-" [0-9]+ | [a-z]+ matching the rest
//! r3, r4    which branch the bytes from r2 to r1 are of: r3 is r2 when
//!           they are a dash and digits, and else r4 is
//! r5        where "-" ends in the bytes from r3 to r1, with [0-9]+
//!           matching the rest
//! group 1   from r0 to r2
//! group 2   from r2 to r1
//! group 3   from r5 to r1
//! ```
//!
//! A register of a part that the bytes did not come through holds no
//! place, and so do the registers that its questions fill. The groups
//! of a repetition are asked of its last time.
//!
//! A question is six words: what it asks, the registers of the beginning
//! and of the end of its bytes, the first register that it fills, and
//! two more: automata, by their numbers in the table of `table`, or a
//! count. An automaton is that of a list of regexes without groups, and
//! says the earliest of them that matches; a part of a rule is a list of
//! one, and the branches of a union are a list.

import std::collections::cow::vec::Vec;
import std::collections::pure::list::List;
import std::option::Option;
import regex::tree::ByteRegex;
import regex::tree::Regex;

/// Where the first of two parts ends: the automaton `first` matches up
/// to there and the automaton `second` from there on.
pub fn splits() -> u64 {
    0
}

/// Which of `second` branches the bytes are of: the earliest that the
/// automaton `first` says. The register of that branch, counted from the
/// one that the question fills, holds their beginning.
pub fn chooses() -> u64 {
    1
}

/// Where the last time of a repetition begins, with the automaton
/// `first` of what is repeated; no place when there are no bytes.
pub fn repeats() -> u64 {
    2
}

/// The same for once or more: with no bytes, the one time has none.
pub fn repeats_once() -> u64 {
    3
}

/// The number of words of a question.
pub fn width() -> u64 {
    6
}

/// The questions of a list of rules.
pub struct Asked {
    pub code: Vec<u64>,
    /// Four words for each rule: where its questions begin and where they
    /// end, the number of its groups, the whole match counted, and where
    /// its spans begin.
    pub rules: Vec<u64>,
    /// Two registers for each group of each rule: where it begins and
    /// where it ends.
    pub spans: Vec<u64>,
    /// The lists of regexes that the questions read with, each an
    /// automaton, the last one first, and their number.
    pub parts: List<List<ByteRegex>>,
    pub count: u64,
    // The registers of the rule in hand, and the most that a rule has.
    registers: u64,
    pub most: u64
}

// A part of parts that come one after another: the part alone and the
// parts from it on, both without their groups, and the number of groups
// from it on.
struct Piece {
    regex: Regex,
    alone: ByteRegex,
    onward: ByteRegex,
    groups: u64
}

// The number of groups in `regex`.
fn groups_of(regex: Regex) -> u64 {
    match regex {
        Group(inner) => 1 + groups_of(inner),
        Concat(first, second) => groups_of(first) + groups_of(second),
        Union(first, second) => groups_of(first) + groups_of(second),
        Intersect(first, second) => groups_of(first) + groups_of(second),
        Star(inner) => groups_of(inner),
        Plus(inner) => groups_of(inner),
        Not(inner) => groups_of(inner),
        // A set, the empty string or nothing.
        _ => 0
    }
}

// Whether `regex` has a group under a complement or an intersection:
// the bytes that match one do not come through what is inside it.
fn misplaces(regex: Regex) -> bool {
    match regex {
        Group(inner) => misplaces(inner),
        Concat(first, second) => misplaces(first) || misplaces(second),
        Union(first, second) => misplaces(first) || misplaces(second),
        Star(inner) => misplaces(inner),
        Plus(inner) => misplaces(inner),
        // A complement or an intersection, or what has no group.
        _ => groups_of(regex) > 0
    }
}

/// The first of `rules`, numbered from `rule`, with a misplaced group.
pub fn misplaced(rules: List<Regex>, rule: u32) -> Option<u32> {
    match rules {
        Nil => Option::None,
        Cons(regex, _) if misplaces(regex) => Option::Some { rule },
        Cons(_, rest) => misplaced(rest, rule + 1)
    }
}

// The parts of `regex` that come one after another, before `after`,
// however `then` nests them.
fn flat(regex: Regex, after: List<Regex>) -> List<Regex> {
    match regex {
        Concat(first, second) => flat(first, flat(second, after)),
        // Anything else is one part.
        _ => List::Cons { regex, after }
    }
}

// The branches of `regex`, before `after`, however `or` nests them.
fn branches(regex: Regex, after: List<Regex>) -> List<Regex> {
    match regex {
        Union(first, second) => branches(first, branches(second, after)),
        // Anything else is one branch.
        _ => List::Cons { regex, after }
    }
}

// `parts` as pieces. The parts from one on hold the parts from the next
// on, so n parts are n concatenations.
fn pieces(parts: List<Regex>) -> List<Piece> {
    match parts {
        Nil => List::Nil,
        Cons(regex, rest) => {
            let after = pieces(rest);
            let alone = regex.to_bytes();
            let piece = match after {
                Nil => Piece { regex, alone, onward: alone, groups: groups_of(regex) },
                Cons(next, _) => Piece {
                    regex,
                    alone,
                    onward: ByteRegex::Concat { alone, next.onward },
                    groups: groups_of(regex) + next.groups
                }
            };
            List::Cons { piece, after }
        }
    }
}

impl Asked {
    fn new() -> Asked {
        Asked { code: Vec::new(), rules: Vec::new(), spans: Vec::new(), parts: List::Nil, count: 0, registers: 2, most: 2 }
    }

    // One more automaton, that of `regexes`, and its number.
    fn reads(self: Self, regexes: List<ByteRegex>) -> (Asked, u64) {
        let asked = Asked {
            code: self.code,
            rules: self.rules,
            spans: self.spans,
            parts: List::Cons { regexes, self.parts },
            count: self.count + 1,
            registers: self.registers,
            most: self.most
        };
        (asked, self.count)
    }

    // One more question about the bytes from the register `from` to the
    // register `to`, and the register that it fills.
    fn ask(self: Self, what: u64, from: u64, to: u64, first: u64, second: u64) -> (Asked, u64) {
        let fills = self.registers;
        let asked = Asked {
            code: self.code.push(what).push(from).push(to).push(fills).push(first).push(second),
            rules: self.rules,
            spans: self.spans,
            parts: self.parts,
            count: self.count,
            registers: fills + 1,
            most: self.most
        };
        (asked, fills)
    }

    // `count` more registers of the rule in hand, after the one that the
    // last question fills.
    fn spare(self: Self, count: u64) -> Asked {
        Asked {
            code: self.code,
            rules: self.rules,
            spans: self.spans,
            parts: self.parts,
            count: self.count,
            registers: self.registers + count,
            most: self.most
        }
    }

    // One more group of the rule in hand: the bytes from the register
    // `from` to the register `to`.
    fn group(self: Self, from: u64, to: u64) -> Asked {
        Asked {
            code: self.code,
            rules: self.rules,
            spans: self.spans.push(from).push(to),
            parts: self.parts,
            count: self.count,
            registers: self.registers,
            most: self.most
        }
    }

    // The rule in hand is done: its questions began at `began` and its
    // spans at `spans`.
    fn close(self: Self, began: u64, spans: u64) -> Asked {
        Asked {
            rules: self.rules.push(began).push(self.code.len()).push((self.spans.len() - spans) / 2).push(spans),
            code: self.code,
            spans: self.spans,
            parts: self.parts,
            count: self.count,
            registers: 2,
            most: if self.registers > self.most { self.registers } else { self.most }
        }
    }

    // The questions of `regex`, whose bytes are from the register `from`
    // to the register `to`. The groups are met in the order they begin in.
    fn part(self: Self, regex: Regex, from: u64, to: u64) -> Asked {
        match regex {
            Group(inner) => self.group(from, to).part(inner, from, to),
            Concat(_, _) => self.parts(pieces(flat(regex, List::Nil)), from, to),
            Union(_, _) if groups_of(regex) > 0 => {
                let all = branches(regex, List::Nil);
                let (asked, which) = self.reads(all.map(|branch: Regex| branch.to_bytes()));
                let (asked, one) = asked.ask(chooses(), from, to, which, all.len());
                asked.spare(all.len() - 1).each(all, one, to)
            },
            Star(inner) if groups_of(inner) > 0 => self.times(repeats(), inner, from, to),
            Plus(inner) if groups_of(inner) > 0 => self.times(repeats_once(), inner, from, to),
            // Nothing else has a group inside that is not misplaced.
            _ => self
        }
    }

    // The questions of a repetition of `inner`: where its last time
    // begins, and the questions of that time.
    fn times(self: Self, what: u64, inner: Regex, from: u64, to: u64) -> Asked {
        let (asked, body) = self.reads(List::Cons { inner.to_bytes(), List::Nil });
        let (asked, last) = asked.ask(what, from, to, body, 0);
        asked.part(inner, last, to)
    }

    // The questions of `branches`, each with its bytes from its own
    // register, the first of them `from`, to the register `to`.
    fn each(self: Self, branches: List<Regex>, from: u64, to: u64) -> Asked {
        match branches {
            Nil => self,
            Cons(first, rest) => self.part(first, from, to).each(rest, from + 1, to)
        }
    }

    // The questions of `pieces`, which come one after another in the bytes
    // from the register `from` to the register `to`. Where the parts
    // without a group after the last group end changes no group, and is
    // not asked.
    fn parts(self: Self, pieces: List<Piece>, from: u64, to: u64) -> Asked {
        match pieces {
            Cons(first, rest) if first.groups > 0 => match rest {
                Nil => self.part(first.regex, from, to),
                Cons(next, _) => {
                    let (asked, head) = self.reads(List::Cons { first.alone, List::Nil });
                    let (asked, tail) = asked.reads(List::Cons { next.onward, List::Nil });
                    let (asked, between) = asked.ask(splits(), from, to, head, tail);
                    asked.part(first.regex, from, between).parts(rest, between, to)
                }
            },
            // No part is left, or none with a group.
            _ => self
        }
    }
}

/// The questions of `rules`, none of which has a misplaced group.
pub fn ask(rules: List<Regex>) -> Asked {
    rules.fold_left(Asked::new(), |asked: Asked, rule: Regex| {
        let began = asked.code.len();
        let spans = asked.spans.len();
        asked.group(0, 1).part(rule, 0, 1).close(began, spans)
    })
}
