//! The operator traits: each arithmetic, bitwise and logical operator is
//! sugar for a call of its trait's method, `a + b` for `Add::add(a, b)`.
//!
//! `#[sealed]`: only the impls below exist. They take the builtin form, an
//! empty body, and the compiler makes a call through one the built-in
//! operation. `Num` and `Integral` in `core::num` inherit from the traits,
//! so `T: Num` code can use the arithmetic operators.

/// `a + b`.
#[lang("add")]
#[sealed]
pub trait Add {
    fn add(self: Self, other: Self) -> Self;
}

/// `a - b`.
#[lang("sub")]
#[sealed]
pub trait Sub {
    fn sub(self: Self, other: Self) -> Self;
}

/// `a * b`.
#[lang("mul")]
#[sealed]
pub trait Mul {
    fn mul(self: Self, other: Self) -> Self;
}

/// `a / b`.
#[lang("div")]
#[sealed]
pub trait Div {
    fn div(self: Self, other: Self) -> Self;
}

/// `a % b`.
#[lang("rem")]
#[sealed]
pub trait Rem {
    fn rem(self: Self, other: Self) -> Self;
}

/// `-a`.
#[lang("neg")]
#[sealed]
pub trait Neg {
    fn neg(self: Self) -> Self;
}

/// `a & b`.
#[lang("bit_and")]
#[sealed]
pub trait BitAnd {
    fn bitand(self: Self, other: Self) -> Self;
}

/// `a | b`.
#[lang("bit_or")]
#[sealed]
pub trait BitOr {
    fn bitor(self: Self, other: Self) -> Self;
}

/// `a ^ b`.
#[lang("bit_xor")]
#[sealed]
pub trait BitXor {
    fn bitxor(self: Self, other: Self) -> Self;
}

/// `!a`.
#[lang("not")]
#[sealed]
pub trait Not {
    fn not(self: Self) -> Self;
}

/// `a << n` and `a >> n`. `Amount` is the type of `n`: the type of `a`, or
/// `i64` where `a` is a `Nat` or an `Int`.
#[lang("shift")]
#[sealed]
pub trait Shift {
    type Amount = Self;
    fn shl(self: Self, amount: Self::Amount) -> Self;
    fn shr(self: Self, amount: Self::Amount) -> Self;
}

