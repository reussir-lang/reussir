//! Declaration anchors for the compiler's device-array and default-placement
//! types. These records supply source locations, not nominal runtime layouts.

/// A managed device array. `T` is a scalar or ranked array shape; omitted `P`
/// selects `DefaultPlacement`. Named placement markers carry target metadata.
#[lang("dev_array")]
pub struct DevArray<T, P> {}

/// The compile-time placement selecting logical device zero.
#[lang("default_placement")]
pub struct [value] DefaultPlacement {}

/// Allocate initialized device storage. Dynamic extents precede the fill value,
/// in shape order. The runtime stages initialized host memory and waits for the
/// upload; this is not a device-native fill.
#[lang("core::intrinsic::pjrt::alloc")]
pub fn alloc<Result, Args>(args: Args) -> Result;

/// Copy a host scalar/array to placement P (default device zero when omitted).
/// Upload borrows host storage until it completes and returns an owned DevArray.
#[lang("core::intrinsic::pjrt::upload")]
pub fn upload<P, Host, Result>(host: Host) -> Result;

/// Upload an i64 scalar and keep its exact host value with the DevArray, so a
/// kernel launch can use it to refine dynamic shapes such as `dynamic_iota`
/// extents. Forwarding or sharing the DevArray keeps the value; kernel outputs
/// do not inherit it. Use this only for shape parameters: `upload` keeps scalar
/// data dynamic. Placement P defaults to device zero.
#[lang("core::intrinsic::pjrt::upload_shape")]
pub fn upload_shape<P, Result>(host: i64) -> Result;

/// Copy a device array to fresh host storage and wait. Rank-zero returns its
/// scalar; ranked results retain their static/dynamic host array shape.
#[lang("core::intrinsic::pjrt::download")]
pub fn download<Device, Host>(device: Device) -> Host;

/// The logical extent along an axis, checked against the rank at runtime.
#[lang("core::intrinsic::pjrt::dim")]
pub fn dim<Device>(device: Device, axis: u64) -> u64;

impl<T, P> DevArray<T, P> {
    /// Copy back to the host, preserving the complete scalar/shape argument T.
    pub fn download(self: Self) -> T {
        core::intrinsic::pjrt::download(self)
    }

    /// Query the logical shape, including uneven sharding's original extents.
    pub fn dim(self: Self, axis: u64) -> u64 {
        core::intrinsic::pjrt::dim(self, axis)
    }

    /// Upload a host scalar or array using this type's placement.
    pub fn from_host(value: T) -> Self {
        core::intrinsic::pjrt::upload<P>(value)
    }
}

/// Launch a named kernel: `launch<P>(kernel<T>, buffers...)`.
///
/// This prototype is a declaration anchor for a special intrinsic form, not an
/// ordinary function value. The optional configuration P defaults to
/// DefaultPlacement. The first syntactic argument names a kernel; its signature
/// determines the remaining buffer arguments and the single DevArray result.
/// Launch has no source keyword and supports ordinary module/function imports.
#[lang("core::intrinsic::pjrt::launch")]
pub fn launch<P>();
