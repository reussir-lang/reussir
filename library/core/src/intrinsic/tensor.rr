//! Declaration anchor for the builtin tensor type. Its element and shape are
//! checked by the compiler; the anchor supplies a source location for tools.

/// A scope-confined numeric tensor: `Tensor<f32>` has rank zero, while
/// `Tensor<[f32; ?, 4]>` carries an explicit shape. Zero extents are valid.
#[lang("tensor")]
pub struct Tensor<T> { }

// Kernel SSA types from the StableHLO specification. Token orders side effects;
// it is not a runtime completion handle and may fan out or join.
#[lang("tensor_token")]
pub struct Token {}

// The intrinsic former is variadic: Future<Tensor<f32>, Tensor<[i32; ?]>>.
// T anchors the minimum one payload; ordinary records are not variadic.
// Every payload must be a Tensor. Payload order and shapes are preserved.
// This is not a host promise: no RC ownership, host storage, closure capture,
// or FFI. StableHLO's type supports multiple payloads even though the pinned
// async_start/async_done operations currently accept a single result.
#[lang("tensor_future")]
pub struct Future<T> {}

/// Kernel-only slice. Result supplies static slice sizes. Start indices form
/// a rank-sized tuple of same-typed integers (or rank-zero integer tensors).
#[lang("core::intrinsic::tensor::dynamic_slice")]
pub fn dynamic_slice<Result, Input, Starts>(input: Input, starts: Starts) -> Result;

/// Resolve one tensor result from a StableHLO future, inside a kernel.
/// The intrinsic checker requires Input = Future<Result> with one Tensor payload;
/// these generic parameters are declaration metadata, not call-site arguments.
#[lang("core::intrinsic::tensor::async_done")]
pub fn async_done<Input, Result>(future: Input) -> Result;

/// Kernel-only unit-stride slice. Result supplies static sizes; starts is a
/// rank-sized tuple of nonnegative compile-time integer literals.
#[lang("core::intrinsic::tensor::slice")]
pub fn slice<Result, Input, Starts>(input: Input, starts: Starts) -> Result;

/// Kernel-only cross-replica permutation. Pairs are literal (source, target)
/// replica ids; each source and each target may occur at most once.
#[lang("core::intrinsic::tensor::collective_permute")]
pub fn collective_permute<T, Pairs>(input: T, pairs: Pairs) -> T;
