// The constant sequence former and its intrinsics' declaration sites.
// `ConstSeq<T>` is an immutable static sequence of constants of `T` — an
// integer, floating-point, `bool`, or `char` scalar, another constant
// sequence, or a `[value]` record whose fields are constants — created from
// a sequence literal `[e0, e1, ...]` that the compiler evaluates. Like `str`,
// a value is a view of a global and its length, and is not reference-counted.

/// An immutable static sequence of `T` constants.
#[lang("const_seq")]
pub struct ConstSeq<T> { }

/// The number of elements.
#[lang("core::intrinsic::const_seq::len")]
pub fn len<T>(seq: ConstSeq<T>) -> u64;

/// The element at `index`; panics when `index` is out of bounds.
#[lang("core::intrinsic::const_seq::get")]
pub fn get<T>(seq: ConstSeq<T>, index: u64) -> T;

impl<T> ConstSeq<T> {
    /// The number of elements.
    pub fn len(self: Self) -> u64 {
        core::intrinsic::const_seq::len(self)
    }

    /// The element at `index`; panics when `index` is out of bounds.
    pub fn get(self: Self, index: u64) -> T {
        core::intrinsic::const_seq::get(self, index)
    }
}
