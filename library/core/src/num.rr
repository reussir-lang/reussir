//! The numeric tower: the sealed classes arithmetic, numeric literals,
//! and casts wire to.
//!
//! `#[sealed]`: membership is fixed — the compiler provides the scalar
//! impls (an `impl` target must be a named type, so `i64 : Integral`
//! cannot be written in source) and lowers everything intrinsically.
//! `Num: PartialOrd` is the compatibility edge that keeps `T: Num` code
//! comparing.

#[lang("num")]
#[sealed]
pub trait Num: PartialOrd {}

/// Whole numbers: `i8`…`i64`, `u8`…`u64`, `Nat`, and `Int`.
#[lang("integral")]
#[sealed]
pub trait Integral: Num {}

/// Floating-point scalars: `f16`, `f32`, `f64`, `bf16`, `f8`.
#[lang("floating_point")]
#[sealed]
pub trait FloatingPoint: Num {}

/// The natural numbers, without bound. `Nat` is a built-in integer type,
/// not a record: small values need no allocation. The enum declares how
/// `Nat` values are built and matched: `Zero` is 0 and `Succ(n)` is `n + 1`.
#[lang("nat")]
pub enum Nat {
    Zero,
    Succ(Nat)
}

/// The integers, without bound. Like `Nat`, `Int` is a built-in integer
/// type: `OfNat(n)` is the nonnegative `n` and `NegSucc(n)` is `-(n + 1)`.
#[lang("int")]
pub enum Int {
    OfNat(Nat),
    NegSucc(Nat)
}

// The builtin impls (see `core::cmp` for the form): membership of the
// sealed numeric classes, declared in source.

impl Integral for i8 { }
impl Integral for i16 { }
impl Integral for i32 { }
impl Integral for i64 { }
impl Integral for u8 { }
impl Integral for u16 { }
impl Integral for u32 { }
impl Integral for u64 { }
impl Integral for Nat { }
impl Integral for Int { }
impl Integral for Arc<Nat> { }
impl Integral for Arc<Int> { }

impl FloatingPoint for f16 { }
impl FloatingPoint for f32 { }
impl FloatingPoint for f64 { }
impl FloatingPoint for bfloat16 { }
impl FloatingPoint for float8 { }

// The built-in integers are totally ordered; their comparison impls live
// beside their declarations.
impl PartialEq for Nat { }
impl PartialEq for Int { }
impl Eq for Nat { }
impl Eq for Int { }
impl PartialOrd for Nat { }
impl PartialOrd for Int { }
impl Ord for Nat { }
impl Ord for Int { }

// Their `Arc` colorings, the same integers counted atomically, compare and
// compute alike.
impl PartialEq for Arc<Nat> { }
impl PartialEq for Arc<Int> { }
impl Eq for Arc<Nat> { }
impl Eq for Arc<Int> { }
impl PartialOrd for Arc<Nat> { }
impl PartialOrd for Arc<Int> { }
impl Ord for Arc<Nat> { }
impl Ord for Arc<Int> { }

// Operations beyond the operators, through `core::intrinsic::bigint`. The
// operators keep the fixed-width integers' conventions: `/` and `%`
// truncate. The other rounding modes are methods.

impl Nat {
    /// The greatest common divisor; `0.gcd(0)` is `0`.
    pub fn gcd(self: Self, other: Self) -> Nat {
        core::intrinsic::bigint::gcdi(self, other)
    }

    /// `self` to the power `exp`; anything to the power `0` is `1`.
    pub fn pow(self: Self, exp: u64) -> Self {
        core::intrinsic::bigint::ipowi(self, exp)
    }

    /// The base-2 logarithm, rounded down; `0` for zero.
    pub fn log2(self: Self) -> u64 {
        core::intrinsic::bigint::log2i(self)
    }

    /// Whether bit `i` (counted from the least significant) is set.
    pub fn test_bit(self: Self, i: u64) -> bool {
        core::intrinsic::bigint::testbiti(self, i)
    }

    /// `self / d` for a `d` known to divide `self`, faster than `/`. If `d`
    /// does not divide `self`, the result is unspecified; a zero `d`
    /// terminates the program.
    pub fn div_exact(self: Self, d: Self) -> Self {
        core::intrinsic::bigint::divsi_exact(self, d)
    }

    /// The low 64 bits, and whether `self` does not fit a `u64`.
    pub fn overflowing_to_u64(self: Self) -> (u64, bool) {
        core::intrinsic::bigint::trunci_overflow(self)
    }

    /// The low 64 bits as an `i64`, and whether `self` does not fit an `i64`.
    pub fn overflowing_to_i64(self: Self) -> (i64, bool) {
        core::intrinsic::bigint::trunci_overflow(self)
    }

    /// The nearest `f64`, ties to even; beyond the largest finite value,
    /// infinity.
    pub fn to_f64(self: Self) -> f64 {
        core::intrinsic::bigint::sitofp(self)
    }
}

impl Int {
    /// The greatest common divisor of the magnitudes; `0.gcd(0)` is `0`.
    pub fn gcd(self: Self, other: Self) -> Nat {
        core::intrinsic::bigint::gcdi(self, other)
    }

    /// `self` to the power `exp`; anything to the power `0` is `1`.
    pub fn pow(self: Self, exp: u64) -> Self {
        core::intrinsic::bigint::ipowi(self, exp)
    }

    /// Whether bit `i` (counted from the least significant) of the infinite
    /// two's complement is set: past the magnitude, bits are clear for a
    /// nonnegative integer and set for a negative one.
    pub fn test_bit(self: Self, i: u64) -> bool {
        core::intrinsic::bigint::testbiti(self, i)
    }

    /// `self / d` for a `d` known to divide `self`, faster than `/`. If `d`
    /// does not divide `self`, the result is unspecified; a zero `d`
    /// terminates the program.
    pub fn div_exact(self: Self, d: Self) -> Self {
        core::intrinsic::bigint::divsi_exact(self, d)
    }

    /// The low 64 bits of the two's complement, and whether `self` does not
    /// fit a `u64`.
    pub fn overflowing_to_u64(self: Self) -> (u64, bool) {
        core::intrinsic::bigint::trunci_overflow(self)
    }

    /// The low 64 bits of the two's complement as an `i64`, and whether
    /// `self` does not fit an `i64`.
    pub fn overflowing_to_i64(self: Self) -> (i64, bool) {
        core::intrinsic::bigint::trunci_overflow(self)
    }

    /// The absolute value.
    pub fn abs(self: Self) -> Int {
        core::intrinsic::bigint::absi(self) as Int
    }

    /// The absolute value, as a `Nat`.
    pub fn nat_abs(self: Self) -> Nat {
        core::intrinsic::bigint::absi(self)
    }

    /// `self` as a `Nat`, with negative integers becoming `0`.
    pub fn to_nat(self: Self) -> Nat {
        if self < 0 { 0 } else { core::intrinsic::bigint::absi(self) }
    }

    /// The Euclidean quotient: `self == d * q + r` with `0 <= r < |d|`. A
    /// zero `d` terminates the program.
    pub fn div_euclid(self: Self, d: Self) -> Int {
        core::intrinsic::bigint::edivsi(self, d)
    }

    /// The Euclidean remainder, never negative. A zero `d` terminates the
    /// program.
    pub fn rem_euclid(self: Self, d: Self) -> Int {
        core::intrinsic::bigint::emodsi(self, d)
    }

    /// The quotient rounded toward negative infinity. A zero `d` terminates
    /// the program.
    pub fn div_floor(self: Self, d: Self) -> Int {
        core::intrinsic::bigint::floordivsi(self, d)
    }

    /// The remainder of `div_floor`, with the sign of `d`. A zero `d`
    /// terminates the program.
    pub fn rem_floor(self: Self, d: Self) -> Int {
        core::intrinsic::bigint::floormodsi(self, d)
    }

    /// The nearest `f64`, ties to even; beyond the largest finite value, an
    /// infinity of the same sign.
    pub fn to_f64(self: Self) -> f64 {
        core::intrinsic::bigint::sitofp(self)
    }

    /// `value` truncated toward zero. A NaN or an infinity terminates the
    /// program.
    pub fn from_f64(value: f64) -> Int {
        core::intrinsic::bigint::fptosi(value)
    }
}
