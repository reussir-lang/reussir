// REQUIRES: asan
// UNSUPPORTED: windows
// RUN: %reussir-llvm-opt -passes='coro-early,cgscc(coro-split),coro-cleanup,reussir-retcon-drop-abi,default<O1>' %S/../../runtime/dtor_executor.ll -o %t.ll
// RUN: %cc %asan_flags -c -x ir %t.ll -o %t.o
// RUN: %cc %asan_flags %S/../../runtime/Inputs/dtor_executor.c %t.o %reussir_rt_asan -o %t.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.exe
