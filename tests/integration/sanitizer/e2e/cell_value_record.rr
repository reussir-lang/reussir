// REQUIRES: asan
// Check Cell<ValueRecord> ownership with instrumented generated code.

// RUN: %rrc %S/../../frontend/cell_value_record.rr -o %t.none.ll -t llvm-ir --relocation-mode pic -Onone --sanitizer address --nullary-variant-encoding arch-independent
// RUN: %cc %asan_flags -c -x ir %t.none.ll -o %t.none.o
// RUN: %cc %asan_flags %t.none.o %S/../../frontend/cell_value_record.c %reussir_rt_asan -o %t.none.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.none.exe

// RUN: %rrc %S/../../frontend/cell_value_record.rr -o %t.default.ll -t llvm-ir --relocation-mode pic -Odefault --sanitizer address --nullary-variant-encoding arch-independent
// RUN: %cc %asan_flags -c -x ir %t.default.ll -o %t.default.o
// RUN: %cc %asan_flags %t.default.o %S/../../frontend/cell_value_record.c %reussir_rt_asan -o %t.default.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.default.exe

// RUN: %rrc %S/../../frontend/cell_value_record.rr -o %t.aggr.ll -t llvm-ir --relocation-mode pic -Oaggressive --reuse-across-call --sanitizer address --nullary-variant-encoding arch-independent
// RUN: %cc %asan_flags -c -x ir %t.aggr.ll -o %t.aggr.o
// RUN: %cc %asan_flags %t.aggr.o %S/../../frontend/cell_value_record.c %reussir_rt_asan -o %t.aggr.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.aggr.exe
