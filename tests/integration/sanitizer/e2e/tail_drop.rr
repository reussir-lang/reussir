// REQUIRES: asan
// UNSUPPORTED: windows
// RUN: %rrc %S/../../frontend/tail_drop.rr -o %t.ll -t llvm-ir --relocation-mode pic -Onone --sanitizer address --nullary-variant-encoding arch-independent
// RUN: %cc %asan_flags -c -x ir %t.ll -o %t.o
// RUN: %cc %asan_flags %t.o %S/../../frontend/tail_drop.c %reussir_rt_asan -o %t.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.exe
// RUN: %rrc %S/../../frontend/tail_drop.rr -o %t.opt.ll -t llvm-ir --relocation-mode pic -Oaggressive --sanitizer address --nullary-variant-encoding boxed
// RUN: %cc %asan_flags -c -x ir %t.opt.ll -o %t.opt.o
// RUN: %cc %asan_flags %t.opt.o %S/../../frontend/tail_drop.c %reussir_rt_asan -o %t.opt.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.opt.exe
