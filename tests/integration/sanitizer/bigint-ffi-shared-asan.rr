// UNSUPPORTED: darwin
// REQUIRES: asan, rcgmp
// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %rrc %S/../frontend/bigint_ffi_shared.rr --package-name bigintffishared --extern core=%t.core.rri -o %t.ll -t llvm-ir --relocation-mode pic --sanitizer address --nullary-variant-encoding arch-independent
// RUN: %cc %asan_flags -c -x ir %t.ll -o %t.o
// RUN: %cc %asan_flags %t.o %S/../frontend/bigint_ffi_shared.c %reussir_rt_asan %rcgmp_runtime -o %t.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.exe
// RUN: %rrc %S/../frontend/bigint_ffi_shared.rr --package-name bigintffishared --extern core=%t.core.rri -o %t.inline.ll -t llvm-ir --relocation-mode pic --sanitizer address --nullary-variant-encoding arch-independent -Oaggressive --target-cpu generic --target-features=
// RUN: %cc %asan_flags -c -x ir %t.inline.ll -o %t.inline.o
// RUN: %cc %asan_flags %t.inline.o %S/../frontend/bigint_ffi_shared.c %reussir_rt_asan %rcgmp_runtime -o %t.inline.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.inline.exe

// The sanitized allocator backs every heap integer: asking a count reads only
// live heap integers, never an immediate, and changes none.
