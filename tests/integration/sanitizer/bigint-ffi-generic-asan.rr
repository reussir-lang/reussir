// UNSUPPORTED: darwin
// REQUIRES: asan, rcgmp
// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %rrc %S/../frontend/bigint_ffi_generic.rr --package-name bigintffigeneric --extern core=%t.core.rri -o %t.ll -t llvm-ir --relocation-mode pic --sanitizer address --nullary-variant-encoding arch-independent
// RUN: %cc %asan_flags -c -x ir %t.ll -o %t.o
// RUN: %cc %asan_flags %t.o %S/../frontend/bigint_ffi_generic.c %reussir_rt_asan %rcgmp_runtime -o %t.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.exe
// With the textures' generic target the rcgmp glue inlines into them at -O.
// RUN: %rrc %S/../frontend/bigint_ffi_generic.rr --package-name bigintffigeneric --extern core=%t.core.rri -o %t.inline.ll -t llvm-ir --relocation-mode pic --sanitizer address --nullary-variant-encoding arch-independent -Oaggressive --target-cpu generic --target-features=
// RUN: %cc %asan_flags -c -x ir %t.inline.ll -o %t.inline.o
// RUN: %cc %asan_flags %t.inline.o %S/../frontend/bigint_ffi_generic.c %reussir_rt_asan %rcgmp_runtime -o %t.inline.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.inline.exe
// RUN: %rrc %S/../frontend/bigint_ffi_glue.rr --package-name bigintffiglue --extern core=%t.core.rri -o %t.glue.ll -t llvm-ir --relocation-mode pic --sanitizer address --nullary-variant-encoding arch-independent -Oaggressive --target-cpu generic --target-features=
// RUN: %cc %asan_flags -c -x ir %t.glue.ll -o %t.glue.o
// RUN: %cc %asan_flags %t.glue.o %S/../frontend/bigint_ffi_glue.c %reussir_rt_asan %rcgmp_runtime -o %t.glue.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.glue.exe

// The sanitized allocator backs every heap integer, so a handle a Rust
// container keeps after its wrapper released it is a use after free, a
// handle released by both sides a double free, and one neither releases a
// leak.
