// REQUIRES: asan, rcgmp
// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %rrc %S/../frontend/bigint_ffi.rr --package-name bigintffi --extern core=%t.core.rri -o %t.ll -t llvm-ir --relocation-mode pic --sanitizer address --nullary-variant-encoding arch-independent
// RUN: %cc %asan_flags -c -x ir %t.ll -o %t.o
// RUN: %cc %asan_flags %t.o %S/../frontend/bigint_ffi.c %reussir_rt_asan %rcgmp_runtime -o %t.exe %rpath_flag %rpath_san_flag %extra_sys_libs
// RUN: %asan_env %t.exe

// The sanitized allocator backs every heap integer, so a handle the FFI
// wrapper forgot to release leaks, and one released twice is a double free.
