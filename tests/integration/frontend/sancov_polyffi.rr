// RUN: %rrc %s --package-name scope --emit llvm-ir --fuzzer --sancov-include scope::foreign -o %t.ll
// RUN: %FileCheck %s < %t.ll
// The Rust texture inherits its Reussir import's lexical scope.
// CHECK: call void @__sanitizer_cov_trace_const_cmp8(i64 12345,

#[ffi(import)]
pub fn foreign(x: i64) -> i64 [{
    if r#x == 12345 { r#x * 7 } else { r#x + 9 }
}];

pub fn drive(x: i64) -> i64 { foreign(x) }
extern "C" trampoline "scope_foreign" = drive;
