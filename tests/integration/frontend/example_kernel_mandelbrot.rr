// A million independent orbits, computed by one 128-step device loop.
// Optional harness argument: write the verified image to a binary PGM file.
// REQUIRES: linux, openxla, pjrt-runtime
// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %rrc %s --package-name mandelbrot --extern core=%t.core.rri --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.round.mir
// RUN: diff %t.mir %t.round.mir
// RUN: %rrc %s --package-name mandelbrot --extern core=%t.core.rri -Oaggressive --relocation-mode pic -o %t.o
// RUN: %cc %t.o %S/example_kernel_mandelbrot.c -o %t.exe %pjrt_runtime %extra_sys_libs
// RUN: env XDG_CACHE_HOME="%t.cache" LD_LIBRARY_PATH="%pjrt_runtime_dir:$LD_LIBRARY_PATH" %t.exe
// RUN: rm -rf %t.cache
import core::intrinsic::array;
import core::intrinsic::pjrt;
import core::intrinsic::tensor;

#[placement(devices = "0", layout = "default")]
#[launch(backend_optimization_level = "2", donation = "none")]
struct [value] MandelbrotConfig {}

#[kernel]
fn escape_times(limit: i64) -> Tensor<[i32; 1024, 1024]> {
    let column = tensor::iota(1);
    let row = tensor::iota(0);
    let pixel_scale: f32 = 3.0 / 1024.0;
    let scale = tensor::fill(pixel_scale);
    let left = tensor::fill(2.0);
    let half_height = tensor::fill(1.5);
    let real = column * scale - left;
    let imaginary = row * scale - half_height;
    let zero = tensor::fill(0.0);
    let two = tensor::fill(2.0);
    let four = tensor::fill(4.0);
    let counts = tensor::fill(0);
    let one = tensor::fill(1);
    let active = tensor::fill(true);
    let (step, zr, zi, live, result) = while [step = 0, zr = zero, zi = zero, live = active, result = counts] (step < limit) {
        let nr = zr * zr - zi * zi + real;
        let ni = two * zr * zi + imaginary;
        // Bool multiplication is conjunction. Once escaped, an orbit stays
        // inactive and its previous bounded coordinates are retained. Merely
        // masking its count while iterating z would eventually create NaNs.
        let next_live = live * (nr * nr + ni * ni <= four);
        let next_count = tensor::select(live, result + one, result);
        (step + 1, tensor::select(next_live, nr, zr), tensor::select(next_live, ni, zi), next_live, next_count)
    };
    result
}

// Ordinary FFI import: the compiler owns the Rust/C boundary wrapper, and the
// harness receives scalar values instead of knowing the runtime array layout.
#[ffi(import)]
fn emit_pixel(index: u64, value: i32) [{
    unsafe extern "C" { fn mandelbrot_pixel(index: u64, value: i32); }
    unsafe { mandelbrot_pixel(index, value); }
}];

pub fn render_mandelbrot() -> u64 {
    let iterations: i64 = 128;
    let limit = pjrt::upload(iterations);
    let pixels = pjrt::launch<MandelbrotConfig>(escape_times, limit).download();
    let start: u64 = 0;
    array::fold(pixels, start, |index: u64, value: i32| {
        emit_pixel(index, value);
        index + 1
    })
}
extern "C" trampoline "render_mandelbrot" = render_mandelbrot;
