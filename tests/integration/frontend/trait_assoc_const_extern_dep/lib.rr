// The dependency behind trait_assoc_const_extern.rr: a pub trait with a
// scalar and two `ConstSeq` associated consts, an impl giving their values,
// and pub generics reading them through a bound.

pub trait Arity {
    const ARITY: i64;
    const SLOTS: ConstSeq<u64>;
    const OFFSETS: ConstSeq<i32>;
}

pub struct Pair {
    pub a: i64,
    pub b: i64,
}

impl Arity for Pair {
    const ARITY: i64 = 2;
    const SLOTS: ConstSeq<u64> = [0, 1];
    const OFFSETS: ConstSeq<i32> = [-2147483648, 2147483647];
}

pub fn arity_of<T: Arity>(x: T) -> i64 {
    T::ARITY
}

pub fn offsets_of<T: Arity>(x: T) -> ConstSeq<i32> {
    T::OFFSETS
}
