// Associated types: a trait declares `type Name;`, optionally with a
// default, and an impl binds it. `Self::Name` names one inside the trait and
// its impls, `T::Name` through a bounded type parameter. The HIR keeps
// `T::Name` as a type of its own; monomorphization replaces it by the type
// the selected impl binds, so MIR mentions none.

// RUN: %rrc %s --emit hir --no-source-locations -o %t.a.hir
// RUN: %rrc %t.a.hir --emit hir --no-source-locations -o %t.b.hir
// RUN: diff %t.a.hir %t.b.hir
// RUN: %FileCheck %s --check-prefix=HIR --input-file=%t.a.hir
// RUN: %rrc %s --emit mir --no-source-locations -o %t.direct.mir
// RUN: %rrc %t.a.hir --emit mir --no-source-locations -o %t.via.mir
// RUN: diff %t.direct.mir %t.via.mir
// RUN: %FileCheck %s --check-prefix=MIR --input-file=%t.direct.mir
// RUN: %rrc %s -o %t.o --relocation-mode pic
// RUN: %cc %t.o %S/trait_assoc_type.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe

// MIR-NOT: trait#

// HIR: pub [shared] struct #Pending<[[P:\$[0-9]+]] (T): Shift> { "value": [[P]], "by": trait#Shift::<[[P]]>#Amount };
// HIR: pub trait #Shift<[[SELF:\$[0-9]+]] (Self)> {
// HIR-NEXT: type Amount = [[SELF]];
// HIR-NEXT: type Wide = trait#Shift::<[[SELF]]>#Amount;
// HIR-NEXT: fn shl ([[SELF]], trait#Shift::<[[SELF]]>#Amount) -> [[SELF]];
// HIR-NEXT: fn widen ([[SELF]]) -> trait#Shift::<[[SELF]]>#Wide;
pub trait Shift {
    type Amount = Self;
    type Wide = Self::Amount;
    fn shl(self: Self, amount: Self::Amount) -> Self;
    fn widen(self: Self) -> Self::Wide;
}

pub trait Rotate: Shift {
    fn rot(self: Self) -> Self;
}

pub struct Big { v: i64 }
pub struct Wrap<T> { inner: T }
pub struct Pending<T: Shift> { value: T, by: T::Amount }

// Both defaults apply: `Amount` and `Wide` are `i32`.
// HIR-DAG: impl #Shift::<i32> { #Shift::i32::shl, #Shift::i32::widen }
impl Shift for i32 {
    fn shl(self: i32, amount: i32) -> i32 { self << amount }
    fn widen(self: i32) -> i32 { self }
}

// `Wide` defaults to the `Amount` this impl binds.
// HIR-DAG: impl #Shift::<#Big> { type Amount = i64; #Shift::Big::shl, #Shift::Big::widen }
// HIR-DAG: pub fn #Shift::Big::shl(v0 (self): #Big, v1 (amount): i64) -> #Big {
// HIR-DAG: pub fn #Shift::Big::widen(v0 (self): #Big) -> i64 {
impl Shift for Big {
    type Amount = i64;
    fn shl(self: Big, amount: Self::Amount) -> Big {
        let by: Self::Amount = amount;
        Big { v: self.v << by }
    }
    fn widen(self: Big) -> Self::Wide { self.v }
}

impl Rotate for Big {
    fn rot(self: Big) -> Big { Big { v: self.v + 1 } }
}

// A generic impl may bind a type to its parameter's associated type.
// HIR-DAG: impl<[[W:\$[0-9]+]]: Shift> #Shift::<#Wrap::<[[W]]>> { type Amount = trait#Shift::<[[W]]>#Amount; type Wide = [[W]]; #Shift::Wrap::shl, #Shift::Wrap::widen }
impl<T: Shift> Shift for Wrap<T> {
    type Amount = T::Amount;
    type Wide = T;
    fn shl(self: Wrap<T>, amount: T::Amount) -> Wrap<T> { Wrap { inner: self.inner.shl(amount) } }
    fn widen(self: Wrap<T>) -> T { self.inner }
}

// HIR-DAG: fn #shift<[[T:\$[0-9]+]] (T): Shift>(v0 (a): [[T]], v1 (n): trait#Shift::<[[T]]>#Amount) -> [[T]] {
// MIR-DAG: fn @{{.*}}5shift{{.*}}(v0 (a): i32, v1 (n): i32) -> i32 {
// MIR-DAG: fn @{{.*}}5shift{{.*}}(v0 (a): #Big, v1 (n): i64) -> #Big {
fn shift<T: Shift>(a: T, n: T::Amount) -> T { a.shl(n) }

// The amount is checked before the implementing type is known.
// MIR-DAG: fn @{{.*}}9shift_rev{{.*}}(v0 (n): i64, v1 (a): #Big) -> #Big {
fn shift_rev<T: Shift>(n: T::Amount, a: T) -> T { a.shl(n) }

// `Amount` is declared by a supertrait of the bound.
fn through_super<T: Rotate>(a: T, n: T::Amount) -> T { a.rot().shl(n) }

// MIR-DAG: fn @{{.*}}3run{{.*}}(v0 (p): #Pending::<#Wrap::<#Big>>) -> #Wrap::<#Big> {
fn run<T: Shift>(p: Pending<T>) -> T { p.value.shl(p.by) }

// MIR-DAG: fn @{{.*}}4wide{{.*}}(v0 (a): #Wrap::<#Big>) -> #Big {
fn wide<T: Shift>(a: T) -> T::Wide { a.widen() }

fn keep<T: Shift>(a: T, n: T::Amount) -> T::Amount {
    let m: T::Amount = n;
    m
}

pub fn checksum() -> i64 {
    let three: i32 = 3;
    let a = shift(three, 2);
    let b = shift(Big { v: 5 }, 1);
    let c = shift_rev(2, Big { v: 1 });
    let d = through_super(Big { v: 1 }, 3);
    let e = run(Pending { value: Wrap { inner: Big { v: 1 } }, by: 5 });
    let f = wide(Big { v: 7 }) + wide(Wrap { inner: Big { v: 9 } }).v;
    let g = keep(Big { v: 0 }, 11);
    let h = wide(three).shl(1);
    (a as i64) + b.v + c.v + d.v + e.inner.v + f + g + (h as i64)
}

extern "C" trampoline "reussir_assoc_type_checksum" = checksum;
