// A record application whose argument lacks the record's declared bound is
// rejected where the type is written, before a comparison bridge is
// synthesized for it.

// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %not %rrc %s --package-name cmpbridge_error --extern core=%t.core.rri --emit mir -o - 2>&1 | %FileCheck %s

#[ffi(rust = "::reussir_rt::collections::btree_set::BTreeSet")]
pub struct BTreeSet<T: Ord>;

pub struct Key { value: i64 }

#[ffi(import)]
pub fn empty<T>() -> BTreeSet<T> [{
    ::reussir_rt::collections::btree_set::BTreeSet::new()
}];

pub fn main() -> BTreeSet<Key> { empty<Key>() }

// CHECK-DAG: `cmpbridge_error::BTreeSet<T>` is ill-formed: `T` does not implement `core::cmp::Ord`
// CHECK-DAG: `cmpbridge_error::BTreeSet<cmpbridge_error::Key>` is ill-formed: `cmpbridge_error::Key` does not implement `core::cmp::Ord`
// CHECK-NOT: OrdBridge is not implemented
