// RUN: %not %rrc %s --emit hir -o - 2>&1 | %FileCheck %s
// CHECK-DAG: `Future` takes one or more tensor type arguments
// CHECK-DAG: `Future` payload must be a Tensor type
// CHECK-DAG: `Token` takes no type arguments
// CHECK-DAG: a record member cannot contain a kernel value
// CHECK-DAG: a kernel value cannot appear in a function signature
// CHECK-DAG: closure cannot capture `t`
// CHECK-DAG: closure cannot return a kernel value
pub struct Bad { f: Future<Tensor<f32>> }
pub fn signature(t: Token) -> Token { t }
pub fn bad() {
    let empty: Future = core::intrinsic::panic::panic();
    let scalar: Future<f32> = core::intrinsic::panic::panic();
    let nested: Future<Future<Tensor<f32>>> = core::intrinsic::panic::panic();
    let token_payload: Future<Token> = core::intrinsic::panic::panic();
    let bad_token: Token<i32> = core::intrinsic::panic::panic();
    let t: Token = core::intrinsic::panic::panic();
    let closure = || t;
}

// CHECK-DAG: a cell cannot contain a scope-confined kernel value
// CHECK-DAG: `Nullable` inner type
pub fn wrappers() {
    let c: Cell<Token> = core::intrinsic::panic::panic();
    let n: Nullable<Future<Tensor<f32>>> = core::intrinsic::panic::panic();
}
