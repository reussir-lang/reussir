// REQUIRES: openxla
// Source, generic specialization, and both textual IR replay paths retain kernel lowering.
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %s --emit mlir -o %t.mlir
// RUN: %rrc %t.mir --emit mlir -o %t.replay.mlir
// RUN: %reussir-opt %t.mlir | %FileCheck %s
// RUN: %reussir-opt %t.replay.mlir | %FileCheck %s
// CHECK: func.func
// CHECK-SAME: tensor<i1>
// CHECK-SAME: reussir.kernel_function
// CHECK: stablehlo.if
// CHECK: stablehlo.return
// CHECK: stablehlo.return
// CHECK-NOT: scf.if
// CHECK-NOT: arith.
#[kernel]
pub fn choose(c: bool, x: Tensor<f32>, y: Tensor<f32>) -> Tensor<f32> {
    if c { x } else { y }
}
