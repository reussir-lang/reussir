// RUN: %rrc %s --emit mir --no-source-locations -o %t.mir
// RUN: %FileCheck %s < %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.rt.mir
// RUN: diff %t.mir %t.rt.mir
// RUN: %rrc %s --emit mlir --no-source-locations -o %t.mlir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.rt.mlir
// RUN: diff %t.mlir %t.rt.mlir

// Records may take the names the MIR text uses for builtin types.

pub struct [value] Ptr { x: i64 }
pub struct [value] GenericAddrSpace { x: i64 }
pub struct [value] Tensor<T> { x: T }
pub struct [value] Token { x: i64 }

// CHECK-DAG: pub fn @{{.*}}(v0 (p): #Ptr) -> i64
pub fn a(p: Ptr) -> i64 { p.x }
// CHECK-DAG: pub fn @{{.*}}(v0 (p): #GenericAddrSpace) -> i64
pub fn b(p: GenericAddrSpace) -> i64 { p.x }
// CHECK-DAG: pub fn @{{.*}}(v0 (p): #Tensor::<i64>) -> i64
pub fn c(p: Tensor<i64>) -> i64 { p.x }
// CHECK-DAG: pub fn @{{.*}}(v0 (p): #Token) -> i64
pub fn d(p: Token) -> i64 { p.x }
