// Fibonacci with mandatory shipping paperwork. Every department approves the
// same addition while a parcel travels asynchronously back to the same device.
// REQUIRES: linux, ifrt, pjrt-runtime
// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --core --emit rri -o %t.core.rri
// RUN: %rrc %s --package-name bureaucracy --extern core=%t.core.rri --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --extern core=%t.core.rri --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.round.mir
// RUN: diff %t.mir %t.round.mir
// RUN: %rrc %s --package-name bureaucracy --extern core=%t.core.rri -Onone --relocation-mode pic -o %t.o
// RUN: %cc %t.o %S/example_kernel_bureaucracy.c -o %t.exe %pjrt_runtime %extra_sys_libs
// RUN: env XDG_CACHE_HOME="%t.cache" LD_LIBRARY_PATH="%pjrt_runtime_dir:$LD_LIBRARY_PATH" %t.exe
// RUN: %rrc %t.mir -Oaggressive --relocation-mode pic -o %t.opt.o
// RUN: %cc %t.opt.o %S/example_kernel_bureaucracy.c -o %t.opt.exe %pjrt_runtime %extra_sys_libs
// RUN: env XDG_CACHE_HOME="%t.cache" LD_LIBRARY_PATH="%pjrt_runtime_dir:$LD_LIBRARY_PATH" %t.opt.exe
// RUN: rm -rf %t.cache
import core::intrinsic::tensor;
import core::intrinsic::pjrt;

#[kernel]
fn paperwork(n: i64, parcel: Tensor<i64>) -> Tensor<i64> {
    let (i, a, b, delivered) = while [i = 0, a = 0, b = 1, cargo = parcel] (i < n) {
        let pending = async { tensor::collective_permute(cargo, ((0, 0),)) };
        let next = match i % 3 {
            0 => a + b,
            1 => if a > b { a + b } else { b + a },
            _ => b + a
        };
        (i + 1, b, next, pending.done())
    };
    tensor::fill<Tensor<i64>>(a) + delivered
}

pub fn bureaucracy(n: i64, stamp: i64) -> i64 {
    let parcel = pjrt::upload(stamp);
    let rounds = pjrt::upload(n);
    let result = launch(paperwork, rounds, parcel);
    // Retain and read the original input after the launch: donation must not
    // invalidate a shared parcel. Remove its stamp from the returned checksum.
    result.download() - parcel.download()
}
extern "C" trampoline "bureaucracy" = bureaucracy;
