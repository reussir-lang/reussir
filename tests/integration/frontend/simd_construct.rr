// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %rrc %s --emit mlir --no-source-locations -o %t.mlir
// RUN: %FileCheck %s < %t.mlir
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %FileCheck %s --check-prefix=HIR < %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.rt.mlir
// RUN: diff %t.mlir %t.rt.mlir
// RUN: %rrc %s --emit llvm-ir -O aggressive -o %t.ll
// RUN: %FileCheck %s --check-prefix=LLVM < %t.ll
// RUN: %rrc %S/Inputs/simd_construct_scalable.rr --target-triple aarch64-unknown-linux-gnu --target-features=+sve --emit llvm-ir -O aggressive -o %t.sve.ll
// RUN: %FileCheck %S/Inputs/simd_construct_scalable.rr < %t.sve.ll
// RUN: %not %rrc %S/Inputs/simd_construct_errors.rr --emit hir -o - 2>&1 | %FileCheck %S/Inputs/simd_construct_errors.rr --check-prefix=ERR

import core::simd;

// HIR-DAG: intrinsic#simd#extract#0(v0 : Simd<[f32; 4, 8]>, 2 : u64, v1 : u64) : f32
// CHECK-LABEL: func.func @{{.*}}at
// CHECK: %[[J:.*]] = arith.index_castui %arg1 : i64 to index
// CHECK: vector.extract %arg0[2, %[[J]]] : f32 from vector<4x8xf32>
pub fn at(m: Simd<[f32; 4, 8]>, j: u64) -> f32 { simd::extract(m, 2, j) }

// A sub-vector is selected by fewer indices than dimensions.
// HIR-DAG: intrinsic#simd#extract#0(v0 : Simd<[f32; 4, 8]>, 3 : u64) : Simd<[f32; 8]>
// CHECK-LABEL: func.func @{{.*}}row
// CHECK: vector.extract %arg0[3] : vector<8xf32> from vector<4x8xf32>
pub fn row(m: Simd<[f32; 4, 8]>) -> Simd<[f32; 8]> { simd::extract(m, 3) }

// HIR-DAG: intrinsic#simd#from_elements#0(v0 : u8, 2 : u8, v0 : u8, 4 : u8) : Simd<[u8; 2, 2]>
// CHECK-LABEL: func.func @{{.*}}grid
// CHECK: vector.from_elements %arg0, %{{.*}}, %arg0, %{{.*}} : vector<2x2xi8>
pub fn grid(x: u8) -> Simd<[u8; 2, 2]> { simd::from_elements<Simd<[u8; 2, 2]>>(x, 2, x, 4) }

// HIR-DAG: intrinsic#simd#step#0() : Simd<[u32; 8]>
// CHECK-LABEL: func.func @{{.*}}ramp
// CHECK: vector.step : vector<8xi32>
// LLVM-LABEL: define {{.*}}<8 x i32> @{{.*}}ramp
// LLVM: call <8 x i32> @llvm.stepvector.v8i32()
pub fn ramp() -> Simd<[u32; 8]> { simd::step<Simd<[u32; 8]>>() }

// `lanes` of a fixed vector is a constant.
// HIR-DAG: fn #count() -> u64
// CHECK-LABEL: func.func @{{.*}}count
// LLVM-LABEL: define {{.*}}i64 @{{.*}}count
// LLVM: ret i64 32
pub fn count() -> u64 { simd::lanes<Simd<[f32; 4, 8]>>() }

// HIR-DAG: intrinsic#simd#splat#0(v0 : f32) : Simd<[f32; 4]>
// CHECK-LABEL: func.func @{{.*}}filled
// CHECK: vector.broadcast %arg0 : f32 to vector<4xf32>
pub fn filled(x: f32) -> Simd<[f32; 4]> { simd::splat<Simd<[f32; 4]>>(x) }

// HIR-DAG: intrinsic#simd#insert#0(v0 : Simd<[f32; 4, 8]>, v1 : Simd<[f32; 8]>, 1 : u64) : Simd<[f32; 4, 8]>
// CHECK-LABEL: func.func @{{.*}}replace
// CHECK: vector.insert %arg1, %arg0 [1] : vector<8xf32> into vector<4x8xf32>
pub fn replace(m: Simd<[f32; 4, 8]>, r: Simd<[f32; 8]>) -> Simd<[f32; 4, 8]> { simd::insert(m, r, 1) }
