// An integer literal on the left of a shift takes its type from the
// surrounding expression, and the amount is then checked against that
// type's `Amount`.

// RUN: %rrc %s --emit hir --no-source-locations -o - | %FileCheck %s

// CHECK-LABEL: fn #added
// CHECK: (1 : i64 << v0 : i64) : i64 + v1 : i64
pub fn added(n: i64, x: i64) -> bool { (1 << n) + x > 100 }

// CHECK-LABEL: fn #returned
// CHECK: (1 : i64 << v0 : i64) : i64
pub fn returned(n: i64) -> i64 { 1 << n }

fn takes(m: u64) -> u64 { m }

// CHECK-LABEL: fn #passed
// CHECK: (1 : u64 << v0 : u64) : u64
pub fn passed(n: u64) -> u64 { takes(1 << n) }

// CHECK-LABEL: fn #later
// CHECK: (1 : i64 << v0 : i64) : i64
pub fn later(n: i64, x: i64) -> bool {
    let v = 1 << n;
    let w = v;
    let z = w + 1;
    z == x
}
