// RUN: %rrc %s --emit obj --relocation-mode pic -O none -o %t.o
// RUN: %cc %t.o %S/dynamic_array_e2e.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe
// RUN: %rrc %s --emit obj --relocation-mode pic -O aggressive -o %t.opt.o
// RUN: %cc %t.opt.o %S/dynamic_array_e2e.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.opt.exe

import core::intrinsic::array;
struct Box { value:i64 }

fn sum(a:[Box;?], n:u64, i:u64)->i64 {
    if i == n { 0 } else { array::get(a, i as i64).value + sum(a,n,i+1) }
}

pub fn managed(n:u64) -> i64 {
    let a = array::splat<[Box; ?]>(n, Box { value:7 });
    let b = array::tabulate<[i64; ?]>(n, |i:i64| i);
    if n == 0 { sum(a,n,0) }
    else {
        let c = array::set(a, 0, Box { value:9 });
        sum(a,n,0)
            + sum(c,n,0)
            + array::fold(b, 0, |s:i64, x:i64| s+x)
            + array::get(c, 0).value
    }
}
extern "C" trampoline "managed" = managed;
