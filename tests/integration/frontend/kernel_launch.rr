// REQUIRES: ifrt
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit hir --no-source-locations -o %t.hir.round
// RUN: diff %t.hir %t.hir.round
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.mir.round
// RUN: diff %t.mir %t.mir.round
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.mlir
// RUN: %FileCheck %s < %t.mlir
// RUN: %FileCheck %s --check-prefix=CALL < %t.mlir
// RUN: %FileCheck %s --check-prefix=VIEWS < %t.mlir
// RUN: %reussir-opt %t.mlir --reussir-prepare-pjrt -o %t.prepared
// RUN: %FileCheck %s --check-prefix=PREP < %t.prepared
// RUN: %FileCheck %s --check-prefix=CONSTANT < %t.prepared
// RUN: %rrc %t.mir --emit mlir-llvm -O aggressive -o %t.llvm
// RUN: %rrc %t.mir --emit mlir-llvm -O none -o %t.none.llvm

#[placement(devices = "0")]
#[launch(backend_optimization_level = "2", donation = "none")]
pub struct [value] Config {}
#[kernel] fn identity<T>(x: Tensor<T>) -> Tensor<T> { x }
#[kernel] fn choose<T>(x: (Tensor<T>, ((), bool))) -> Tensor<T> {
    if x.1.1 { identity(x.0) } else { x.0 }
}
pub fn run<T>(x: DevArray<T>, condition: DevArray<bool>) -> DevArray<T, Config> {
    core::intrinsic::pjrt::launch<Config>(choose<T>, (x, ((), condition)))
}
pub fn unsigned(x: DevArray<u64>, condition: DevArray<bool>) -> DevArray<u64, Config> {
    run(x, condition)
}
pub fn default(x: DevArray<f32>) -> DevArray<f32> { core::intrinsic::pjrt::launch(identity, x) }
pub fn reuse(x: DevArray<f32>) -> (DevArray<f32>, DevArray<f32>) {
    (core::intrinsic::pjrt::launch(identity, x), core::intrinsic::pjrt::launch(identity, x))
}
pub fn launch_closure(x: DevArray<f32>) -> DevArray<f32> {
    let f = |a: DevArray<f32>| core::intrinsic::pjrt::launch(identity, a);
    f(x)
}
// Constant positions count kernel parameters; the tuple flattens into two inputs.
#[placement(devices = "0")]
#[launch(constants = "1")]
pub struct [value] Sized {}
#[kernel] fn ramp(x: (Tensor<f32>, Tensor<f32>), n: i64) -> Tensor<[i64; ?]> {
    core::intrinsic::tensor::dynamic_iota((n,), 0)
}
pub fn sized(x: DevArray<f32>, n: DevArray<i64>) -> DevArray<[i64; ?], Sized> {
    core::intrinsic::pjrt::launch<Sized>(ramp, (x, x), n)
}
// Arguments that build host data in place: views are created at the call.
#[kernel] fn add(x: Tensor<[i64; 4]>, y: Tensor<[i64; 4]>) -> Tensor<[i64; 4]> { x + y }
pub fn filled(a: i64, b: i64) -> DevArray<[i64; 4]> {
    core::intrinsic::pjrt::launch(
        add,
        core::intrinsic::pjrt::alloc<DevArray<[i64; 4]>>(a),
        core::intrinsic::pjrt::alloc<DevArray<[i64; 4]>>(b),
    )
}
// VIEWS-LABEL: func.func {{.*}}filled
// VIEWS: reussir.array.to_device
// VIEWS: reussir.array.to_device
// VIEWS-NEXT: reussir.rc.dec
// VIEWS-NEXT: reussir.array.to_ifrt
// VIEWS-NEXT: reussir.array.to_ifrt
// VIEWS-NEXT: ifrt.Call
// CHECK: module @_reussir_launch_
// CHECK: tensor<ui64>
// CHECK: ifrt.Call {{.*}}reussir.backend_optimization_level = 2 : i32
// CHECK-SAME: reussir.disable_donation
// CHECK: reussir.array.from_ifrt
// CALL: ifrt.Call {{.*}}reussir.constant_inputs = array<i32: 2>
// PREP: reussir.pjrt.jit_call
// PREP: reussir.ifrt.bytecode
// PREP-NOT: module @_reussir_launch_
// CONSTANT: reussir.pjrt.jit_call {{.*}}reussir.constant_inputs = array<i32: 2>
