// RUN: %rrc %s -o %t.o --relocation-mode pic -Onone
// RUN: %cc %t.o %S/retcon_drop.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe
// RUN: %rrc %s -o %t.opt.o --relocation-mode pic -Oaggressive
// RUN: %cc %t.opt.o %S/retcon_drop.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.opt.exe
// RUN: %rrc %s -o %t.boxed.o --relocation-mode pic -Onone --nullary-variant-encoding boxed
// RUN: %cc %t.boxed.o %S/retcon_drop.c -o %t.boxed.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.boxed.exe

import core::intrinsic::array;
import core::intrinsic::cell;

pub enum Tree {
    Leaf,
    Branch(Tree, Tree),
    Locked(Mutex<Arc<Tree>>, Tree),
    Combined(FlatLock<Arc<Tree>>, Tree),
    ReadWrite(RwLock<Arc<Tree>>, Tree),
    Value(Arc<Box>)
}
pub enum Forest { End, Branch([Forest; 2]) }
pub struct Box { value: u64 }
pub struct Chain { next: Nullable<Chain>, value: Box }

pub fn leaf() -> Tree { Tree::Leaf }
pub fn value() -> Tree { Tree::Value{Arc<Box>{value: 42}} }
pub fn branch(next: Tree) -> Tree { Tree::Branch{next, value()} }
pub fn shared(next: Tree) -> Tree { Tree::Branch{next, next} }
pub fn consume(tree: Tree) -> u64 { match tree { Tree::Leaf => 0, _ => 1 } }
pub fn atomic_leaf() -> Arc<Tree> { Arc<Tree>::Leaf }
pub fn atomic_branch(next: Arc<Tree>) -> Arc<Tree> { Arc<Tree>::Branch{next, Arc<Tree>::Leaf} }
pub fn mutex(inner: Arc<Tree>, next: Tree) -> Tree { Tree::Locked{cell::alloc<Mutex<Arc<Tree>>>(inner), next} }
pub fn flat(inner: Arc<Tree>, next: Tree) -> Tree { Tree::Combined{cell::alloc<FlatLock<Arc<Tree>>>(inner), next} }
pub fn rw(inner: Arc<Tree>, next: Tree) -> Tree { Tree::ReadWrite{cell::alloc<RwLock<Arc<Tree>>>(inner), next} }
pub fn forest_end() -> Forest { Forest::End }
pub fn forest_branch(next: Forest) -> Forest {
    Forest::Branch{array::set(array::splat<[Forest; 2]>(Forest::End), 0, next)}
}
pub fn forest_consume(forest: Forest) -> u64 { match forest { Forest::End => 0, _ => 1 } }
pub fn chain(next: Nullable<Chain>) -> Nullable<Chain> { Nullable::NonNull{Chain{next: next, value: Box{value: 42}}} }
pub fn chain_consume(next: Nullable<Chain>) -> u64 { match next { Nullable::Null => 0, Nullable::NonNull(n) => n.value.value } }

extern "C" trampoline "retcon_leaf" = leaf;
extern "C" trampoline "retcon_value" = value;
extern "C" trampoline "retcon_branch" = branch;
extern "C" trampoline "retcon_shared" = shared;
extern "C" trampoline "retcon_consume" = consume;
extern "C" trampoline "retcon_atomic_leaf" = atomic_leaf;
extern "C" trampoline "retcon_atomic_branch" = atomic_branch;
extern "C" trampoline "retcon_mutex" = mutex;
extern "C" trampoline "retcon_flat" = flat;
extern "C" trampoline "retcon_rw" = rw;
extern "C" trampoline "retcon_forest_end" = forest_end;
extern "C" trampoline "retcon_forest_branch" = forest_branch;
extern "C" trampoline "retcon_forest_consume" = forest_consume;
extern "C" trampoline "retcon_chain" = chain;
extern "C" trampoline "retcon_chain_consume" = chain_consume;
