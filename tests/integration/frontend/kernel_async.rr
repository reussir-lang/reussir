// REQUIRES: openxla
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit hir --no-source-locations -o %t.round.hir
// RUN: diff %t.hir %t.round.hir
// RUN: %FileCheck %s --check-prefix=HIR < %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.round.mir
// RUN: diff %t.mir %t.round.mir
// RUN: %FileCheck %s --check-prefix=MIR < %t.mir
import core::intrinsic::tensor;
#[kernel]
fn start<T>(x: Tensor<[T; ?, 4]>, indices: (i32, i32)) -> Future<Tensor<[T; 2, 3]>> {
    async { let sliced = tensor::dynamic_slice<Tensor<[T; 2, 3]>>(x, indices); sliced }
}
#[kernel]
pub fn slice(x: Tensor<[f32; ?, 4]>, i: i32, j: i32) -> Tensor<[f32; 2, 3]> {
    tensor::async_done(start(x, (i, j)))
}
#[kernel]
pub fn scalar(x: Tensor<u64>) -> Tensor<u64> {
    tensor::async_done(async { tensor::dynamic_slice<Tensor<u64>>(x, ()) })
}
#[kernel]
pub fn empty(x: Tensor<[i16; 3]>, i: Tensor<i64>) -> Tensor<[i16; 0]> {
    tensor::async_done(async { tensor::dynamic_slice<Tensor<[i16; 0]>>(x, (i,)) })
}
// HIR-DAG: async[
// HIR-DAG: tensor#dynamic_slice
// HIR-DAG: tensor#async_done
// MIR-DAG: async[
// MIR-DAG: tensor#dynamic_slice
// MIR-DAG: tensor#async_done

#[kernel]
pub fn static_slice(x: Tensor<[f32; 8]>) -> Tensor<[f32; 3]> {
    tensor::async_done(async { tensor::slice<Tensor<[f32; 3]>>(x, (2,)) })
}

#[kernel]
pub fn permute(x: Tensor<[f32; 8]>) -> Tensor<[f32; 8]> {
    tensor::async_done(async { tensor::collective_permute(x, ((0, 1), (1, 0))) })
}
#[kernel]
pub fn no_routes(x: Tensor<i32>) -> Tensor<i32> {
    tensor::async_done(async { tensor::collective_permute(x, ()) })
}
