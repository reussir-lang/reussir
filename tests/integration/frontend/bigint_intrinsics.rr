// The `core::intrinsic::bigint` operations lower to the rcgmp operations their
// names spell, and survive the textual MIR.

// REQUIRES: rcgmp
// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %rrc %s --package-name bigint --extern core=%t.core.rri --emit mlir -o - | %FileCheck %s
// RUN: %rrc %s --package-name bigint --extern core=%t.core.rri --emit mir -o %t.mir
// RUN: %FileCheck %s --check-prefix=MIR < %t.mir
// RUN: %rrc %t.mir --emit mlir -o - | %FileCheck %s

pub fn rounding(a : Int, b : Int) -> Int {
    core::intrinsic::bigint::edivsi(a, b) + core::intrinsic::bigint::emodsi(a, b)
        + core::intrinsic::bigint::floordivsi(a, b) + core::intrinsic::bigint::floormodsi(a, b)
}

pub fn arithmetic(a : Nat, b : Nat) -> Nat {
    core::intrinsic::bigint::ipowi(core::intrinsic::bigint::gcdi(a, b), 3)
        + core::intrinsic::bigint::divsi_exact(a, 2) + core::intrinsic::bigint::absi(b)
}

pub fn reading(a : Nat) -> u64 {
    let (low, over) : (u32, bool) = core::intrinsic::bigint::trunci_overflow(a);
    if over || core::intrinsic::bigint::testbiti(a, 7) {
        core::intrinsic::bigint::log2i(a)
    } else {
        low as u64
    }
}

pub fn conversions(a : Int, i : u64) -> u64 {
    let f = core::intrinsic::bigint::sitofp(a);
    let b = core::intrinsic::bigint::fptosi(f);
    core::intrinsic::bigint::limb_count(b) + core::intrinsic::bigint::limb(a, i)
}

pub fn lean(a : Int, b : Int, k : u64) -> Int {
    core::intrinsic::bigint::divsi_lean(a, b) + core::intrinsic::bigint::remsi_lean(a, b)
        + core::intrinsic::bigint::edivsi_lean(a, b) + core::intrinsic::bigint::emodsi_lean(a, b)
        + core::intrinsic::bigint::floordivsi_lean(a, b) + core::intrinsic::bigint::floormodsi_lean(a, b)
        + core::intrinsic::bigint::divsi_exact_lean(a, b) + core::intrinsic::bigint::floormod2expi(a, k)
}

// The divisions of `Nat`s are `nonnegative`, those of `Int`s above are not.
pub fn natural(a : Nat, b : Nat) -> Nat {
    core::intrinsic::bigint::remsi_lean(a, b) + core::intrinsic::bigint::floordivsi(a, b)
        + core::intrinsic::bigint::divsi_exact_lean(a, b) + a / b + a % b
}

// MIR-DAG: intrinsic#bigint#edivsi#0
// MIR-DAG: intrinsic#bigint#trunci_overflow#0
// MIR-DAG: intrinsic#bigint#divsi_lean#0
// MIR-DAG: intrinsic#bigint#floormod2expi#0

// The `Nat` divisions first, then the Lean divisions: a pattern below without
// `nonnegative` or `divzero` would also match one of them, and leave its
// namesake unmatched.
// CHECK-DAG: rcgmp.remsi {{.*}} nonnegative divzero<lean>
// CHECK-DAG: rcgmp.floordivsi %{{[^ ]*}} %{{[^ ]*}} nonnegative :
// CHECK-DAG: rcgmp.divsi {{.*}} exact nonnegative divzero<lean>
// CHECK-DAG: rcgmp.divsi %{{[^ ]*}} %{{[^ ]*}} nonnegative :
// CHECK-DAG: rcgmp.remsi %{{[^ ]*}} %{{[^ ]*}} nonnegative :
// CHECK-DAG: rcgmp.remsi {{.*}} divzero<lean>
// CHECK-DAG: rcgmp.emodsi {{.*}} divzero<lean>
// CHECK-DAG: rcgmp.floordivsi {{.*}} divzero<lean>
// CHECK-DAG: rcgmp.divsi {{.*}} exact divzero<lean>
// CHECK-DAG: rcgmp.floormod2expi
// CHECK-DAG: rcgmp.edivsi
// CHECK-DAG: rcgmp.emodsi
// CHECK-DAG: rcgmp.floordivsi
// CHECK-DAG: rcgmp.floormodsi
// CHECK-DAG: rcgmp.gcdi
// CHECK-DAG: rcgmp.ipowi
// CHECK-DAG: rcgmp.divsi {{.*}}exact
// CHECK-DAG: rcgmp.absi
// CHECK-DAG: rcgmp.trunci_overflow {{.*}}unsigned{{.*}} to i32
// CHECK-DAG: rcgmp.testbiti
// CHECK-DAG: rcgmp.log2i
// CHECK-DAG: rcgmp.sitofp {{.*}} to f64
// CHECK-DAG: rcgmp.fptosi {{.*}} : f64 to !rcgmp.mpz
// CHECK-DAG: rcgmp.limb_count
// CHECK-DAG: rcgmp.limb {{.*}} to i64
