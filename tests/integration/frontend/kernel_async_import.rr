// REQUIRES: openxla
// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --core --emit rri -o %t.core.rri
// RUN: %FileCheck %s --check-prefix=CORE < %t.core.rri
// RUN: %rrc %S/Inputs/kernel_async_dep.rr --package-name dep --extern core=%t.core.rri --emit rri -o %t.dep.rri
// RUN: %rrc %s --package-name app --extern core=%t.core.rri --extern dep=%t.dep.rri --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %s --package-name app --extern core=%t.core.rri --extern dep=%t.dep.rri --emit mir --no-source-locations -o %t.mir
// RUN: %FileCheck %s --check-prefix=MIR < %t.mir
// CORE-DAG: lang("core::intrinsic::tensor::dynamic_slice")
// CORE-DAG: lang("core::intrinsic::tensor::async_done")
import core::intrinsic::tensor::async_done as complete;
import dep::begin;
#[kernel]
pub fn slice(x: Tensor<[f32; 8]>, index: i64) -> Tensor<[f32; 3]> {
    complete(begin(x, index))
}
// MIR-DAG: async[
// MIR-DAG: tensor#dynamic_slice
// MIR-DAG: tensor#async_done

import dep::routed;
#[kernel]
pub fn permuted(x: Tensor<[f32; 8]>) -> Tensor<[f32; 8]> { complete(routed(x)) }
// CORE-DAG: lang("core::intrinsic::tensor::collective_permute")
// MIR-DAG: tensor#collective_permute

import dep::finished;
#[kernel]
pub fn imported_done(x: Tensor<[f32; 8]>) -> Tensor<[f32; 8]> { finished(x) }
// CORE-DAG: #[kernel] pub fn #core::intrinsic::tensor::Future::done
// CORE-DAG: (self): Future<
