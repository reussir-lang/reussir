// REQUIRES: ifrt, linux, pjrt-runtime
// RUN: %rrc %s -o %t.source.o -O aggressive --relocation-mode pic
// RUN: %rrc %S/Inputs/kernel_launch_shapes_driver.mlir -o %t.driver.o -O aggressive --relocation-mode pic
// RUN: %cc %t.source.o %t.driver.o %S/Inputs/kernel_launch_shapes_execute.c -o %t.exe %pjrt_runtime %extra_sys_libs
// RUN: env XLA_FLAGS="--xla_force_host_platform_device_count=2" LD_LIBRARY_PATH="%pjrt_runtime_dir:$LD_LIBRARY_PATH" REUSSIR_PJRT_CACHE_CONFIG="%S/../runtime/Inputs/pjrt_cache.toml" %t.exe
// RUN: %rrc %s -o %t.none.o -O none --relocation-mode pic
// RUN: %cc %t.none.o %t.driver.o %S/Inputs/kernel_launch_shapes_execute.c -o %t.none.exe %pjrt_runtime %extra_sys_libs
// RUN: env XLA_FLAGS="--xla_force_host_platform_device_count=2" LD_LIBRARY_PATH="%pjrt_runtime_dir:$LD_LIBRARY_PATH" REUSSIR_PJRT_CACHE_CONFIG="%S/../runtime/Inputs/pjrt_cache.toml" %t.none.exe

#[placement(devices = "1,0", sharding = "#ifrt.sharding_param<2 to [0] on 2>")]
pub struct [value] Tiled {}

#[kernel] fn identity<T>(x: T) -> T { x }
#[kernel] fn select_nested(x: (Tensor<u64>, ((), (Tensor<u64>, bool)))) -> Tensor<u64> {
    if x.1.1.1 { x.0 } else { x.1.1.0 }
}

pub fn sharded_shape(x: DevArray<[i32; 5], Tiled>) -> DevArray<[i32; 5], Tiled> {
    let first = launch<Tiled>(identity<Tensor<[i32; 5]>>, x);
    // Both calls borrow x. The unused first result must be released.
    launch<Tiled>(identity<Tensor<[i32; 5]>>, x)
}

pub fn scalar_shape(x: DevArray<u64>, y: DevArray<u64>, condition: DevArray<bool>)
    -> DevArray<u64> {
    let first = launch(select_nested, (x, ((), (y, condition))));
    // Reuse x and condition after their appearance in a temporary nested tuple.
    launch(select_nested, (x, ((), (first, condition))))
}
