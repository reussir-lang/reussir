import core::simd;

// ERR-DAG: `core::simd::reduce_add` works on integer or floating-point lanes, found `Simd<[bool; 4]>`
fn masks(m: Simd<[bool; 4]>) -> bool { simd::reduce_add(m) }
// ERR-DAG: `core::simd::reduce_and` works on integer or `bool` lanes, found `Simd<[f32; 4]>`
fn bits(v: Simd<[f32; 4]>) -> f32 { simd::reduce_and(v) }
// ERR-DAG: `core::simd::reduce_add_reassoc` works on floating-point lanes, found `Simd<[i32; 4]>`
fn order(v: Simd<[i32; 4]>) -> i32 { simd::reduce_add_reassoc(v) }
// ERR-DAG: `core::simd::reduce_add` expects a vector and an optional mask, got 3 argument(s)
fn many(v: Simd<[i32; 4]>, m: Simd<[bool; 4]>) -> i32 { simd::reduce_add(v, m, m) }
