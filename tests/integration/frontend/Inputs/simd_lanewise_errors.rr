import core::simd;

// ERR-DAG: `core::simd::add` works on integer or floating-point lanes, found `Simd<[bool; 4]>`
fn masks(a: Simd<[bool; 4]>) -> Simd<[bool; 4]> { simd::add(a, a) }
// ERR-DAG: `core::simd::shl` works on integer lanes, found `Simd<[f32; 4]>`
fn shift(a: Simd<[f32; 4]>) -> Simd<[f32; 4]> { simd::shl(a, a) }
// ERR-DAG: `core::simd::and` works on integer or `bool` lanes, found `Simd<[f32; 4]>`
fn bits(a: Simd<[f32; 4]>) -> Simd<[f32; 4]> { simd::and(a, a) }
// ERR-DAG: `core::simd::fma` works on floating-point lanes, found `Simd<[i32; 4]>`
fn fused(a: Simd<[i32; 4]>) -> Simd<[i32; 4]> { simd::fma(a, a, a) }
// ERR-DAG: `core::simd::lt` works on integer or floating-point lanes, found `Simd<[bool; 4]>`
fn ordered(a: Simd<[bool; 4]>) -> Simd<[bool; 4]> { simd::lt(a, a) }
// ERR-DAG: `core::simd::add` expects 2 argument(s) and an optional mask, got 1
fn alone(a: Simd<[i32; 4]>) -> Simd<[i32; 4]> { simd::add(a) }
// ERR-DAG: `core::simd::add` takes a vector, found `i32`
fn scalars(a: i32) -> i32 { simd::add(a, a) }
// ERR-DAG: `core::simd::select` takes a mask of the shape of the vectors it chooses between, found `Simd<[bool; 8]>` and `Simd<[i32; 4]>`
fn shaped(m: Simd<[bool; 8]>, a: Simd<[i32; 4]>) -> Simd<[i32; 4]> { simd::select(m, a, a) }
