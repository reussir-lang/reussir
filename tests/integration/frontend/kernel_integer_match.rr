// REQUIRES: openxla
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit hir --no-source-locations -o %t.round.hir
// RUN: diff %t.hir %t.round.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.round.mir
// RUN: diff %t.mir %t.round.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.mlir
// RUN: %reussir-opt %t.mlir -o - | %FileCheck %s
// RUN: %rrc %s --emit mlir --no-source-locations -o %t.direct.mlir
// RUN: diff %t.mlir %t.direct.mlir

// Unsigned keys retain all 64 bits. The branch ordinal alone is i32.
#[kernel]
pub fn wide(key: u64, accept: bool, x: Tensor<f32>, y: Tensor<f32>) -> (Tensor<f32>, (u64, ())) {
    match key {
        0 => (x, (key, ())),
        4294967296 if accept => (y, (key, ())),
        18446744073709551615 => (y, (key, ())),
        whole => (x, (whole, ()))
    }
}

#[kernel]
pub fn signed(key: i64, x: i64, y: i64) -> i64 {
    match key { -9223372036854775808 => x, -1 => y, whole => whole }
}

// An irrefutable arm binds directly; Unit results require no fake SSA value.
#[kernel]
pub fn identity(key: i32) -> i32 { match key { whole => whole } }
#[kernel]
pub fn empty(key: i32) { match key { 0 => (), _ => () } }
#[kernel]
pub fn nested(key: i32, retry: i32, accept: bool) -> i32 {
    match key {
        0 if accept => retry,
        0 => key,
        _ => match retry { 1 => key, whole => whole }
    }
}

// CHECK: stablehlo.constant dense<4294967296> : tensor<ui64>
// CHECK: stablehlo.compare EQ
// CHECK: stablehlo.select
// CHECK: stablehlo.case
// CHECK: stablehlo.if
// CHECK: stablehlo.return
// CHECK: stablehlo.case
