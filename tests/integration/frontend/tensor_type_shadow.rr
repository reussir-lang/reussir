// Bare Tensor follows ordinary record shadowing; the qualified intrinsic name
// always denotes the builtin, including through an imported alias.
// RUN: %rrc %s --emit mlir --no-source-locations -o - | %FileCheck %s
pub struct Tensor<T> { value: T }
pub fn record(x: Tensor<i32>) -> Tensor<i32> { x }
pub fn builtin() {
    let t: core::intrinsic::tensor::Tensor<f32> = core::intrinsic::panic::panic();
}
// CHECK-DAG: ub.poison : tensor<f32>
// CHECK-DAG: !reussir.rc<!reussir.record<compound

// Monomorphized functions must distinguish the builtin tensor from a user
// record with the same surface name and element argument. A local contextual
// value keeps tensors confined to the function body.
fn instantiate<T>() { let value: T = core::intrinsic::panic::panic(); }
pub fn instantiate_both() {
    instantiate<core::intrinsic::tensor::Tensor<f32>>();
    instantiate<Tensor<f32>>();
}
// CHECK-DAG: func.func private @_RIC11instantiateINvNvNvC4core9intrinsic6tensor6TensorfEE()
// CHECK-DAG: func.func private @_RIC11instantiateIC6TensorfEE()
