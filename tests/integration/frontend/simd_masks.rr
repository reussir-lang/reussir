// RUN: %rrc %s --emit mlir --no-source-locations -o %t.mlir
// RUN: %FileCheck %s < %t.mlir
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %FileCheck %s --check-prefix=HIR < %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.rt.mlir
// RUN: diff %t.mlir %t.rt.mlir
// RUN: %rrc %s --emit llvm-ir -O aggressive -o %t.ll
// RUN: %rrc %S/Inputs/simd_masks_scalable.rr --target-triple aarch64-unknown-linux-gnu --target-features=+sve --emit llvm-ir -O aggressive -o %t.sve.ll
// RUN: %FileCheck %S/Inputs/simd_masks_scalable.rr < %t.sve.ll
// RUN: %not %rrc %S/Inputs/simd_masks_errors.rr --emit hir -o - 2>&1 | %FileCheck %S/Inputs/simd_masks_errors.rr --check-prefix=ERR

import core::simd;

// A masked lane keeps the first operand.
// HIR-DAG: intrinsic#simd#add#0(v0 : Simd<[i32; 8]>, v1 : Simd<[i32; 8]>, v2 : Simd<[bool; 8]>) : Simd<[i32; 8]>
// CHECK-LABEL: func.func @{{.*}}add
// CHECK: %[[SUM:.*]] = arith.addi %arg0, %arg1 : vector<8xi32>
// CHECK: arith.select %arg2, %[[SUM]], %arg0 : vector<8xi1>, vector<8xi32>
pub fn add(a: Simd<[i32; 8]>, b: Simd<[i32; 8]>, m: Simd<[bool; 8]>) -> Simd<[i32; 8]> {
    simd::add(a, b, m)
}

// CHECK-LABEL: func.func @{{.*}}any
// CHECK: vector.reduction <or>, %arg0 : vector<8xi1> into i1
pub fn any(m: Simd<[bool; 8]>) -> bool { simd::any(m) }

// A masked integer division divides masked lanes by one, so it cannot trap.
// CHECK-LABEL: func.func @{{.*}}div
// CHECK: %[[ONE:.*]] = vector.broadcast %{{.*}} : i32 to vector<8xi32>
// CHECK: %[[SAFE:.*]] = arith.select %arg2, %arg1, %[[ONE]]
// CHECK: %[[Q:.*]] = arith.divsi %arg0, %[[SAFE]]
// CHECK: arith.select %arg2, %[[Q]], %arg0
pub fn div(a: Simd<[i32; 8]>, b: Simd<[i32; 8]>, m: Simd<[bool; 8]>) -> Simd<[i32; 8]> {
    simd::div(a, b, m)
}

// A masked lane is false in a comparison.
// CHECK-LABEL: func.func @{{.*}}less
// CHECK: %[[CMP:.*]] = arith.cmpi slt, %arg0, %arg1 : vector<8xi32>
// CHECK: arith.andi %[[CMP]], %arg2 : vector<8xi1>
pub fn less(a: Simd<[i32; 8]>, b: Simd<[i32; 8]>, m: Simd<[bool; 8]>) -> Simd<[bool; 8]> {
    simd::lt(a, b, m)
}

// HIR-DAG: intrinsic#simd#mask_first#0(v0 : u64, v1 : u64) : Simd<[bool; 2, 8]>
// CHECK-LABEL: func.func @{{.*}}tail
// CHECK: vector.create_mask %{{.*}}, %{{.*}} : vector<2x8xi1>
pub fn tail(rows: u64, n: u64) -> Simd<[bool; 2, 8]> { simd::mask_first<Simd<[bool; 2, 8]>>(rows, n) }

// Several dimensions are flattened before a reduction.
// CHECK-LABEL: func.func @{{.*}}whole
// CHECK: %[[FLAT:.*]] = vector.shape_cast %arg0 : vector<2x8xi1> to vector<16xi1>
// CHECK: vector.reduction <and>, %[[FLAT]] : vector<16xi1> into i1
pub fn whole(m: Simd<[bool; 2, 8]>) -> bool { simd::all(m) }

// CHECK-LABEL: func.func @{{.*}}number
// CHECK: %[[ONES:.*]] = arith.extui %arg0 : vector<8xi1> to vector<8xi32>
// CHECK: vector.reduction <add>, %[[ONES]] : vector<8xi32> into i32
pub fn number(m: Simd<[bool; 8]>) -> u64 { simd::count(m) }

// CHECK-LABEL: func.func @{{.*}}position
// CHECK: %[[WORD:.*]] = vector.bitcast %arg0 : vector<8xi1> to vector<1xi8>
// CHECK: %[[BITS:.*]] = vector.extract %[[WORD]][0] : i8 from vector<1xi8>
// CHECK: %[[FIRST:.*]] = math.cttz %[[BITS]] : i8
// CHECK: arith.extui %[[FIRST]] : i8 to i64
pub fn position(m: Simd<[bool; 8]>) -> u64 { simd::first_set(m) }
