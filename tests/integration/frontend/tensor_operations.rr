// CHECK-DAG: stablehlo.dynamic_iota

#[kernel]
pub fn comparisons(x: Tensor<[u64; 2]>, y: Tensor<[u64; 2]>) -> (Tensor<[bool; 2]>, Tensor<[bool; 2]>, Tensor<[bool; 2]>, Tensor<[bool; 2]>, Tensor<[bool; 2]>, Tensor<[bool; 2]>) {
    (x == y, x != y, x < y, x <= y, x > y, x >= y)
}
#[kernel]
pub fn scalar_predicate(c: Tensor<bool>, x: Tensor<[i32; 2]>, y: Tensor<[i32; 2]>) -> Tensor<[i32; 2]> {
    tensor::select(c, tensor::min(x, y), tensor::max(x, y))
}
