// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %rrc %s --package-name scan --extern core=%t.core.rri --emit mlir --no-source-locations -o %t.mlir
// RUN: %FileCheck %s < %t.mlir
// RUN: %rrc %s --package-name scan --extern core=%t.core.rri --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.rt.mlir
// RUN: diff %t.mlir %t.rt.mlir
// RUN: %rrc %s --package-name scan --extern core=%t.core.rri -Onone --relocation-mode pic -o %t.o
// RUN: %cc %t.o %S/simd_scan_e2e.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe
// RUN: %rrc %s --package-name scan --extern core=%t.core.rri -Oaggressive --relocation-mode pic -o %t.opt.o
// RUN: %cc %t.opt.o %S/simd_scan_e2e.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.opt.exe

import core::ptr;
import core::ptr::Generic;
import core::ptr::PtrArithFlag;
import core::simd;

// Each loop reads its last chunk under a tail mask, so it never touches a
// byte past `len` and needs no scalar remainder.

// Set every element above `limit` to `limit`, with a masked store.
fn clamp(base: Ptr<Generic>, len: u64, limit: i32) -> u64 {
    let top = simd::splat<Simd<[i32; 8]>>(limit);
    let (end, changed) = while [i = 0, changed = 0] (i < len) {
        let live = simd::mask_first<Simd<[bool; 8]>>(len - i);
        let at = ptr::advance<i32>(base, i as i64, PtrArithFlag::Inbounds);
        let above = simd::gt(simd::load<Simd<[i32; 8]>>(at, live, top), top, live);
        simd::store(at, top, above);
        (i + 8, changed + simd::count(above))
    };
    changed
}
extern "C" trampoline "simd_clamp" = clamp;

// The number of bytes equal to `needle`.
fn count(base: ConstPtr<Generic>, len: u64, needle: u8) -> u64 {
    let wanted = simd::splat<Simd<[u8; 16]>>(needle);
    let zero = simd::splat<Simd<[u8; 16]>>(0);
    let (end, total) = while [i = 0, total = 0] (i < len) {
        let live = simd::mask_first<Simd<[bool; 16]>>(len - i);
        let at = ptr::offset(base, i as i64, PtrArithFlag::Inbounds);
        let chunk = simd::load<Simd<[u8; 16]>>(at, live, zero);
        (i + 16, total + simd::count(simd::eq(chunk, wanted, live)))
    };
    total
}
extern "C" trampoline "simd_count" = count;

// The index of the first byte equal to `needle`, or `len`.
// CHECK-LABEL: func.func {{.*}}@{{.*}}find
// CHECK: vector.create_mask
// CHECK: ptr.masked_load %{{.*}}, %{{.*}}, %{{.*}} alignment = 1 : !ptr.ptr<#ptr.generic_space> -> vector<16xi8>
// CHECK: vector.reduction <minui>
fn find(base: ConstPtr<Generic>, len: u64, needle: u8) -> u64 {
    let wanted = simd::splat<Simd<[u8; 16]>>(needle);
    let zero = simd::splat<Simd<[u8; 16]>>(0);
    let (end, hit) = while [i = 0, hit = len] (i < len && hit == len) {
        let live = simd::mask_first<Simd<[bool; 16]>>(len - i);
        let at = ptr::offset(base, i as i64, PtrArithFlag::Inbounds);
        let found = simd::eq(simd::load<Simd<[u8; 16]>>(at, live, zero), wanted, live);
        let here = if simd::any(found) { i + simd::first_set(found) } else { len };
        (i + 16, here)
    };
    hit
}
extern "C" trampoline "simd_find" = find;

// The sum of `len` 32-bit elements. The accumulator is a fixed vector
// carried through the loop and reduced once.
fn sum(base: ConstPtr<Generic>, len: u64) -> i64 {
    let zero = simd::splat<Simd<[i32; 8]>>(0);
    let (end, acc) = while [i = 0, acc = zero] (i < len) {
        let live = simd::mask_first<Simd<[bool; 8]>>(len - i);
        let at = ptr::advance<i32>(base, i as i64, PtrArithFlag::Inbounds);
        (i + 8, acc + simd::load<Simd<[i32; 8]>>(at, live, zero))
    };
    simd::reduce_add(acc) as i64
}
extern "C" trampoline "simd_sum" = sum;
