// Tensor type support is independent of tensor operations and kernel launching.
// Panic has a contextual result type, so these source annotations exercise the
// real type-lowering path without introducing a new tensor constructor.
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit hir --no-source-locations -o %t.round.hir
// RUN: diff %t.hir %t.round.hir
// RUN: %FileCheck %s --check-prefix=HIR < %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.round.mir
// RUN: diff %t.mir %t.round.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o - | %FileCheck %s --check-prefix=MLIR
// RUN: %rrc %s --emit mlir --no-source-locations -o - | %FileCheck %s --check-prefix=MLIR

import core::intrinsic::panic;
import core::intrinsic::tensor::Tensor as ScalarTensor;

pub fn scalar() { let t: ScalarTensor<f32> = panic::panic(); }
pub fn boolean() { let t: Tensor<bool> = panic::panic(); }
pub fn shaped() { let t: Tensor<[i32; 2, 3]> = panic::panic(); }
pub fn dynamic() { let t: Tensor<[u64; ?, 4]> = panic::panic(); }
pub fn empty() { let t: Tensor<[bfloat16; 0, ?]> = panic::panic(); }
pub fn large() { let t: Tensor<[f16; 65536, 65536, 2]> = panic::panic(); }
pub fn maximum() { let t: Tensor<[f64; 9223372036854775807]> = panic::panic(); }

// HIR-DAG: : Tensor<f32>
// HIR-DAG: : Tensor<bool>
// HIR-DAG: : Tensor<[i32; 2, 3]>
// HIR-DAG: : Tensor<[u64; ?, 4]>
// HIR-DAG: : Tensor<[bf16; 0, ?]>
// HIR-DAG: : Tensor<[f16; 65536, 65536, 2]>
// HIR-DAG: : Tensor<[f64; 9223372036854775807]>
// MLIR-DAG: ub.poison : tensor<f32>
// MLIR-DAG: ub.poison : tensor<i1>
// MLIR-DAG: ub.poison : tensor<2x3xi32>
// MLIR-DAG: ub.poison : tensor<?x4xi64>
// MLIR-DAG: ub.poison : tensor<0x?xbf16>
// MLIR-DAG: ub.poison : tensor<65536x65536x2xf16>
// MLIR-DAG: ub.poison : tensor<9223372036854775807xf64>
