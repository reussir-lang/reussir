// RUN: %rrc %s --emit mlir --no-source-locations -o %t.mlir
// RUN: %FileCheck %s < %t.mlir
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %FileCheck %s --check-prefix=HIR < %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.rt.mlir
// RUN: diff %t.mlir %t.rt.mlir
// RUN: %not %rrc %S/Inputs/simd_operators_errors.rr --emit hir -o - 2>&1 | %FileCheck %S/Inputs/simd_operators_errors.rr --check-prefix=ERR

import core::simd;

// An operator on vectors is the lanewise function of the same meaning.
// HIR-DAG: intrinsic#simd#add#0(intrinsic#simd#mul#0(v0 : Simd<[f32; 4]>, v1 : Simd<[f32; 4]>) : Simd<[f32; 4]>, v2 : Simd<[f32; 4]>) : Simd<[f32; 4]>
// CHECK-LABEL: func.func @{{.*}}axpy
// CHECK: %[[P:.*]] = arith.mulf %arg0, %arg1 : vector<4xf32>
// CHECK: arith.addf %[[P]], %arg2 : vector<4xf32>
pub fn axpy(a: Simd<[f32; 4]>, x: Simd<[f32; 4]>, y: Simd<[f32; 4]>) -> Simd<[f32; 4]> { a * x + y }

// `&`, `|`, `^` and `!` also work on masks.
// CHECK-LABEL: func.func @{{.*}}both
// CHECK: arith.andi %{{.*}}, %{{.*}} : vector<8xi1>
// CHECK: arith.xori %{{.*}}, %{{.*}} : vector<8xi1>
pub fn both(a: Simd<[i16; 8]>, b: Simd<[i16; 8]>) -> Simd<[bool; 8]> {
    !(simd::lt(a, b) & simd::ne(a, b))
}

// CHECK-LABEL: func.func @{{.*}}mixed
// CHECK: arith.subi
// CHECK: arith.divui
// CHECK: arith.remui
// CHECK: arith.shli
// CHECK: arith.shrui
// CHECK: arith.ori
// CHECK: arith.xori
// CHECK: arith.subi
pub fn mixed(a: Simd<[u32; 4]>, b: Simd<[u32; 4]>) -> Simd<[u32; 4]> {
    -((((a - b) / b % b) << b >> b | a) ^ b)
}

// A scalar `!` is unchanged.
// CHECK-LABEL: func.func @{{.*}}scalar
pub fn scalar(x: bool) -> bool { !x }
