// RUN: %rrc %s -o %t.o --relocation-mode pic -Oaggressive --reuse-across-call
// RUN: %cc %t.o %S/default_inliner_mltt.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe

// An MLTT checker exercising mutually recursive evaluation, conversion and
// type checking with shared closures. Each proof bundle checks its own
// definitions of addition, congruence, associativity, symmetry and transitivity.
// Borrow analysis remains enabled to cover the inliner failure in #916.

enum Term {
    Var(i64), U(i64), Pi(i64, Term, Term), Lam(i64, Term), App(Term, Term),
    Let(i64, Term, Term, Term), Ann(Term, Term),
    Nat, Zero, Suc(Term), NatElim(Term, Term, Term, Term),
    Id(Term, Term, Term), Refl(Term), J(Term, Term, Term, Term, Term, Term),
    Sigma(i64, Term, Term), Pair(Term, Term), Fst(Term), Snd(Term)
}
struct Closure { name: i64, body: Term, env: Env }
enum Value {
    Error, U(i64), Pi(Value, Closure), Lam(Closure), Nat, Zero, Suc(Value),
    Id(Value, Value, Value), Refl(Value), Sigma(Value, Closure), Pair(Value, Value),
    Var(i64), App(Value, Value), NatElim(Value, Value, Value, Value),
    J(Value, Value, Value, Value, Value, Value), Fst(Value), Snd(Value)
}
enum Env { Nil, Bind(i64, Value, Env) }
struct [value] Context { env: Env, types: Env, level: i64 }

fn empty() -> Env { Env::Nil }
fn bind(name: i64, value: Value, env: Env) -> Env { Env::Bind{name, value, env} }
fn lookup(env: Env, name: i64) -> Value {
    match env {
        Env::Nil => Value::Error,
        Env::Bind(key, value, rest) => if key == name { value } else { lookup(rest, name) }
    }
}
fn extend(ctx: Context, name: i64, ty: Value, value: Value, level: i64) -> Context {
    Context { env: bind(name, value, ctx.env), types: bind(name, ty, ctx.types), level: level }
}
fn fresh(level: i64) -> Value { Value::Var{level} }
fn closure(name: i64, body: Term, env: Env) -> Closure { Closure { name: name, body: body, env: env } }
fn instantiate(c: Closure, arg: Value) -> Value { eval(bind(c.name, arg, c.env), c.body) }
fn apply(fun: Value, arg: Value) -> Value {
    match fun { Value::Lam(c) => instantiate(c, arg), _ => Value::App{fun, arg} }
}
fn nat_elim(m: Value, z: Value, s: Value, n: Value) -> Value {
    match n {
        Value::Zero => z,
        Value::Suc(k) => apply(apply(s, k), nat_elim(m, z, s, k)),
        _ => Value::NatElim{m, z, s, n}
    }
}
fn id_elim(a: Value, x: Value, m: Value, d: Value, y: Value, p: Value) -> Value {
    match p { Value::Refl(_) => d, _ => Value::J{a, x, m, d, y, p} }
}
fn first(p: Value) -> Value {
    match p { Value::Pair(a, _) => a, _ => Value::Fst{p} }
}
fn second(p: Value) -> Value {
    match p { Value::Pair(_, b) => b, _ => Value::Snd{p} }
}
fn eval(env: Env, term: Term) -> Value {
    match term {
        Term::Var(i) => lookup(env, i),
        Term::U(i) => Value::U{i},
        Term::Pi(i, a, b) => Value::Pi{eval(env, a), closure(i, b, env)},
        Term::Lam(i, b) => Value::Lam{closure(i, b, env)},
        Term::App(f, a) => apply(eval(env, f), eval(env, a)),
        Term::Let(i, _, a, b) => eval(bind(i, eval(env, a), env), b),
        Term::Ann(a, _) => eval(env, a),
        Term::Nat => Value::Nat,
        Term::Zero => Value::Zero,
        Term::Suc(n) => Value::Suc{eval(env, n)},
        Term::NatElim(m, z, s, n) => nat_elim(eval(env, m), eval(env, z), eval(env, s), eval(env, n)),
        Term::Id(a, x, y) => Value::Id{eval(env, a), eval(env, x), eval(env, y)},
        Term::Refl(x) => Value::Refl{eval(env, x)},
        Term::J(a, x, m, d, y, p) => id_elim(eval(env, a), eval(env, x), eval(env, m), eval(env, d), eval(env, y), eval(env, p)),
        Term::Sigma(i, a, b) => Value::Sigma{eval(env, a), closure(i, b, env)},
        Term::Pair(a, b) => Value::Pair{eval(env, a), eval(env, b)},
        Term::Fst(p) => first(eval(env, p)),
        Term::Snd(p) => second(eval(env, p))
    }
}

// Conversion compares semantic values under fresh neutral variables.
fn conv(level: i64, a: Value, b: Value) -> bool {
    match a {
        Value::U(i) => match b { Value::U(j) => i == j, _ => false },
        Value::Var(i) => match b { Value::Var(j) => i == j, _ => false },
        Value::Nat => match b { Value::Nat => true, _ => false },
        Value::Zero => match b { Value::Zero => true, _ => false },
        Value::Pi(a, c) => match b {
            Value::Pi(b, d) => conv(level, a, b) && conv(level + 1, instantiate(c, fresh(level)), instantiate(d, fresh(level))),
            _ => false
        },
        Value::Sigma(a, c) => match b {
            Value::Sigma(b, d) => conv(level, a, b) && conv(level + 1, instantiate(c, fresh(level)), instantiate(d, fresh(level))),
            _ => false
        },
        Value::Lam(c) => match b {
            Value::Lam(d) => conv(level + 1, instantiate(c, fresh(level)), instantiate(d, fresh(level))),
            _ => false
        },
        Value::Suc(a) => match b { Value::Suc(b) => conv(level, a, b), _ => false },
        Value::Refl(a) => match b { Value::Refl(b) => conv(level, a, b), _ => false },
        Value::Fst(a) => match b { Value::Fst(b) => conv(level, a, b), _ => false },
        Value::Snd(a) => match b { Value::Snd(b) => conv(level, a, b), _ => false },
        Value::App(a, x) => match b { Value::App(b, y) => conv(level, a, b) && conv(level, x, y), _ => false },
        Value::Pair(a, x) => match b { Value::Pair(b, y) => conv(level, a, b) && conv(level, x, y), _ => false },
        Value::Id(a, x, y) => match b {
            Value::Id(b, u, v) => conv(level, a, b) && conv(level, x, u) && conv(level, y, v), _ => false
        },
        Value::NatElim(m, z, s, n) => match b {
            Value::NatElim(m2, z2, s2, n2) => conv(level, m, m2) && conv(level, z, z2) && conv(level, s, s2) && conv(level, n, n2),
            _ => false
        },
        Value::J(a, x, m, d, y, p) => match b {
            Value::J(a2, x2, m2, d2, y2, p2) =>
                conv(level, a, a2) && conv(level, x, x2) && conv(level, m, m2) &&
                conv(level, d, d2) && conv(level, y, y2) && conv(level, p, p2),
            _ => false
        },
        Value::Error => false
    }
}
fn sort(ctx: Context, term: Term) -> i64 {
    match infer(ctx, term) { Value::U(i) => i, _ => -1 }
}
fn check(ctx: Context, term: Term, ty: Value) -> bool {
    match term {
        Term::Lam(name, body) => match ty {
            Value::Pi(a, c) => {
                let variable = fresh(ctx.level);
                check(extend(ctx, name, a, variable, ctx.level + 1), body, instantiate(c, variable))
            },
            _ => false
        },
        Term::Pair(a, b) => match ty {
            Value::Sigma(domain, c) => check(ctx, a, domain) && check(ctx, b, instantiate(c, eval(ctx.env, a))),
            _ => false
        },
        _ => conv(ctx.level, infer(ctx, term), ty)
    }
}
fn nat_step_type(motive: Value) -> Value {
    let body = pi(-2, app(v(-3), v(-1)), app(v(-3), suc(v(-1))));
    Value::Pi{Value::Nat, closure(-1, body, bind(-3, motive, empty()))}
}
fn is_universe(ty: Value) -> bool { match ty { Value::U(_) => true, _ => false } }
fn nat_motive_ok(ctx: Context, ty: Value) -> bool {
    match ty {
        Value::Pi(a, c) => match a {
            Value::Nat => is_universe(instantiate(c, fresh(ctx.level))), _ => false
        },
        _ => false
    }
}
fn id_motive_ok(ctx: Context, a: Value, x: Value, ty: Value) -> bool {
    match ty {
        Value::Pi(b, c) => if conv(ctx.level, a, b) {
            let y = fresh(ctx.level);
            match instantiate(c, y) {
                Value::Pi(p, d) => conv(ctx.level + 1, p, Value::Id{a, x, y}) &&
                    is_universe(instantiate(d, fresh(ctx.level + 1))),
                _ => false
            }
        } else { false },
        _ => false
    }
}
fn infer_binder(ctx: Context, name: i64, a: Term, b: Term) -> Value {
    let i = sort(ctx, a);
    if i < 0 { Value::Error } else {
        let next = extend(ctx, name, eval(ctx.env, a), fresh(ctx.level), ctx.level + 1);
        let j = sort(next, b);
        if j < 0 { Value::Error } else { Value::U{if i > j { i } else { j }} }
    }
}
fn infer(ctx: Context, term: Term) -> Value {
    match term {
        Term::Var(i) => lookup(ctx.types, i),
        Term::U(i) => if i >= 0 && i < 9223372036854775807 { Value::U{i + 1} } else { Value::Error },
        Term::Pi(name, a, b) => infer_binder(ctx, name, a, b),
        Term::Sigma(name, a, b) => infer_binder(ctx, name, a, b),
        Term::App(f, x) => match infer(ctx, f) {
            Value::Pi(a, c) => if check(ctx, x, a) { instantiate(c, eval(ctx.env, x)) } else { Value::Error },
            _ => Value::Error
        },
        Term::Let(name, ty, rhs, body) => if sort(ctx, ty) < 0 { Value::Error } else {
            let ty = eval(ctx.env, ty);
            if check(ctx, rhs, ty) {
                infer(extend(ctx, name, ty, eval(ctx.env, rhs), ctx.level), body)
            } else { Value::Error }
        },
        Term::Ann(body, ty) => if sort(ctx, ty) < 0 { Value::Error } else {
            let ty = eval(ctx.env, ty);
            if check(ctx, body, ty) { ty } else { Value::Error }
        },
        Term::Nat => Value::U{0},
        Term::Zero => Value::Nat,
        Term::Suc(n) => if check(ctx, n, Value::Nat) { Value::Nat } else { Value::Error },
        Term::NatElim(m, z, s, n) => if !nat_motive_ok(ctx, infer(ctx, m)) || !check(ctx, n, Value::Nat) {
            Value::Error
        } else {
            let m = eval(ctx.env, m);
            if check(ctx, z, apply(m, Value::Zero)) && check(ctx, s, nat_step_type(m)) {
                apply(m, eval(ctx.env, n))
            } else { Value::Error }
        },
        Term::Id(a, x, y) => {
            let level = sort(ctx, a);
            if level < 0 { Value::Error } else {
                let a = eval(ctx.env, a);
                if check(ctx, x, a) && check(ctx, y, a) { Value::U{level} } else { Value::Error }
            }
        },
        Term::Refl(x) => {
            let a = infer(ctx, x);
            if is_error(a) { Value::Error } else {
                let x = eval(ctx.env, x);
                Value::Id{a, x, x}
            }
        },
        Term::J(a, x, m, d, y, p) => if sort(ctx, a) < 0 { Value::Error } else {
            let a = eval(ctx.env, a);
            if !check(ctx, x, a) || !check(ctx, y, a) { Value::Error } else {
                let x = eval(ctx.env, x);
                let y = eval(ctx.env, y);
                if !check(ctx, p, Value::Id{a, x, y}) || !id_motive_ok(ctx, a, x, infer(ctx, m)) {
                    Value::Error
                } else {
                    let m = eval(ctx.env, m);
                    if check(ctx, d, apply(apply(m, x), Value::Refl{x})) {
                        apply(apply(m, y), eval(ctx.env, p))
                    } else { Value::Error }
                }
            }
        },
        Term::Fst(p) => match infer(ctx, p) { Value::Sigma(a, _) => a, _ => Value::Error },
        Term::Snd(p) => match infer(ctx, p) {
            Value::Sigma(_, c) => instantiate(c, first(eval(ctx.env, p))), _ => Value::Error
        },
        _ => Value::Error
    }
}

fn v(i: i64) -> Term { Term::Var{i} }
fn u(i: i64) -> Term { Term::U{i} }
fn pi(i: i64, a: Term, b: Term) -> Term { Term::Pi{i, a, b} }
fn lam(i: i64, body: Term) -> Term { Term::Lam{i, body} }
fn app(f: Term, a: Term) -> Term { Term::App{f, a} }
fn app2(f: Term, a: Term, b: Term) -> Term { app(app(f, a), b) }
fn app3(f: Term, a: Term, b: Term, c: Term) -> Term { app(app2(f, a, b), c) }
fn let_(i: i64, ty: Term, rhs: Term, body: Term) -> Term { Term::Let{i, ty, rhs, body} }
fn ann(body: Term, ty: Term) -> Term { Term::Ann{body, ty} }
fn nat() -> Term { Term::Nat }
fn zero() -> Term { Term::Zero }
fn suc(n: Term) -> Term { Term::Suc{n} }
fn natelim(m: Term, z: Term, s: Term, n: Term) -> Term { Term::NatElim{m, z, s, n} }
fn eq(a: Term, x: Term, y: Term) -> Term { Term::Id{a, x, y} }
fn refl(x: Term) -> Term { Term::Refl{x} }
fn j(a: Term, x: Term, m: Term, d: Term, y: Term, p: Term) -> Term { Term::J{a, x, m, d, y, p} }
fn sigma(i: i64, a: Term, b: Term) -> Term { Term::Sigma{i, a, b} }
fn pair(a: Term, b: Term) -> Term { Term::Pair{a, b} }
fn fst(p: Term) -> Term { Term::Fst{p} }
fn snd(p: Term) -> Term { Term::Snd{p} }
fn is_error(value: Value) -> bool { match value { Value::Error => true, _ => false } }
fn infer_top(ctx: Context, term: Term) -> Value { infer(ctx, term) }

struct [value] Proof { ty: Term, body: Term }

fn numeral(n: i64) -> Term {
    if n == 0 { zero() } else { suc(numeral(n - 1)) }
}
fn add(x: Term, y: Term) -> Term { app2(v(100), x, y) }
fn cong(x: Term, y: Term, p: Term) -> Term { app3(v(101), x, y, p) }
fn trans(x: Term, y: Term, z: Term, p: Term, q: Term) -> Term {
    app2(app3(app(v(105), nat()), x, y, z), p, q)
}
fn add_type() -> Term { pi(0, nat(), pi(1, nat(), nat())) }
fn add_body() -> Term {
    lam(0, lam(1, natelim(
        ann(lam(2, nat()), pi(2, nat(), u(0))),
        v(1), lam(3, lam(4, suc(v(4)))), v(0))))
}
fn cong_type() -> Term {
    pi(0, nat(), pi(1, nat(), pi(2, eq(nat(), v(0), v(1)),
        eq(nat(), suc(v(0)), suc(v(1))))))
}
fn cong_body() -> Term {
    lam(0, lam(1, lam(2,
        j(nat(), v(0),
            ann(lam(3, lam(4, eq(nat(), suc(v(0)), suc(v(3))))),
                pi(3, nat(), pi(4, eq(nat(), v(0), v(3)), u(0)))),
            refl(suc(v(0))), v(1), v(2)))))
}
fn right_type() -> Term { pi(0, nat(), eq(nat(), add(v(0), zero()), v(0))) }
fn right_body() -> Term {
    lam(0, natelim(
        ann(lam(1, eq(nat(), add(v(1), zero()), v(1))), pi(1, nat(), u(0))),
        refl(zero()),
        lam(2, lam(3, cong(add(v(2), zero()), v(2), v(3)))), v(0)))
}
fn assoc_type() -> Term {
    pi(0, nat(), pi(1, nat(), pi(2, nat(),
        eq(nat(), add(add(v(0), v(1)), v(2)), add(v(0), add(v(1), v(2)))))))
}
fn assoc_body() -> Term {
    lam(0, lam(1, lam(2, natelim(
        ann(lam(3, eq(nat(), add(add(v(3), v(1)), v(2)), add(v(3), add(v(1), v(2))))),
            pi(3, nat(), u(0))),
        refl(add(v(1), v(2))),
        lam(4, lam(5, cong(add(add(v(4), v(1)), v(2)), add(v(4), add(v(1), v(2))), v(5)))),
        v(0)))))
}
fn sym_type() -> Term {
    pi(0, u(0), pi(1, v(0), pi(2, v(0), pi(3, eq(v(0), v(1), v(2)),
        eq(v(0), v(2), v(1))))))
}
fn sym_body() -> Term {
    lam(0, lam(1, lam(2, lam(3,
        j(v(0), v(1),
            ann(lam(4, lam(5, eq(v(0), v(4), v(1)))),
                pi(4, v(0), pi(5, eq(v(0), v(1), v(4)), u(0)))),
            refl(v(1)), v(2), v(3))))))
}
fn trans_type() -> Term {
    pi(0, u(0), pi(1, v(0), pi(2, v(0), pi(3, v(0),
        pi(4, eq(v(0), v(1), v(2)), pi(5, eq(v(0), v(2), v(3)),
            eq(v(0), v(1), v(3))))))))
}
fn trans_body() -> Term {
    lam(0, lam(1, lam(2, lam(3, lam(4, lam(5,
        j(v(0), v(2),
            ann(lam(6, lam(7, eq(v(0), v(1), v(6)))),
                pi(6, v(0), pi(7, eq(v(0), v(2), v(6)), u(0)))),
            v(4), v(3), v(5))))))))
}
fn bundle(body: Term) -> Term {
    let_(100, add_type(), add_body(),
    let_(101, cong_type(), cong_body(),
    let_(102, right_type(), right_body(),
    let_(103, assoc_type(), assoc_body(),
    let_(104, sym_type(), sym_body(),
    let_(105, trans_type(), trans_body(), body))))))
}

fn chain_end(i: i64) -> Term {
    if i % 2 == 0 { v(1000) } else { add(v(1000), zero()) }
}
fn chain_lets(i: i64, rest: Term, bad: bool) -> Term {
    if i == 0 {
        let_(2000, eq(nat(), add(v(1000), zero()), v(1000)), app(v(102), v(1000)), rest)
    } else {
        let evidence = if bad && i == 1 { refl(zero()) } else {
            if i % 2 == 1 { app(v(104), nat()) } else { v(102) }
        };
        let q = if bad && i == 1 { evidence } else {
            if i % 2 == 1 {
                app3(evidence, add(v(1000), zero()), v(1000), v(2000))
            } else { app(evidence, v(1000)) }
        };
        chain_lets(i - 1,
            let_(2000 + i, eq(nat(), add(v(1000), zero()), chain_end(i)),
                trans(add(v(1000), zero()), chain_end(i - 1), chain_end(i), v(1999 + i), q),
                rest), bad)
    }
}
fn workload(case_id: i64, size: i64, bad: bool) -> Proof {
    if case_id == 0 {
        let result = eq(nat(), add(add(numeral(size), v(1000)), v(1001)),
            add(numeral(size), add(v(1000), v(1001))));
        Proof {
            ty: pi(1000, nat(), pi(1001, nat(), result)),
            body: lam(1000, lam(1001,
                app3(v(103), numeral(size), v(1000),
                    if bad { suc(v(1001)) } else { v(1001) }))),
        }
    } else {
        if case_id == 1 {
            Proof {
                ty: pi(1000, nat(), eq(nat(), add(v(1000), zero()), chain_end(size))),
                body: lam(1000, chain_lets(size, v(2000 + size), bad)),
            }
        } else {
            let witness = add(numeral(size), numeral(size));
            Proof {
                ty: sigma(1000, nat(), eq(nat(), v(1000), numeral(size * 2))),
                body: pair(witness,
                    refl(numeral(size * 2 + if bad { 1 } else { 0 }))),
            }
        }
    }
}
fn checked(term: Term) -> bool {
    let ctx = Context { env: empty(), types: empty(), level: 0 };
    !is_error(infer_top(ctx, term))
}
fn check_case(case_id: i64, size: i64, bad: bool) -> i64 {
    let proof = workload(case_id, size, bad);
    if checked(bundle(ann(proof.body, proof.ty))) { 1 } else { 0 }
}
fn regressions() -> i64 {
    let good_pair = ann(pair(zero(), refl(zero())), sigma(0, nat(), eq(nat(), v(0), v(0))));
    let a = checked(ann(u(0), u(1)));
    let b = !checked(ann(u(0), u(0)));
    let c = !checked(ann(v(7), nat()));
    let d = !checked(let_(0, nat(), u(0), zero()));
    let e = !checked(ann(app(ann(lam(0, zero()), pi(0, nat(), nat())), u(0)), nat()));
    let f = checked(ann(fst(good_pair), nat()));
    let g = checked(ann(snd(good_pair), eq(nat(), zero(), zero())));
    let h = !checked(ann(refl(zero()), eq(nat(), zero(), suc(zero()))));
    let i = !checked(natelim(ann(lam(0, nat()), pi(0, nat(), u(0))), zero(),
        lam(0, lam(1, u(0))), zero()));
    let k = !checked(j(nat(), zero(),
        ann(lam(0, lam(1, nat())), pi(0, nat(), pi(1, eq(nat(), zero(), v(0)), u(0)))),
        zero(), suc(zero()), refl(zero())));
    if a && b && c && d && e && f && g && h && i && k { 10 } else { 0 }
}


extern "C" trampoline "mltt_check_case" = check_case;
extern "C" trampoline "mltt_regressions" = regressions;
