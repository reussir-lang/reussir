// Host calls are valid only for Tensor results, and cannot silently become
// ordinary native calls before launch lowering is implemented.
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %not %rrc %t.mir --emit mlir -o - 2>&1 | %FileCheck %s
// CHECK: kernel launching is not available
pub fn a_host() { let result = z_produce(); }
#[kernel]
fn z_produce() -> Tensor<f32>;
