// REQUIRES: openxla
// Tuple structure is legal in kernel signatures and expressions, while this
// source product is preserved through textual IR without a host aggregate ABI.
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit hir --no-source-locations -o %t.round.hir
// RUN: diff %t.hir %t.round.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.round.mir
// RUN: diff %t.mir %t.round.mir

#[kernel]
pub fn a_pair(x: (Tensor<f32>, (Token,)), y: Tensor<f32>) -> (Tensor<f32>, Token) {
    let (value, (token,)) = x;
    (y, token)
}

#[kernel]
fn identity<T>(x: T) -> T { x }
#[kernel]
pub fn generic(p: (Tensor<f32>, Future<Tensor<f32>, Tensor<[u64; 2]>>)) -> (Tensor<f32>, Future<Tensor<f32>, Tensor<[u64; 2]>>) {
    identity(p)
}
