// RUN: %rrc %s --emit mlir --no-source-locations -o %t.mlir
// RUN: %FileCheck %s < %t.mlir
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %FileCheck %s --check-prefix=HIR < %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %FileCheck %s --check-prefix=MIR < %t.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.rt.mlir
// RUN: diff %t.mlir %t.rt.mlir
// RUN: %rrc %s --emit llvm-ir -O aggressive -o %t.ll
// RUN: %FileCheck %s --check-prefix=LLVM < %t.ll
// RUN: %not %rrc %S/Inputs/data_ptr_errors.rr --emit hir -o - 2>&1 | %FileCheck %S/Inputs/data_ptr_errors.rr --check-prefix=ERR

import core::intrinsic::array;
import core::intrinsic::str;
import core::ptr;
import core::ptr::Generic;

// HIR-DAG: intrinsic#str#unsafe_data_ptr#0(v0 : str) : ConstPtr<GenericAddrSpace>
// MIR-DAG: intrinsic#str#unsafe_data_ptr#0(v0 : str) : ConstPtr<GenericAddrSpace>
// CHECK-LABEL: func.func @{{.*}}bytes
// CHECK: reussir.str.data_ptr(%arg0 : <global>) : !ptr.ptr<#ptr.generic_space>
// LLVM-LABEL: define {{.*}}ptr @{{.*}}bytes
// LLVM: extractvalue { ptr, i64 } %0, 0
pub fn bytes(s: str) -> ConstPtr<Generic> { str::unsafe_data_ptr(s) }

// The array is borrowed: the pointer does not keep it alive.
// HIR-DAG: array#unsafe_data_ptr(v0 : [f64; 4]) : ConstPtr<GenericAddrSpace>
// MIR-DAG: array#unsafe_data_ptr(v0 : [f64; 4]) : ConstPtr<GenericAddrSpace>
// CHECK-LABEL: func.func @{{.*}}cells
// CHECK: %[[VIEW:.*]] = reussir.array.view
// CHECK: %[[SPACED:.*]] = memref.memory_space_cast %[[VIEW]] : memref<4xf64> to memref<4xf64, #ptr.generic_space>
// CHECK: %[[PTR:.*]] = ptr.to_ptr %[[SPACED]]
// CHECK: ptr.load %[[PTR]] : !ptr.ptr<#ptr.generic_space> -> f64
// CHECK: reussir.rc.dec
pub fn cells(a: [f64; 4]) -> f64 {
    let first: f64 = ptr::load(array::unsafe_data_ptr(a));
    first + array::get(a, 1)
}

// CHECK-LABEL: func.func @{{.*}}dynamic
// CHECK: memref.memory_space_cast %{{.*}} to memref<?x2xi32, strided<[?, ?], offset: ?>, #ptr.generic_space>
// CHECK: ptr.to_ptr
pub fn dynamic(a: [i32; ?, 2]) -> u64 {
    ptr::addr(array::unsafe_data_ptr(a)) + array::dim(a, 0)
}
