// REQUIRES: openxla
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %s --emit mlir -o %t.mlir
// RUN: %rrc %t.mir --emit mlir -o %t.replay.mlir
// RUN: %reussir-opt %t.mlir | %FileCheck %s
// RUN: %reussir-opt %t.replay.mlir | %FileCheck %s
// CHECK: reussir.kernel
// CHECK: stablehlo.while
// CHECK: stablehlo.compare
// CHECK: stablehlo.return
// CHECK: stablehlo.add
// CHECK: stablehlo.return
// CHECK-NOT: scf.
// CHECK-NOT: reussir.record
#[kernel]
pub fn count(n: i64) -> (i64, (i64, ())) {
    while [i = 0, pair = (1, ())] (i < n) { (i + 1, (pair.0 + i, ())) }
}

#[kernel]
pub fn tensor_condition(c: Tensor<bool>, x: Tensor<[f32; 2]>) -> Tensor<[f32; 2]> {
    while [value = x] (c) { value }
}
