// Simple wrappers inline even in raw MLIR and -Onone; arguments retain call order.
// RUN: %rrc %s --emit mlir --no-source-locations -o %t.mlir
// RUN: %FileCheck %s < %t.mlir
// RUN: %rrc %s --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.round.mlir
// RUN: %FileCheck %s < %t.round.mlir
// RUN: %rrc %s -Onone --relocation-mode pic -o %t.o
// RUN: %cc %t.o %S/intrinsic_wrapper_inline.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe
// RUN: %rrc %s -Oaggressive --relocation-mode pic -o %t.opt.o
// RUN: %cc %t.opt.o %S/intrinsic_wrapper_inline.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.opt.exe
import core::intrinsic::cell;
import core::intrinsic::str;

fn read_twice(c: Cell<u64>, ignored: ()) -> u64 {
    let value = cell::get(c);
    value + value
}
fn bump(c: Cell<u64>) -> Cell<u64> {
    cell::set(c, cell::get(c) + 1);
    c
}
fn tick(c: Cell<u64>) { cell::set(c, cell::get(c) + 10); }
pub fn order(n: u64) -> u64 {
    let c = cell::alloc(n);
    let result = read_twice(bump(c), tick(c));
    result + cell::get(c)
}
extern "C" trampoline "wrapper_order" = order;

pub struct [shared] Text { value: str }
impl Text {
    pub fn size(self: Self) -> u64 { str::len(self.value) }
}
fn fetch(c: Cell<Text>) -> Text { cell::get(c) }
pub fn managed() -> u64 {
    let label = "hello!";
    let text = Text { value: label };
    let c = cell::alloc(text);
    let other = fetch(c);
    text.size() + other.size() + fetch(c).size() + str::len(label)
}
extern "C" trampoline "wrapper_managed" = managed;

// CHECK-NOT: call @_RC10read_twice
// CHECK-NOT: call @_RC5fetch
// CHECK-NOT: call @_RNvC4Text4size
// CHECK: call @_RC4bump
// CHECK: call @_RC4tick
// CHECK-NOT: call @_RC10read_twice
// CHECK-NOT: call @_RC5fetch
// CHECK-NOT: call @_RNvC4Text4size
