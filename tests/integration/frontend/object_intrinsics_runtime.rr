// RUN: %rrc %s -Onone --relocation-mode pic -o %t.o
// RUN: %cc %t.o %S/object_intrinsics_runtime.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe
// RUN: %rrc %s -Oaggressive --relocation-mode pic -o %t.opt.o
// RUN: %cc %t.opt.o %S/object_intrinsics_runtime.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.opt.exe

import core::object;
struct [shared] Box { value: i64 }

fn exercise(n: i64) -> i64 {
    let b = Box{n};
    let before = object::is_unique(b);
    object::unsafe_inc(b);
    let shared = object::is_unique(b);
    object::unsafe_dec(b);
    let after = object::is_unique(b);
    if before && !shared && after { b.value } else { -1 }
}
extern "C" trampoline "object_counts" = exercise;

fn cell() -> bool {
    let c: Cell<i64> = core::intrinsic::cell::alloc(42);
    let before = object::is_unique(c);
    object::unsafe_inc(c);
    let shared = object::is_unique(c);
    object::unsafe_dec(c);
    before && !shared && object::is_unique(c)
}
extern "C" trampoline "object_cell_counts" = cell;
