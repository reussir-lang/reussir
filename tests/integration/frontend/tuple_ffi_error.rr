// RUN: %not %rrc %s --emit mir -o - 2>&1 | %FileCheck %s
// The Rust texture boundary rejects inline aggregates. Native C trampoline
// aggregate passing is independently exercised by tuple_values_e2e.rr.
#[ffi(import)]
fn external<T>(x: T) -> T [{ x }];
pub fn use_it(x: (u64, bool)) -> (u64, bool) { external(x) }
// CHECK: an anonymous tuple cannot cross the FFI boundary
