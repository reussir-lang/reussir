// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit hir --no-source-locations -o %t.round.hir
// RUN: diff %t.hir %t.round.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.round.mir
// RUN: diff %t.mir %t.round.mir
// RUN: %rrc %s -o %t.o --relocation-mode pic
// RUN: %cc %t.o %S/negative_integer_patterns.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.exe
// RUN: %rrc %s -o %t.opt.o --relocation-mode pic -Oaggressive
// RUN: %cc %t.opt.o %S/negative_integer_patterns.c -o %t.opt.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.opt.exe
pub fn score(key: i64) -> i64 {
    match (key, true) {
        (-9223372036854775808, _) => 1,
        (-0x80, true) => 2,
        (-1, true) => 3,
        (whole, _) => whole
    }
}
extern "C" trampoline "score" = score;
