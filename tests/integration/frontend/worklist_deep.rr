// UNSUPPORTED: windows, darwin
// RUN: %rrc %s -o %t.forward.o --drop-order forward --relocation-mode pic -O none
// RUN: %cc %t.forward.o %S/worklist_deep.c -o %t.forward.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.forward.exe
// RUN: %rrc %s -o %t.backward.o --drop-order backward --relocation-mode pic -Oaggressive
// RUN: %cc %t.backward.o %S/worklist_deep.c -o %t.backward.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: %t.backward.exe

extern "rust" [{
    use reussir_rt::collections::vec::Vec as RVec;
}];

#[ffi(rust = "::reussir_rt::collections::vec::Vec")]
pub struct Vec<T>;
#[ffi(import)]
pub fn new<T>() -> Vec<T> [{ RVec::new() }];
#[ffi(import)]
pub fn push<T>(v: Vec<T>, x: T) -> Vec<T> [{ RVec::push(v, x) }];

pub struct Node { children: Vec<Node> }
pub fn empty() -> Node { Node { children: new<Node>() } }
pub fn wrap(node: Node) -> Node {
    Node { children: push(new<Node>(), node) }
}
pub fn discard(node: Node) -> i64 { 42 }

pub fn base() -> (i64) -> i64 { |x: i64| x }
pub fn wrap_closure_a(f: (i64) -> i64) -> (i64) -> i64 {
    |x: i64| f(x) + 1
}
pub fn wrap_closure_b(f: (i64) -> i64) -> (i64) -> i64 {
    |x: i64| f(x) + 2
}
pub fn discard_closure(f: (i64) -> i64) -> i64 { 42 }

extern "C" trampoline "deep_empty" = empty;
extern "C" trampoline "deep_wrap" = wrap;
extern "C" trampoline "deep_discard" = discard;
extern "C" trampoline "deep_base" = base;
extern "C" trampoline "deep_wrap_closure_a" = wrap_closure_a;
extern "C" trampoline "deep_wrap_closure_b" = wrap_closure_b;
extern "C" trampoline "deep_discard_closure" = discard_closure;
