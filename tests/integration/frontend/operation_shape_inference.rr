// REQUIRES: stablehlo
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %rrc %t.hir --emit hir --no-source-locations -o %t.round.hir
// RUN: diff %t.hir %t.round.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %rrc %t.mir --emit mir --no-source-locations -o %t.round.mir
// RUN: diff %t.mir %t.round.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.mlir
// RUN: %reussir-opt %t.mlir -o /dev/null
// RUN: %FileCheck %s < %t.mlir
import core::intrinsic::tensor;

#[kernel]
pub fn scalar_binding() -> Tensor<[f32; 2, 3]> {
    let scalar = 1.0;
    tensor::fill(scalar)
}
#[kernel]
pub fn scalar_computation() -> Tensor<[f32; 2, 3]> {
    tensor::fill(1.0 + 2.0)
}
#[kernel]
pub fn later_iota_annotation() -> Tensor<[i32; 4]> {
    let ramp = tensor::iota(0);
    let typed: Tensor<[i32; 4]> = ramp;
    typed
}
#[kernel]
pub fn backward_transpose() -> Tensor<[f32; 3, 2]> {
    let value = tensor::fill(1.0);
    tensor::transpose(value)
}
#[kernel]
pub fn backward_dot(right: Tensor<[f32; 3, 4]>) -> Tensor<[f32; 2, 4]> {
    let left = tensor::fill(1.0);
    tensor::dot(left, right)
}
#[kernel]
pub fn comparison_and_select(y: Tensor<[f32; 2, 3]>) -> Tensor<[f32; 2, 3]> {
    let x = tensor::fill(1.0);
    let greater = x > y;
    tensor::select(greater, x, y)
}
#[kernel]
pub fn tuple_context() -> (Tensor<[f32; 2, 3]>, Tensor<[f32; 3, 2]>) {
    let x = tensor::fill(1.0);
    (x, tensor::transpose(x))
}
#[kernel]
fn filled<T, S>(value: S) -> Tensor<T> { tensor::fill(value) }
#[kernel]
fn ramp<T>() -> Tensor<T> { tensor::iota(0) }
#[kernel]
pub fn generic_helpers() -> (Tensor<[f32; 2, 3]>, Tensor<[i32; 4]>) {
    (filled(1.0), ramp())
}
#[kernel]
pub fn explicit_partial_shape(right: Tensor<[f32; 3, 4]>) -> Tensor<[f32; 2, 4]> {
    let left: Tensor<[f32; _, 3]> = tensor::fill(1.0);
    tensor::dot(left, right)
}

// CHECK-DAG: stablehlo.broadcast_in_dim
// CHECK-DAG: stablehlo.iota
// CHECK-DAG: stablehlo.transpose
// CHECK-DAG: stablehlo.dot_general
// CHECK-DAG: stablehlo.compare
// CHECK-DAG: stablehlo.select

#[kernel]
fn dynamic_helper<T>(value: f32, n: i64) -> Tensor<T> {
    tensor::dynamic_fill(value, (n,))
}
#[kernel]
pub fn direct_runtime_shape(n: i64) -> Tensor<[f32; 4]> {
    tensor::dynamic_fill(1.0, (n,))
}
#[kernel]
pub fn later_runtime_shape(n: i64) -> Tensor<[f32; 4]> {
    let value = tensor::dynamic_fill(1.0, (n,));
    let typed: Tensor<[f32; 4]> = value;
    typed
}
#[kernel]
pub fn wrapped_runtime_shape(n: i64) -> Tensor<[f32; 4]> {
    let value = dynamic_helper(1.0, n);
    let typed: Tensor<[f32; 4]> = value;
    typed
}
#[kernel]
pub fn runtime_fallback(n: i64) {
    let scalar: f32 = 1.0;
    let filled = tensor::dynamic_fill(scalar, (n,));
    let ramp: Tensor<[i32; _]> = tensor::dynamic_iota((n,), 0);
}

#[kernel]
fn transpose_helper<T, R>(value: Tensor<T>) -> R { tensor::transpose(value) }
#[kernel]
fn dot_helper<T, U, R>(a: Tensor<T>, b: Tensor<U>) -> R { tensor::dot(a, b) }
#[kernel]
pub fn direct_dynamic_transpose(x: Tensor<[f32; ?, 3]>) -> Tensor<[f32; 3, 4]> {
    tensor::transpose(x)
}
#[kernel]
pub fn later_dynamic_transpose(x: Tensor<[f32; ?, 3]>) -> Tensor<[f32; 3, 4]> {
    let value = tensor::transpose(x);
    value
}
#[kernel]
pub fn wrapped_dynamic_transpose(x: Tensor<[f32; ?, 3]>) -> Tensor<[f32; 3, 4]> {
    let value = transpose_helper(x);
    value
}
#[kernel]
pub fn direct_dynamic_dot(x: Tensor<[f32; ?, 3]>, y: Tensor<[f32; 3, 4]>) -> Tensor<[f32; 2, 4]> {
    tensor::dot(x, y)
}
#[kernel]
pub fn later_dynamic_dot(x: Tensor<[f32; ?, 3]>, y: Tensor<[f32; 3, 4]>) -> Tensor<[f32; 2, 4]> {
    let value = tensor::dot(x, y);
    value
}
#[kernel]
pub fn wrapped_dynamic_dot(x: Tensor<[f32; ?, 3]>, y: Tensor<[f32; 3, 4]>) -> Tensor<[f32; 2, 4]> {
    let value = dot_helper(x, y);
    value
}

#[kernel]
fn dynamic_ramp_helper<T>(n: i64) -> Tensor<T> {
    tensor::dynamic_iota((n,), 0)
}
#[kernel]
pub fn direct_runtime_iota(n: i64) -> Tensor<[i32; 4]> {
    tensor::dynamic_iota((n,), 0)
}
#[kernel]
pub fn later_runtime_iota(n: i64) -> Tensor<[i32; 4]> {
    let value = tensor::dynamic_iota((n,), 0);
    value
}
#[kernel]
pub fn wrapped_runtime_iota(n: i64) -> Tensor<[i32; 4]> {
    let value = dynamic_ramp_helper(n);
    value
}
