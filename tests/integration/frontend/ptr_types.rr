// RUN: %rrc --package-root %S/../../../library/core/src --package-name core --builtin --emit rri -o %t.core.rri
// RUN: %rrc %s --package-name ptrs --extern core=%t.core.rri --emit mlir --no-source-locations -o - | %FileCheck %s
// RUN: %rrc %s --emit mlir --no-source-locations -o %t.mlir
// RUN: %FileCheck %s < %t.mlir
// RUN: %rrc %s --emit hir --no-source-locations -o %t.hir
// RUN: %FileCheck %s --check-prefix=HIR < %t.hir
// RUN: %rrc %t.hir --emit mir --no-source-locations -o %t.mir
// RUN: %FileCheck %s --check-prefix=MIR < %t.mir
// RUN: %rrc %t.mir --emit mlir --no-source-locations -o %t.rt.mlir
// RUN: diff %t.mlir %t.rt.mlir
// RUN: %rrc %s --emit llvm-ir -O aggressive -o %t.ll
// RUN: %FileCheck %s --check-prefix=LLVM < %t.ll

// `Ptr<A>` and `ConstPtr<A>` are one opaque MLIR pointer; the address space
// selects the memory space, and constness stays in the frontend.

// HIR: pub [value] struct #Pair { "first": Ptr<Generic>, "second": ConstPtr<Generic> };
// MIR: value struct Pair { "first": Ptr<Generic>, "second": ConstPtr<Generic> };
pub struct [value] Pair { first: Ptr<Generic>, second: ConstPtr<Generic> }
pub struct [shared] Node { at: Ptr<Generic>, next: Nullable<Node> }
enum Slot { Empty, Full(ConstPtr<Generic>) }

// CHECK-DAG: func.func @{{.*}}identity{{.*}}(%arg0: !ptr.ptr<#ptr.generic_space>) -> !ptr.ptr<#ptr.generic_space>
// LLVM-DAG: define ptr @{{.*}}identity{{.*}}(ptr
pub fn identity(p: Ptr<Generic>) -> Ptr<Generic> { p }

// CHECK-DAG: reussir.record.extract({{.*}}) [1] : !ptr.ptr<#ptr.generic_space>
pub fn second(pair: Pair) -> ConstPtr<Generic> { pair.second }

// HIR: fn #generic<$0 (A): AddrSpace>(v0 (p): Ptr<$0>, v1 (q): ConstPtr<$0>) -> ConstPtr<$0>
fn generic<A: AddrSpace>(p: Ptr<A>, q: ConstPtr<A>) -> ConstPtr<A> { q }

// HIR: #generic::<Generic>(
// CHECK-DAG: call @{{.*}}generic{{.*}}3ptr7Generic
pub fn instantiate(p: Ptr<Generic>, q: ConstPtr<Generic>) -> ConstPtr<Generic> { generic(p, q) }

// CHECK-DAG: func.func @{{.*}}node{{.*}}(%arg0: !ptr.ptr<#ptr.generic_space>) -> !reussir.rc<
pub fn node(p: Ptr<Generic>) -> Node { Node { at: p, next: Nullable::Null } }

pub fn qualified(
    p: core::intrinsic::ptr::Ptr<core::intrinsic::ptr::Generic>,
) -> core::intrinsic::ptr::ConstPtr<Generic> {
    match Slot::Empty { Slot::Empty => unwrap(Slot::Empty, constant(p)), Slot::Full(q) => q }
}

fn constant(p: Ptr<Generic>) -> ConstPtr<Generic> { second(Pair { first: p, second: fallback() }) }
fn fallback() -> ConstPtr<Generic> { core::intrinsic::panic::panic() }
fn unwrap(slot: Slot, otherwise: ConstPtr<Generic>) -> ConstPtr<Generic> {
    match slot { Slot::Empty => otherwise, Slot::Full(p) => p }
}

// A pointer is plain data in cells, tuples and closures.
pub fn through_cell(p: Ptr<Generic>) -> Ptr<Generic> {
    let cell: Cell<Ptr<Generic>> = core::intrinsic::cell::alloc(p);
    core::intrinsic::cell::get(cell)
}
pub fn through_tuple(pair: (Ptr<Generic>, i64)) -> Ptr<Generic> { pair.0 }
pub fn through_closure(p: Ptr<Generic>) -> Ptr<Generic> {
    let get = || p;
    get()
}

// The address space marker is an empty value.
// CHECK-DAG: func.func @{{.*}}marker{{.*}}(%arg0: !reussir.record<compound "__reussir_generic_addr_space" [value] {}>)
pub fn marker(space: Generic) -> Generic { space }
