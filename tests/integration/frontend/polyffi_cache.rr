// REQUIRES: linux
// Fixed compilation requests use rrc's database cache. A warm request must not
// invoke rustc; changes to source or effective options must compile again.
// RUN: rm -rf %t && mkdir -p %t
// RUN: printf '#!/bin/sh\nif [ -n "$CALLS" ]; then echo compile >> "$CALLS"; fi\nif [ -n "$NO_COMPILE" ]; then exit 1; fi\nexec "$REAL_RUSTC" "$@"\n' > %t/rustc
// RUN: chmod +x %t/rustc
// RUN: env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/cache CALLS=%t/cold-calls \
// RUN:   %rrc %s --polyffi-rust-path %t/rustc --emit llvm-ir -o %t/cold.ll
// RUN: test -f %t/cache/rrc/cache.db
// RUN: env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/cache NO_COMPILE=1 \
// RUN:   %rrc %s --polyffi-rust-path %t/rustc --emit llvm-ir -o %t/warm.ll
// RUN: diff %t/cold.ll %t/warm.ll
// RUN: %not env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/cache NO_COMPILE=1 CALLS=%t/failure-calls \
// RUN:   %rrc %s -O none --polyffi-rust-path %t/rustc --emit llvm-ir -o %t/none.ll 2>&1 | %FileCheck %s --check-prefix=MISS
// A failed producer is neither retried in the same call nor cached.
// RUN: test "$(wc -l < %t/failure-calls)" = 1
// RUN: env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/cache \
// RUN:   %rrc %s -O none --polyffi-rust-path %t/rustc --emit llvm-ir -o %t/none.ll
// RUN: env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/cache NO_COMPILE=1 \
// RUN:   %rrc %s -O none --polyffi-rust-path %t/rustc --emit llvm-ir -o %t/none-warm.ll
// RUN: diff %t/none.ll %t/none-warm.ll
// RUN: sed 's/x + 1/x + 2/' %s > %t/changed.rr
// RUN: %not env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/cache NO_COMPILE=1 \
// RUN:   %rrc %t/changed.rr --polyffi-rust-path %t/rustc --emit llvm-ir -o %t/changed.ll 2>&1 | %FileCheck %s --check-prefix=MISS
// Cache open failure falls back to compilation.
// RUN: touch %t/not-a-directory
// RUN: env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/not-a-directory \
// RUN:   %rrc %s --polyffi-rust-path %t/rustc --emit llvm-ir -o %t/no-store.ll
// Concurrent requests for the same cold keys share their producers.
// RUN: env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/concurrent CALLS=%t/parallel-calls \
// RUN:   %python -c "import subprocess,sys; jobs=[subprocess.Popen(sys.argv[2:]+['-o',sys.argv[1]+str(i)+'.ll']) for i in range(4)]; codes=[p.wait() for p in jobs]; assert not any(codes),codes" \
// RUN:   %t/parallel %rrc %s --polyffi-rust-path %t/rustc --emit llvm-ir
// RUN: test "$(wc -l < %t/parallel-calls)" = "$(wc -l < %t/cold-calls)"
// RUN: env REAL_RUSTC=%rustc_path XDG_CONFIG_HOME=%t/config XDG_CACHE_HOME=%t/concurrent NO_COMPILE=1 \
// RUN:   %rrc %s --polyffi-rust-path %t/rustc --emit llvm-ir -o %t/parallel-warm.ll
// MISS: Rust compilation failed

#[ffi(import)]
pub fn add_one(x: u64) -> u64 [{ x + 1 }];

pub fn main() -> u64 {
    add_one(41)
}
