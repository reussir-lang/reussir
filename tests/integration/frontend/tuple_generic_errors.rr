// RUN: %not %rrc %s --emit mir -o - 2>&1 | %FileCheck %s
// Ground validation must recurse through tuple fields, including types that
// were blocked on a generic parameter during elaboration.
pub struct [value] LockHolder<T> { value: (Mutex<T>,) }
pub struct [value] ArcHolder<T> { value: (Arc<T>,) }
pub fn bad_lock(x: LockHolder<(u64, u64)>) {}
pub fn bad_arc(x: ArcHolder<(u64,)>) {}
// CHECK-DAG: inline tuple, which is stored inline rather than as a pointer
// CHECK-DAG: not an rc box
