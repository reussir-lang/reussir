// RUN: env RENE_CACHE_DIR=%t.cache %rene -v build --manifest-path %S/core_num/rene.ncl --build-dir %t.second %rrc_linker 2>&1 | %FileCheck %s
// CHECK-NOT: baking bundled library
// CHECK: restored bundled library from disk cache
