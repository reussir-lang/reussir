enum Tree { Leaf, Branch(Tree, Tree) }
fn build(n: u64, tree: Tree) -> Tree {
    if n == 0 { tree } else { build(n - 1, Tree::Branch{tree, Tree::Leaf}) }
}
fn consume(tree: Tree) -> u64 {
    match tree { Tree::Leaf => 0, _ => 1 }
}
#[ffi(import)]
fn report(value: u64) [{
    { assert_eq!(value, 1); println!("deep cleanup complete"); }
}];
#[main]
pub fn entry() {
    report(consume(build(100000, Tree::Leaf)));
}
