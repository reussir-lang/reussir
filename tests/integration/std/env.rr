// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release --bin env %rrc_linker
// RUN: %python %S/env_reference.py %std_rene_build/release/env%exe_ext

import std::collections::pure::list::List;
import std::env::VarError;
import std::format::Chunk;
import std::format::Display;
import std::format::Format;
import std::format::Options;
import std::format::PrintSuccess;
import std::result::Result;
import std::string::String;
import std::text::Text;

fn check(value: bool) {
    if !value { core::intrinsic::panic::panic() }
}

fn test_text() {
    let lit = Text::from_str("hello λ");
    let owned = Text::from_string(String::from_str("hello ").push_str("λ"));
    let empty_lit = Text::Literal { "" };
    let empty_owned = Text::Owned { String::new() };

    check(lit.len() == 8);
    check(owned.len() == 8);
    check(!lit.is_empty());
    check(empty_lit.is_empty());
    check(empty_owned.is_empty());
    check(empty_lit == empty_owned);
    check(lit == owned);
    check(owned == lit);
    check(lit == Text::Literal { "hello λ" });
    check(owned == Text::Owned { String::from_str("hello λ") });
    check(lit != Text::Literal { "hello" });
    check(owned != Text::Literal { "hello" });
    check(lit.eq_str("hello λ"));
    check(owned.eq_str("hello λ"));
    check(lit.byte_at(0) == 104);
    check(owned.byte_at(0) == 104);
    check(lit.to_string().eq_str("hello λ"));
    check(owned.to_string().eq_str("hello λ"));

    let sliced = lit.write(String::new(), 6, 8);
    check(sliced.eq_str("λ"));
    let sliced_owned = owned.write(String::new(), 0, 5);
    check(sliced_owned.eq_str("hello"));

    let rendered = lit.fmt().append(":".fmt()).append(owned.fmt()).render(Options::default());
    check(rendered.to_string().eq_str("hello λ:hello λ"));
    match rendered.chunks().head().unwrap_or_panic() {
        Chunk::Text(source, start, end) => {
            check(source == lit && start == 0 && end == 8)
        },
        _ => core::intrinsic::panic::panic()
    };
}

fn test_env() {
    check(VarError::NotPresent == VarError::NotPresent);
    check(VarError::NotUnicode == VarError::NotUnicode);
    check(VarError::NotPresent != VarError::NotUnicode);
    check(VarError::NotPresent.fmt().render(Options::default()).to_string().eq_str("NotPresent"));
    check(VarError::NotUnicode.fmt().render(Options::default()).to_string().eq_str("NotUnicode"));

    check(std::env::var(Text::from_str("REUSSIR_STD_ENV_MISSING")) == Result::Err { VarError::NotPresent });
    check(std::env::var(Text::from_string(String::from_str("REUSSIR_STD_ENV_MISSING"))) == Result::Err { VarError::NotPresent });
    check(std::env::var(Text::from_str("")) == Result::Err { VarError::NotPresent });
    check(std::env::var(Text::from_str("BAD=KEY")) == Result::Err { VarError::NotPresent });

    let present_lit = std::env::var(Text::from_str("REUSSIR_STD_ENV_PRESENT"));
    let present_owned = std::env::var(Text::from_string(
        String::from_str("REUSSIR_STD_").push_str("ENV_PRESENT")
    ));
    check(present_lit == Result::Ok { String::from_str("value_λ猫") });
    check(present_owned == Result::Ok { String::from_str("value_λ猫") });

    let empty_val = std::env::var(Text::from_str("REUSSIR_STD_ENV_EMPTY"));
    check(empty_val == Result::Ok { String::new() });

    match std::env::var(Text::from_str("REUSSIR_STD_ENV_CHECK_NON_UTF8")) {
        Ok(flag) => if flag.eq_str("1") {
            check(std::env::var(Text::from_str("REUSSIR_STD_ENV_BAD_UTF8")) == Result::Err { VarError::NotUnicode });
            check(std::env::var(Text::from_string(String::from_str("REUSSIR_STD_ENV_BAD_UTF8"))) == Result::Err { VarError::NotUnicode });
        },
        Err(_) => {}
    };
}

#[main]
pub fn main() {
    test_text();
    test_env();
    let argv = std::env::args();
    check(!argv.is_nil());
    let tail = argv.tail();
    let doc = std::format::join("|".fmt(),
        match tail {
            Nil => List::Nil,
            Cons(first, rest) => List::Cons {
                first.fmt(),
                match rest {
                    Nil => List::Nil,
                    Cons(second, more) => List::Cons {
                        second.fmt(),
                        match more {
                            Nil => List::Nil,
                            Cons(third, _) => List::Cons { third.fmt(), List::Nil }
                        }
                    }
                }
            }
        });
    match doc.dump_stdout(Options::default()) {
        Ok(PrintSuccess::Complete) => {},
        Err(_) => core::intrinsic::panic::panic()
    }
}
