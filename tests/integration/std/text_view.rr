// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release --bin text_view %rrc_linker
// RUN: %std_rene_build/release/text_view%exe_ext

import std::string::String;
import std::text::Text;
import std::text::TextView;
import std::text::CharIter;

fn check(value: bool) {
    if !value { core::intrinsic::panic::panic() }
}

fn check_view(base: Text) {
    let whole = TextView::new(base);
    let suffix = whole.advance(2).unwrap_or_panic().advance(1).unwrap_or_panic();
    check(whole.offset() == 0 && whole.len() == 9);
    check(whole.to_string().unwrap_or_panic().eq_str("abcλ猫!"));
    check(suffix.base() == base);
    check(suffix.offset() == 3 && suffix.len() == 6);
    check(!suffix.is_empty());
    check(suffix.byte_at(0).unwrap_or_panic() == 206);
    check(suffix.byte_at(1).unwrap_or_panic() == 187);
    check(suffix.byte_at(5).unwrap_or_panic() == 33);
    check(suffix.byte_at(6).is_none());
    check(suffix.byte_at(18446744073709551615).is_none());
    check(suffix.eq_str("λ猫!"));
    check(!suffix.eq_str("λ猫?") && !suffix.eq_str("λ猫"));
    check(suffix.to_string().unwrap_or_panic().eq_str("λ猫!"));
    check(suffix.write(String::from_str(">"), 2, 5).unwrap_or_panic().eq_str(">猫"));
    check(suffix.write(String::new(), 0, 7).is_none());
    check(suffix.write(String::new(), 3, 2).is_none());
    check(suffix.write(String::new(), 1, 5).is_none());
    check(suffix.write(String::new(), 0, 3).is_none());
    check(suffix.write(String::new(), 0, 18446744073709551615).is_none());
    check(suffix.advance(1).unwrap_or_panic().offset() == 5);
    check(suffix.advance(1).unwrap_or_panic().eq_str("猫!"));
    check(suffix.advance(2).unwrap_or_panic().offset() == 8);
    check(suffix.advance(2).unwrap_or_panic().eq_str("!"));
    check(suffix.advance(0).unwrap_or_panic() == suffix);
    check(suffix.advance(4).is_none());
    check(suffix.advance(18446744073709551615).is_none());
    let empty = suffix.advance(3).unwrap_or_panic();
    check(empty.is_empty() && empty.offset() == base.len());
    check(empty.eq_str(""));
    check(empty.advance(0).unwrap_or_panic().is_empty());
    check(empty.advance(1).is_none() && empty.byte_at(0).is_none());
    check(empty.to_string().unwrap_or_panic().is_empty());
    check(empty.write(String::from_str("keep"), 0, 0).unwrap_or_panic().eq_str("keep"));
    check(whole.eq_str("abcλ猫!"));
    check(base.decode_char(4).is_none());
    check(base.decode_char(base.len()).is_none());
    check(base.decode_char(18446744073709551615).is_none());
}

fn step(iter: CharIter, expected: char, offset: u64) -> CharIter {
    let (value, next) = iter.next().unwrap_or_panic();
    check(value == expected);
    check(next.view().offset() == offset);
    next
}

fn check_chars(base: Text) {
    let original = base.chars();
    let iter = step(original, '\0', 1);
    let iter = step(iter, 'a', 2);
    let iter = step(iter, 'é', 4);
    let iter = step(iter, '猫', 7);
    let iter = step(iter, '🦀', 11);
    let iter = step(iter, '\u{10ffff}', 15);
    check(iter.next().is_none() && iter.view().is_empty());
    check(iter.next().is_none() && iter.view().offset() == 15);
    check(original.view().offset() == 0);
    check(base.view().advance(6).unwrap_or_panic().is_empty());
    let suffix = CharIter::new(base.view().advance(3).unwrap_or_panic());
    let suffix = step(suffix, '猫', 7);
    check(suffix.view().eq_str("🦀\u{10ffff}"));
}

#[main]
pub fn main() {
    let literal = Text::from_str("abcλ猫!");
    let owned = Text::from_string(String::from_str("abcλ").push_str("猫!"));
    check_view(literal);
    check_view(owned);
    check_chars(Text::from_str("\0aé猫🦀\u{10ffff}"));
    check_chars(Text::from_string(String::from_str("\0aé猫🦀\u{10ffff}")));
    check(Text::from_str("").chars().next().is_none());
    check(Text::from_str("a\u{301}").view().advance(1).unwrap_or_panic().eq_str("\u{301}"));
    check(Text::from_str("a\u{301}").view().advance(2).unwrap_or_panic().is_empty());
    check(literal.view().advance(3).unwrap_or_panic() == owned.view().advance(3).unwrap_or_panic());
    check(Text::from_str("").view() == Text::from_string(String::new()).view());
    let original = String::from_str("abcλ猫!");
    let view = Text::from_string(original).view().advance(3).unwrap_or_panic();
    let changed = original.push_str("changed");
    check(view.eq_str("λ猫!") && changed.eq_str("abcλ猫!changed"));
    let invalid = Text::from_str(core::intrinsic::str::slice("λ", 1)).view();
    check(invalid.advance(1).is_none());
    check(invalid.chars().next().is_none());
    check(invalid.to_string().is_none());
    check(invalid.write(String::new(), 0, 1).is_none());
}
