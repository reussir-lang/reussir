// Dedicated coverage-guided fuzz driver and unit suite for the generic
// Hood-Melville `Queue`.
// Unit cases cover every public method, rotations, persistence, and pops in
// each rotation phase. Fuzz targets check FIFO order, and streams of pushes
// and pops against a `Vec` model.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile fuzz --bin rtqueue %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: fuzz{{[/\\]}}rtqueue

// RUN: env REUSSIR_FUZZ_LIST=1 %std_rene_build/fuzz/rtqueue%exe_ext -runs=0 | %FileCheck %s
// RUN: %std_rene_build/fuzz/rtqueue%exe_ext -runs=64 -seed=12345 -artifact_prefix=%t.

// CHECK:      rtqueue/new: unit
// CHECK-NEXT: rtqueue/snoc: unit
// CHECK-NEXT: rtqueue/uncons: unit
// CHECK-NEXT: rtqueue/persistence: unit
// CHECK-NEXT: rtqueue/bulk rotation: unit
// CHECK-NEXT: rtqueue/interleaved rotation: unit
// CHECK-NEXT: rtqueue/pops during rotation: unit
// CHECK-NEXT: rtqueue/shared payload: unit
// CHECK-NEXT: rtqueue/fifo (fuzz):
// CHECK-NEXT: rtqueue/pushes & pops against vector model (fuzz):

import std::collections::cow::vec::Vec;
import std::collections::pure::list::List;
import std::collections::pure::rtqueue::Pop;
import std::collections::pure::rtqueue::Queue;
import std::option::Option;
import test::domain::i32_domain;
import test::domain::list_of;
import test::expect::Outcome;
import test::expect::expect;
import test::expect::fail;
import test::expect::pass;
import test::expect::should_be;
import test::fuzz::fuzz_init;
import test::tree::TestTree;

fn empty_queue() -> Queue<i32> {
    Queue::new()
}

fn test_new() -> Outcome {
    let queue = empty_queue();
    expect(queue.is_empty(), "empty queue should report is_empty")
        .and_then(|| should_be(queue.len(), 0))
        .and_then(|| expect(queue.front().is_none(), "empty queue front should be None"))
        .and_then(|| match queue.uncons() {
            Pop::Empty => pass(),
            Pop::Pop(_, _) => fail("uncons on empty queue should be Empty")
        })
}

fn test_snoc() -> Outcome {
    let queue = empty_queue().snoc(10).snoc(20).snoc(30);
    should_be(queue.front().unwrap_or(-1), 10)
        .and_then(|| should_be(queue.len(), 3))
        .and_then(|| expect(!queue.is_empty(), "non-empty queue should not report is_empty"))
}

fn test_uncons() -> Outcome {
    let queue = empty_queue().snoc(1).snoc(2).snoc(3);
    match queue.uncons() {
        Pop::Pop(first, rest1) =>
            should_be(first, 1).and_then(|| match rest1.uncons() {
                Pop::Pop(second, rest2) =>
                    should_be(second, 2).and_then(|| match rest2.uncons() {
                        Pop::Pop(third, rest3) =>
                            should_be(third, 3).and_then(|| match rest3.uncons() {
                                Pop::Empty => pass(),
                                Pop::Pop(_, _) => fail("expected Empty after 3 uncons")
                            }),
                        Pop::Empty => fail("expected third element")
                    }),
                Pop::Empty => fail("expected second element")
            }),
        Pop::Empty => fail("expected first element")
    }
}

fn drain_decimal(remaining : i32, queue : Queue<i32>, acc : i32) -> i32 {
    if remaining == 0 {
        acc
    } else {
        match queue.uncons() {
            Pop::Pop(value, rest) =>
                drain_decimal(remaining - 1, rest, acc * 10 + value),
            Pop::Empty => 0 - 1
        }
    }
}

fn test_persistence() -> Outcome {
    let base = empty_queue().snoc(4).snoc(5);
    let extended = base.snoc(6);
    should_be(base.len(), 2)
        .and_then(|| should_be(extended.len(), 3))
        .and_then(|| should_be(base.front().unwrap_or(-1), 4))
        .and_then(|| should_be(extended.front().unwrap_or(-1), 4))
        .and_then(|| should_be(drain_decimal(3, extended, 0), 456))
}

fn build(next : i32, end : i32, queue : Queue<i32>) -> Queue<i32> {
    if next == end {
        queue
    } else {
        build(next + 1, end, queue.snoc(next))
    }
}

fn test_bulk_rotation() -> Outcome {
    let queue = build(0, 8, empty_queue());
    should_be(queue.len(), 8)
        .and_then(|| should_be(queue.front().unwrap_or(-1), 0))
        .and_then(|| should_be(drain_decimal(8, queue, 0), 1234567))
}

fn drain_sum(remaining : i32, queue : Queue<i32>, acc : i32) -> i32 {
    if remaining == 0 {
        acc
    } else {
        match queue.uncons() {
            Pop::Pop(value, rest) => drain_sum(remaining - 1, rest, acc + value),
            Pop::Empty => 0 - 1
        }
    }
}

fn pump(index : i32, rounds : i32, queue : Queue<i32>, acc : i32) -> i32 {
    if index == rounds {
        drain_sum(rounds, queue, acc)
    } else {
        match queue.snoc(index * 2).snoc(index * 2 + 1).uncons() {
            Pop::Pop(value, rest) =>
                pump(index + 1, rounds, rest, acc + value),
            Pop::Empty => 0 - 1
        }
    }
}

fn test_interleaved_rotation() -> Outcome {
    should_be(pump(0, 64, empty_queue(), 0), 8128)
}

// Seven pushes start a rotation. The first pop comes during the reversal.
// The eighth push moves the append to its last step, and the second pop
// comes at that step.
fn test_pops_during_rotation() -> Outcome {
    match build(1, 8, empty_queue()).uncons() {
        Pop::Pop(first, rest) => match rest.snoc(8).uncons() {
            Pop::Pop(second, tail) =>
                should_be(first, 1)
                    .and_then(|| should_be(second, 2))
                    .and_then(|| should_be(tail.len(), 6))
                    .and_then(|| should_be(tail.front().unwrap_or(-1), 3))
                    .and_then(|| should_be(drain_decimal(6, tail, 0), 345678))
                    .and_then(|| should_be(drain_decimal(6, rest, 0), 234567)),
            Pop::Empty => fail("expected second element")
        },
        Pop::Empty => fail("expected first element")
    }
}

struct Item {
    value : i32
}

fn empty_item_queue() -> Queue<Item> {
    Queue::new()
}

fn test_shared_payload() -> Outcome {
    let queue = empty_item_queue().snoc(Item { value: 7 }).snoc(Item { value: 11 });
    match queue.uncons() {
        Pop::Pop(first, rest1) =>
            should_be(first.value, 7).and_then(|| match rest1.uncons() {
                Pop::Pop(second, rest2) =>
                    should_be(second.value, 11)
                        .and_then(|| expect(rest2.is_empty(), "queue should be empty after draining items")),
                Pop::Empty => fail("expected second item")
            }),
        Pop::Empty => fail("expected first item")
    }
}

fn check_drain(items : List<i32>, queue : Queue<i32>) -> Outcome {
    match items {
        List::Nil => match queue.uncons() {
            Pop::Empty => pass(),
            Pop::Pop(_, _) => fail("queue not empty after draining all items")
        },
        List::Cons(expected, rest_items) => match queue.uncons() {
            Pop::Pop(actual, rest_queue) =>
                should_be(actual, expected).and_then(|| check_drain(rest_items, rest_queue)),
            Pop::Empty => fail("queue emptied before all items were drained")
        }
    }
}

fn test_fifo(items : List<i32>) -> Outcome {
    let queue = items.fold_left(empty_queue(), |q : Queue<i32>, x : i32| q.snoc(x));
    should_be(queue.len(), items.len())
        .and_then(|| check_drain(items, queue))
}

fn drain_model(queue : Queue<i32>, pushed : Vec<i32>, popped : u64) -> Outcome {
    match queue.uncons() {
        Pop::Pop(value, rest) =>
            should_be(value, pushed.get(popped).unwrap_or(-1))
                .and_then(|| drain_model(rest, pushed, popped + 1)),
        Pop::Empty => should_be(popped, pushed.len())
    }
}

// The model is the list of pushed values and the count of pops.
fn run_operations(
    ops : Vec<i32>,
    index : u64,
    queue : Queue<i32>,
    pushed : Vec<i32>,
    popped : u64
) -> Outcome {
    should_be(queue.len(), pushed.len() - popped)
        .and_then(|| should_be(queue.is_empty(), popped == pushed.len()))
        .and_then(|| should_be(queue.front().unwrap_or(-1), pushed.get(popped).unwrap_or(-1)))
        .and_then(|| match ops.get(index) {
            Option::None => drain_model(queue, pushed, popped),
            Option::Some(op) => if op >= 0 {
                run_operations(ops, index + 1, queue.snoc(op), pushed.push(op), popped)
            } else {
                match queue.uncons() {
                    Pop::Pop(value, rest) =>
                        should_be(value, pushed.get(popped).unwrap_or(-1))
                            .and_then(|| should_be(queue.front().unwrap_or(-1), value))
                            .and_then(|| run_operations(ops, index + 1, rest, pushed, popped + 1)),
                    Pop::Empty =>
                        should_be(popped, pushed.len())
                            .and_then(|| run_operations(ops, index + 1, queue, pushed, popped))
                }
            }
        })
}

// A nonnegative value is pushed. A negative value pops the front.
fn fuzz_operations(ops : Vec<i32>) -> Outcome {
    run_operations(ops, 0, empty_queue(), Vec::new(), 0)
}

fn suite() -> TestTree {
    TestTree::group("rtqueue")
        .with_case("new", test_new)
        .with_case("snoc", test_snoc)
        .with_case("uncons", test_uncons)
        .with_case("persistence", test_persistence)
        .with_case("bulk rotation", test_bulk_rotation)
        .with_case("interleaved rotation", test_interleaved_rotation)
        .with_case("pops during rotation", test_pops_during_rotation)
        .with_case("shared payload", test_shared_payload)
        .with_fuzz("fifo (fuzz)", list_of(i32_domain()), test_fifo)
        .with_fuzz(
            "pushes & pops against vector model (fuzz)",
            i32_domain().in_range(-4, 8).vec().max_len(128),
            fuzz_operations
        )
}

pub fn fuzz_entry() {
    fuzz_init(suite());
}

extern "C" trampoline "reussir_fuzz_init" = fuzz_entry;
