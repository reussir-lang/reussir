// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release --bin format %rrc_linker
// RUN: %std_rene_build/release/format%exe_ext | %FileCheck %s
// CHECK: format tests passed

import std::format::Format;
import std::console::Ansi;
import std::console::Color;
import std::format::Display;
import std::format::Options;
import std::format::BreakSpec;
import std::format::Field;
import std::format::Fields;
import std::format::PrintSuccess;
import std::collections::pure::list::List;
import std::string::String;
import std::string::RawString;
import std::option::Option;
import std::result::Result;
import std::text::Text;

#[ffi(import)]
fn assert_text(actual: RawString, expected: str) [{
    assert_eq!(actual.as_str(), &*expected);
}];

fn expect(doc: Format, width: u64, expected: str) {
    assert_text(doc.render(Options { width: width, indent: 4 }).to_string().into_raw(), expected)
}
fn check(value: bool) {
    if !value { core::intrinsic::panic::panic() }
}
fn escapes(style: Ansi, expected: str) {
    check(String::from_str(style.escape()).eq_str(expected))
}
fn two(a: Format, b: Format) -> List<Format> { List::Cons { a, List::Cons { b, List::Nil } } }
fn three(a: Format, b: Format, c: Format) -> List<Format> {
    List::Cons { a, two(b, c) }
}

pub struct Point { pub x: i64, pub y: i64 }
impl Display for Point {
    fn fmt(self: Self) -> Format {
        Format::Struct { Text::from_str("Point"), Fields::Named {
            List::Cons { Field { name: Text::from_str("x"), value: self.x.fmt() },
                List::Cons { Field { name: Text::from_str("y"), value: self.y.fmt() }, List::Nil } }
        } }
    }
}
fn generic<T: Display>(value: T) -> Format { value.fmt() }

fn basic() {
    expect(Format::Empty, 0, "");
    expect(Format::Tuple { List::Nil }, 0, "()");
    expect(Format::Tuple { List::Cons { "x".fmt(), List::Nil } }, 4, "(x,)");
    expect(Format::Tuple { List::Cons { "x".fmt(), List::Nil } }, 3, "(\n    x,\n)");
    let pair = Format::Tuple { two("one".fmt(), "two".fmt()) };
    expect(pair, 10, "(one, two)");
    expect(pair, 9, "(\n    one,\n    two,\n)");
    expect(pair, 8, "(\n    one,\n    two,\n)");
    expect(pair, 0, "(\n    one,\n    two,\n)");
    expect("long_identifier".fmt().group(), 2, "long_identifier");
    expect(Format::Hardline.append(Format::Hardline), 80, "\n\n");
    expect("a".fmt().append(Format::Line), 80, "a");
    expect("a  ".fmt(), 80, "a  ");
    expect("a".fmt().append(Format::Hardline).nest(4), 80, "a\n");
    expect("a\nb".fmt().nest(2).group(), 80, "a\n  b");
    expect(Format::Character { '\n' }, 80, "\n");
    let zero_indent = pair.render(Options { width: 1, indent: 0 }).to_string();
    check(zero_indent.eq_str("(\none,\ntwo,\n)"));
}

fn groups() {
    let words = "aa".fmt().append(Format::Line).append("bb".fmt())
        .append(Format::Line).append("cc".fmt());
    expect(words.group(), 8, "aa bb cc");
    expect(words.group(), 7, "aa\nbb\ncc");
    expect(words.fill(), 5, "aa bb\ncc");
    expect(words.fill(), 4, "aa\nbb\ncc");
    expect(words, 5, "aa bb\ncc");
    let inner = "b".fmt().append(Format::Line).append("c".fmt()).group();
    expect("aaaa".fmt().append(Format::Line).append(inner).group(), 4, "aaaa\nb c");
    expect("a".fmt().append(Format::Line).append("b".fmt())
        .append(Format::Hardline).append("c".fmt()).group(), 80, "a\nb\nc");
    let punctuation = "left".fmt().append(Format::Break { BreakSpec {
        flat: " => ", before: " {", after: "> ", offset: -2
    } }).append("right".fmt()).nest(4).group();
    expect(punctuation, 13, "left => right");
    expect(punctuation, 12, "left {\n  > right");
    expect(std::format::call("f".fmt(), two("a".fmt(), "b".fmt()), 2), 7,
        "f(a, b)");
}

fn records() {
    let point = generic(Point { x: 10, y: 20 });
    expect(point, 22, "Point { x: 10, y: 20 }");
    expect(point, 20, "Point {\n    x: 10,\n    y: 20,\n}");
    expect(Format::Struct { Text::from_str("Unit"), Fields::Named { List::Nil } }, 0, "Unit {}");
    expect(Format::Struct { Text::from_str("Pair"), Fields::Positional {
        two("a".fmt(), "b".fmt()) } }, 13, "Pair { a, b }");
    expect(Format::Struct { Text::from_str("Pair"), Fields::Positional {
        two("a".fmt(), "b".fmt()) } }, 11, "Pair {\n    a,\n    b,\n}");
    expect(Format::Tuple { two(point, "ok".fmt()) }, 25,
        "(\n    Point {\n        x: 10,\n        y: 20,\n    },\n    ok,\n)");
}

fn strings_and_traits() {
    let dynamic = String::from_str("λ").push_string(String::from_str("猫"));
    expect(dynamic.fmt(), 2, "λ猫");
    let literal_view = Text::from_str("prefix λ猫").view();
    expect(generic(literal_view), 80, "prefix λ猫");
    expect(literal_view.slice_byte(7, literal_view.len()).unwrap_or_panic().fmt(), 2, "λ猫");
    expect(literal_view.slice_byte(12, literal_view.len()).unwrap_or_panic().fmt(), 0, "");
    let owned_view = Text::from_string(String::from_str("prefix λ\n猫")).view();
    expect(owned_view.slice_byte(7, owned_view.len()).unwrap_or_panic().fmt().nest(2), 80, "λ\n  猫");
    expect(literal_view.slice_byte(8, literal_view.len()).unwrap_or_panic().fmt(), 80, "�猫");
    expect(owned_view.slice_byte(8, owned_view.len()).unwrap_or_panic().fmt().nest(2), 80, "�\n  猫");
    expect(Text::from_str("猫!").view().tail_byte().unwrap_or_panic().fmt(), 80, "��!");
    expect(Text::from_str("猫!").view().slice_byte(2, 4).unwrap_or_panic().fmt(), 80, "�!");
    expect(Text::from_string(String::from_str("🦀!")).view().tail_byte().unwrap_or_panic().fmt(), 80, "���!");
    expect(Text::from_str("λ").view().tail_byte().unwrap_or_panic().fmt(), 80, "�");
    expect(Text::from_str(core::intrinsic::str::slice("λ", 1)).view().fmt(), 80, "�");
    let bounded = Text::from_str("aλ猫🦀z").view();
    expect(bounded.tail_char().unwrap_or_panic().init_char().unwrap_or_panic().fmt(), 80, "λ猫🦀");
    expect(bounded.slice_byte(0, 2).unwrap_or_panic().fmt(), 80, "a�");
    expect(bounded.slice_byte(2, 8).unwrap_or_panic().fmt(), 80, "�猫�");
    expect(bounded.slice_byte(2, 2).unwrap_or_panic().fmt(), 80, "");
    let bounded_owned = Text::from_string(String::from_str("aλ猫🦀z")).view();
    expect(bounded_owned.slice_byte(2, 8).unwrap_or_panic().fmt(), 80, "�猫�");
    expect(Format::Tuple { two(dynamic.fmt(), "x".fmt()) }, 7, "(λ猫, x)");
    expect(Format::Tuple { two(dynamic.fmt(), "x".fmt()) }, 6, "(\n    λ猫,\n    x,\n)");
    expect(String::from_str("λ\n猫").fmt().nest(2), 80, "λ\n  猫");
    let earlier = String::from_str("keep");
    let changed = earlier.push_string(earlier);
    check(earlier.eq_str("keep"));
    check(changed.eq_str("keepkeep"));
    check(String::new().push_string_range(dynamic, 2, 5).eq_str("猫"));
    expect(true.fmt(), 80, "true");
    expect(false.fmt(), 80, "false");
    expect('λ'.fmt(), 80, "λ");
    expect((18446744073709551615 as u64).fmt(), 80, "18446744073709551615");
    expect(((0 as i64) - 9223372036854775807 - 1).fmt(), 80, "-9223372036854775808");
    expect(((0 as i8) - 127 - 1).fmt(), 80, "-128");
    expect((0 as u32).fmt(), 80, "0");
    expect(Option::Some { (12 as i16) }.fmt(), 80, "Some(12)");
    let values: List<i32> = List::Cons { 1, List::Cons { 2, List::Nil } };
    expect(values.fmt(), 80, "[1, 2]");
    expect(values.fmt(), 6, "[1, 2]");
    expect(values.fmt(), 5, "[1,\n2]");
    let result: Result<i32, str> = Result::Ok { 3 };
    check(result.is_ok());
    check(result.map(|n: i32| n + 2).unwrap_or(0) == 5);
    expect(result.fmt(), 80, "Ok(3)");
    let error: Result<i32, str> = Result::Err { "bad" };
    check(error.is_err());
    check(error.map(|n: i32| n + 1).unwrap_or(9) == 9);
    expect(error.map_err(|s: str| s.fmt()).fmt(), 80, "Err(bad)");
    check(result.and_then(|n: i32| Result::Ok { n * 2 }).unwrap_or(0) == 6);
}

fn deep() {
    let (_, doc) = while [i = (0 as i32), doc = "x".fmt()] (i < 10000) {
        (i + 1, doc.group().nest(0))
    };
    expect(doc, 1, "x");
    let (_, left, right) = while [i = (0 as i32), left = Format::Empty, right = Format::Empty] (i < 10000) {
        (i + 1, left.append("x".fmt()), "x".fmt().append(right))
    };
    let a = left.render(Options::default()).to_string();
    let b = right.render(Options::default()).to_string();
    check(a.len() == 10000);
    check(a == b);
}

fn ansi() {
    let red = Ansi::Foreground { Color::Red };
    let blue = Ansi::Foreground { Color::Blue };
    expect("λ猫".fmt().ansi(red), 2, "\u{1b}[31mλ猫\u{1b}[0m");
    expect(Format::Ansi { red, Format::Empty }, 0, "\u{1b}[31m\u{1b}[0m");
    let words = "aa".fmt().ansi(red).append(Format::Line).append("bb".fmt());
    expect(words.group(), 5, "\u{1b}[31maa\u{1b}[0m bb");
    expect(words.group(), 4, "\u{1b}[31maa\u{1b}[0m\nbb");
    expect(words.fill(), 5, "\u{1b}[31maa\u{1b}[0m bb");
    expect(words.fill(), 4, "\u{1b}[31maa\u{1b}[0m\nbb");
    let nested = "a".fmt().append("b".fmt().ansi(blue)).append("c".fmt()).ansi(red);
    expect(nested, 3, "\u{1b}[31ma\u{1b}[34mb\u{1b}[0m\u{1b}[31mc\u{1b}[0m");
    check(nested.render(Options::default()).to_plain_string().eq_str("abc"));
    expect("x".fmt().ansi(Ansi::Bold).ansi(red), 1,
        "\u{1b}[31m\u{1b}[1mx\u{1b}[0m\u{1b}[31m\u{1b}[0m");
    expect("a".fmt().append("b".fmt().ansi(Ansi::Reset)).append("c".fmt()).ansi(red), 3,
        "\u{1b}[31ma\u{1b}[0mb\u{1b}[0m\u{1b}[31mc\u{1b}[0m");
    expect("x".fmt().ansi(Ansi::Background { Color::BrightBlue }).ansi(red), 1,
        "\u{1b}[31m\u{1b}[104mx\u{1b}[0m\u{1b}[31m\u{1b}[0m");
    expect("a".fmt().append(Format::Line.ansi(red)), 80, "a\u{1b}[31m\u{1b}[0m");
    expect(Format::Hardline.append("x".fmt().ansi(red)).nest(2), 80,
        "\n  \u{1b}[31mx\u{1b}[0m");
    expect("a".fmt().append(Format::Line).ansi(red).append("b".fmt()), 80,
        "\u{1b}[31ma \u{1b}[0mb");
    expect("a".fmt().append(Format::Line).group().ansi(red).append(Format::Hardline), 80,
        "\u{1b}[31ma\u{1b}[0m\n");
    expect("a".fmt().append(Format::Line.ansi(blue)).append("b".fmt()).ansi(red), 80,
        "\u{1b}[31ma\u{1b}[34m \u{1b}[0m\u{1b}[31mb\u{1b}[0m");
    let (_, deep) = while [i = (0 as i32), doc = "x".fmt()] (i < 10000) {
        (i + 1, doc.ansi(red))
    };
    let rendered = deep.render(Options::default());
    check(rendered.to_plain_string().eq_str("x"));
    check(rendered.to_string().len() == 10000 * 5 + 9999 * 9 + 4 + 1);
    escapes(Ansi::Foreground { Color::Black }, "\u{1b}[30m");
    escapes(Ansi::Foreground { Color::Red }, "\u{1b}[31m");
    escapes(Ansi::Foreground { Color::Green }, "\u{1b}[32m");
    escapes(Ansi::Foreground { Color::Yellow }, "\u{1b}[33m");
    escapes(Ansi::Foreground { Color::Blue }, "\u{1b}[34m");
    escapes(Ansi::Foreground { Color::Magenta }, "\u{1b}[35m");
    escapes(Ansi::Foreground { Color::Cyan }, "\u{1b}[36m");
    escapes(Ansi::Foreground { Color::White }, "\u{1b}[37m");
    escapes(Ansi::Foreground { Color::BrightBlack }, "\u{1b}[90m");
    escapes(Ansi::Foreground { Color::BrightRed }, "\u{1b}[91m");
    escapes(Ansi::Foreground { Color::BrightGreen }, "\u{1b}[92m");
    escapes(Ansi::Foreground { Color::BrightYellow }, "\u{1b}[93m");
    escapes(Ansi::Foreground { Color::BrightBlue }, "\u{1b}[94m");
    escapes(Ansi::Foreground { Color::BrightMagenta }, "\u{1b}[95m");
    escapes(Ansi::Foreground { Color::BrightCyan }, "\u{1b}[96m");
    escapes(Ansi::Foreground { Color::BrightWhite }, "\u{1b}[97m");
    escapes(Ansi::Foreground { Color::Default }, "\u{1b}[39m");
    escapes(Ansi::Background { Color::Black }, "\u{1b}[40m");
    escapes(Ansi::Background { Color::Red }, "\u{1b}[41m");
    escapes(Ansi::Background { Color::Green }, "\u{1b}[42m");
    escapes(Ansi::Background { Color::Yellow }, "\u{1b}[43m");
    escapes(Ansi::Background { Color::Blue }, "\u{1b}[44m");
    escapes(Ansi::Background { Color::Magenta }, "\u{1b}[45m");
    escapes(Ansi::Background { Color::Cyan }, "\u{1b}[46m");
    escapes(Ansi::Background { Color::White }, "\u{1b}[47m");
    escapes(Ansi::Background { Color::BrightBlack }, "\u{1b}[100m");
    escapes(Ansi::Background { Color::BrightRed }, "\u{1b}[101m");
    escapes(Ansi::Background { Color::BrightGreen }, "\u{1b}[102m");
    escapes(Ansi::Background { Color::BrightYellow }, "\u{1b}[103m");
    escapes(Ansi::Background { Color::BrightBlue }, "\u{1b}[104m");
    escapes(Ansi::Background { Color::BrightMagenta }, "\u{1b}[105m");
    escapes(Ansi::Background { Color::BrightCyan }, "\u{1b}[106m");
    escapes(Ansi::Background { Color::BrightWhite }, "\u{1b}[107m");
    escapes(Ansi::Background { Color::Default }, "\u{1b}[49m");
    escapes(Ansi::Bold, "\u{1b}[1m");
    escapes(Ansi::Dim, "\u{1b}[2m");
    escapes(Ansi::Italic, "\u{1b}[3m");
    escapes(Ansi::Underline, "\u{1b}[4m");
    escapes(Ansi::Reverse, "\u{1b}[7m");
    escapes(Ansi::Strikethrough, "\u{1b}[9m");
    escapes(Ansi::Reset, "\u{1b}[0m");
}

#[main]
pub fn main() {
    basic();
    groups();
    records();
    strings_and_traits();
    deep();
    ansi();
    match "format tests passed\n".fmt().dump_stdout(Options::default()) {
        Ok(PrintSuccess::Complete) => {},
        Err(_) => core::intrinsic::panic::panic()
    }
}
