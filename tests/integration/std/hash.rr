// std::hash end to end: user `Hash` impls (ground and generic)
// dispatching through the `Hasher` trait into the pure value hashers,
// the scalar write helpers and seeding.
//
// The reference vector digests are pinned against the documented algorithms
// (classic Fx for FastHasher; an aHash-derived state with the
// primitive update specialization for StrongHasher), computed
// independently. They guard the chaining and state handling: any drift
// shows up as a changed number rather than as quietly different hashes.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release --bin hash %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}hash

// RUN: %std_rene_build/release/hash%exe_ext | %FileCheck %s
// CHECK:      hash
// CHECK-NEXT:   ✔ reference vectors
// CHECK-NEXT:   ✔ properties
// CHECK-NEXT:   ✔ primitives
// CHECK-EMPTY:
// CHECK-NEXT: 3 examples, 0 failures

import std::hash::Hash;
import std::hash::Hasher;
import std::hash::FastHasher;
import std::hash::StrongHasher;
import test::expect::Outcome;
import test::expect::expect;
import test::expect::should_be;
import test::expect::should_not_be;
import test::tree::TestTree;

pub struct Point { pub x : i64, pub y : i64 }

impl Hash for Point {
    fn hash<H: Hasher>(self: Self, state: H) -> H {
        state.write_i64(self.x).write_i64(self.y)
    }
}

// A generic composite recursing through both bounds, so the impl is
// instantiated at the user's call shape rather than pre-monomorphized.
pub struct Pair<A, B> { pub a : A, pub b : B }

impl<A : Hash, B : Hash> Hash for Pair<A, B> {
    fn hash<H: Hasher>(self: Self, state: H) -> H {
        state.write(self.a).write(self.b)
    }
}

fn test_reference_vectors() -> Outcome {
    // Point { 1, 2 } is two u64 writes.
    should_be(std::hash::fast_hash(Point { x: 1, y: 2 }), 7659469028595837896)
        .and_then(|| should_be(std::hash::strong_hash(Point { x: 1, y: 2 }), 14389719906271566111))
        // Single scalar, default seed.
        .and_then(|| should_be(std::hash::fast_hasher().write_u64(42).finish(), 6807129317463932018))
        .and_then(|| should_be(std::hash::strong_hasher().write_u64(42).finish(), 7367054577293084200))
        // Single scalar, explicit seed.
        .and_then(|| should_be(std::hash::fast_hasher_seeded(12345).write_u64(42).finish(), 2483310807519886546))
        .and_then(|| should_be(std::hash::strong_hasher_seeded(12345).write_u64(42).finish(), 15056869511168324300))
        // Mixed widths plus bool and char, through the streaming hasher.
        .and_then(|| should_be(
            std::hash::fast_hasher()
                .write_u32(7).write_u16(8).write_u8(9).write_bool(true).write_char('z')
                .finish(),
            11710304454334885276
        ))
        .and_then(|| should_be(
            std::hash::strong_hasher()
                .write_u32(7).write_u16(8).write_u8(9).write_bool(true).write_char('z')
                .finish(),
            16033770625569700645
        ))
        // Streaming with an explicit seed.
        .and_then(|| should_be(std::hash::fast_hasher_seeded(99).write_u64(5).finish(), 18396363454642202825))
        .and_then(|| should_be(std::hash::strong_hasher_seeded(99).write_u64(5).finish(), 6887771581839605075))
}

// The hash-container construction pattern: the hasher type is a bound,
// and the consumer builds it with `H::default()`.
fn digest_of<H : Hasher, T : Hash>(value : T) -> u64 {
    value.hash(H::default()).finish()
}

fn test_properties() -> Outcome {
    let base = std::hash::fast_hasher().write_u64(1);
    let branch = base.write_u64(2).finish();
    let via_trait : FastHasher = Hasher::default();
    should_be(
        std::hash::fast_hash(Point { x: 3, y: 4 }),
        std::hash::fast_hash(Point { x: 3, y: 4 })
    )
    .and_then(|| should_not_be(
        std::hash::fast_hash(Point { x: 3, y: 4 }),
        std::hash::fast_hash(Point { x: 4, y: 3 })
    ))
    .and_then(|| should_not_be(
        std::hash::fast_hash(Point { x: 3, y: 4 }),
        std::hash::strong_hash(Point { x: 3, y: 4 })
    ))
    .and_then(|| should_not_be(
        std::hash::fast_hasher_seeded(1).write_u64(5).finish(),
        std::hash::fast_hasher_seeded(2).write_u64(5).finish()
    ))
    .and_then(|| should_be(
        std::hash::fast_hash(Pair { a: Point { x: 1, y: 2 }, b: Point { x: 3, y: 4 } }),
        std::hash::fast_hash(Pair { a: Point { x: 1, y: 2 }, b: Point { x: 3, y: 4 } })
    ))
    .and_then(|| should_not_be(
        std::hash::fast_hash(Pair { a: Point { x: 1, y: 2 }, b: Point { x: 3, y: 4 } }),
        std::hash::fast_hash(Pair { a: Point { x: 3, y: 4 }, b: Point { x: 1, y: 2 } })
    ))
    .and_then(|| should_not_be(
        std::hash::fast_hasher().write_i64(1).write_i64(2).finish(),
        std::hash::fast_hasher().write_i64(2).write_i64(1).finish()
    ))
    .and_then(|| should_be(
        std::hash::fast_hasher().write_i64(0 - 1).finish(),
        std::hash::fast_hasher().write_u64(18446744073709551615).finish()
    ))
    .and_then(|| should_be(
        std::hash::strong_hasher().write_u8(7).finish(),
        std::hash::strong_hasher().write_u64(7).finish()
    ))
    .and_then(|| should_be(
        std::hash::strong_hasher().write_i32(0 - 1).finish(),
        std::hash::strong_hasher().write_u32(4294967295).finish()
    ))
    .and_then(|| should_be(base.finish(), std::hash::fast_hasher().write_u64(1).finish()))
    .and_then(|| should_not_be(branch, base.finish()))
    .and_then(|| should_be(
        digest_of<FastHasher, Point>(Point { x: 3, y: 4 }),
        std::hash::fast_hash(Point { x: 3, y: 4 })
    ))
    .and_then(|| should_be(
        digest_of<StrongHasher, Point>(Point { x: 3, y: 4 }),
        std::hash::strong_hash(Point { x: 3, y: 4 })
    ))
    .and_then(|| should_be(
        FastHasher::from_entropy(99).write_u64(5).finish(),
        std::hash::fast_hasher_seeded(99).write_u64(5).finish()
    ))
    .and_then(|| should_be(
        StrongHasher::from_entropy(99).write_u64(5).finish(),
        std::hash::strong_hasher_seeded(99).write_u64(5).finish()
    ))
    .and_then(|| should_not_be(
        FastHasher::from_entropy(99).write_u64(5).finish(),
        FastHasher::default().write_u64(5).finish()
    ))
    .and_then(|| should_be(
        via_trait.write_u64(1234).finish(),
        std::hash::fast_hasher().write_u64(1234).finish()
    ))
}

fn test_primitives() -> Outcome {
    let n : u64 = 42;
    let i : i32 = 0 - 7;
    should_be(std::hash::fast_hash(n), std::hash::fast_hasher().write_u64(42).finish())
        .and_then(|| should_be(std::hash::fast_hash(i), std::hash::fast_hasher().write_i32(0 - 7).finish()))
        .and_then(|| should_be(std::hash::fast_hash(true), std::hash::fast_hasher().write_bool(true).finish()))
        .and_then(|| should_be(std::hash::fast_hash('z'), std::hash::fast_hasher().write_char('z').finish()))
        .and_then(|| should_be(n.hash(std::hash::fast_hasher()).finish(), std::hash::fast_hash(n)))
        .and_then(|| should_be(std::hash::fast_hasher().write(n).finish(), std::hash::fast_hash(n)))
        .and_then(|| should_be(digest_of<StrongHasher, u64>(n), std::hash::strong_hash(n)))
}

#[main]
pub fn main() {
    test::runner::run_main(TestTree::group("hash")
        .with_case("reference vectors", || test_reference_vectors())
        .with_case("properties", || test_properties())
        .with_case("primitives", || test_primitives()))
}
