// Dedicated coverage-guided fuzz driver and unit suite for the growable
// copy-on-write UTF-8 `String` (`std::string::String`) and its `Text`/`TextView`
// integration.
// Unit cases cover construction (`new`, `from_str`, `push_char`, `push_str`),
// copy-on-write isolation of shared versions, byte-wise equality across build
// paths, multi-byte UTF-8 lengths, and range/raw-handle operations
// (`byte_at`, `push_string`, `push_str_range`, `push_string_range`,
// `from_raw`/`into_raw`).
// Fuzz targets exercise stateful copy-on-write mutation streams against a
// byte-list reference model, full Unicode scalar UTF-8 round-tripping,
// concatenation/range monoid laws, and arbitrary byte-slice UTF-8 boundary
// validation.

// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile fuzz --bin string %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: fuzz{{[/\\]}}string

// RUN: env REUSSIR_FUZZ_LIST=1 %std_rene_build/fuzz/string%exe_ext -runs=0 | %FileCheck %s
// RUN: %std_rene_build/fuzz/string%exe_ext -runs=128 -seed=12345 -artifact_prefix=%t.

// CHECK:      string/build: unit
// CHECK-NEXT: string/cow: unit
// CHECK-NEXT: string/eq: unit
// CHECK-NEXT: string/unicode: unit
// CHECK-NEXT: string/ranges and raw roundtrip: unit
// CHECK-NEXT: string/data pointers: unit
// CHECK-NEXT: string/cow operations & byte-list model (fuzz):
// CHECK-NEXT: string/utf8 char roundtrip & scalar boundaries (fuzz):
// CHECK-NEXT: string/concatenation monoid & range algebra (fuzz):
// CHECK-NEXT: string/byte slicing & utf8 boundary validation (fuzz):

import std::collections::cow::vec::Vec;
import std::collections::pure::list::List;
import std::option::Option;
import std::string::String;
import std::text::Text;
import std::text::TextView;
import test::domain::char_domain;
import test::domain::string;
import test::domain::tuple3;
import test::domain::u64_domain;
import test::domain::u8_domain;
import test::expect::Outcome;
import test::expect::expect;
import test::expect::should_be;
import test::fuzz::fuzz_init;
import test::tree::TestTree;

// ------------------------------ Unit cases ------------------------------

fn test_build() -> Outcome {
    let empty = String::new();
    let hello = String::new().push_str("hel").push_char('l').push_char('o');
    let greeting = hello.push_str(", world");
    expect(empty.is_empty() && empty.eq_str(""), "empty string properties")
        .and_then(|| should_be(hello.len(), 5))
        .and_then(|| expect(
            hello.eq_str("hello") && !hello.eq_str("hello!") && !hello.eq_str("hellp"),
            "hello literal comparisons"
        ))
        .and_then(|| should_be(greeting.len(), 12))
        .and_then(|| expect(greeting.eq_str("hello, world"), "greeting contents"))
        .and_then(|| expect(String::from_str("abc").eq_str("abc"), "from_str contents"))
}

fn test_cow() -> Outcome {
    let old = String::from_str("ab");
    // `old` stays live below, so deriving `grown` shares the runtime buffer;
    // the append takes the copy-on-write clone and leaves `old` untouched.
    let grown = old.push_char('c').push_str("de");
    let self_doubled = old.push_string(old);
    let self_ranged = grown.push_string_range(grown, 1, 4);
    should_be(old.len(), 2)
        .and_then(|| expect(old.eq_str("ab"), "retained version untouched"))
        .and_then(|| should_be(grown.len(), 5))
        .and_then(|| expect(grown.eq_str("abcde"), "grown version updated"))
        .and_then(|| expect(self_doubled.eq_str("abab"), "self push_string"))
        .and_then(|| expect(self_ranged.eq_str("abcdebcd"), "self push_string_range"))
}

fn test_eq() -> Outcome {
    let pushed = String::new().push_char('a').push_char('b');
    let copied = String::from_str("ab");
    expect(pushed == copied, "equal across build paths")
        .and_then(|| expect(!(pushed == String::from_str("ba")), "distinct order unequal"))
        .and_then(|| expect(pushed != String::new(), "non-empty != empty"))
        .and_then(|| expect(String::new() == String::new(), "empty == empty"))
}

fn test_unicode() -> Outcome {
    // 'é' is 2 bytes, '猫' is 3 bytes, and '🦀' is 4 bytes in UTF-8.
    let s = String::new()
        .push_char('a')
        .push_char('é')
        .push_char('猫')
        .push_char('🦀');
    should_be(s.len(), 10)
        .and_then(|| expect(s.eq_str("aé猫🦀"), "multi-byte push_char contents"))
        .and_then(|| should_be(String::from_str("héllo").len(), 6))
}

fn test_ranges_and_raw() -> Outcome {
    let lit = "aλ猫🦀z";
    // Byte offsets in "aλ猫🦀z": 'a' [0..1], 'λ' [1..3], '猫' [3..6], '🦀' [6..10], 'z' [10..11]
    let picked = String::new()
        .push_str_range(lit, 1, 3)
        .push_str_range(lit, 6, 10)
        .push_str_range(lit, 3, 3);
    let base = String::from_str(lit);
    let sub = String::from_str("[").push_string_range(base, 3, 10).push_char(']');
    let roundtrip = String::from_raw(sub.into_raw());
    expect(picked.eq_str("λ🦀"), "push_str_range multi-byte slices")
        .and_then(|| expect(sub.eq_str("[猫🦀]"), "push_string_range slice"))
        .and_then(|| expect(base.eq_str("aλ猫🦀z"), "source string intact after push_string_range"))
        .and_then(|| should_be(base.byte_at(0), 97))
        .and_then(|| should_be(base.byte_at(1), 206))
        .and_then(|| should_be(base.byte_at(2), 187))
        .and_then(|| should_be(base.byte_at(10), 122))
        .and_then(|| expect(roundtrip == sub, "from_raw(into_raw()) roundtrip"))
}

fn byte_through(p : ConstPtr<core::ptr::Generic>, index : i64) -> u8 {
    core::ptr::load(core::ptr::offset(p, index, core::ptr::PtrArithFlag::Inbounds))
}

// A data pointer keeps nothing alive, so each owner is read through its
// pointer first and used once more afterwards.
fn test_data_ptr() -> Outcome {
    let owned = String::from_str("hello");
    let owned_first = byte_through(owned.unsafe_data_ptr(), 0);
    let owned_last = byte_through(owned.unsafe_data_ptr(), 4);
    let owned_len = owned.len();

    let literal = byte_through(core::intrinsic::str::unsafe_data_ptr("world"), 1);

    let text = Text::from_string(String::from_str("abcdef"));
    let text_byte = byte_through(text.unsafe_data_ptr(), 2);
    let view = text.view().slice_byte(3, 5).unwrap_or_panic();
    let view_byte = byte_through(view.unsafe_data_ptr(), 1);
    let text_len = text.len();

    let bytes = Vec::new().push(7 as u8).push(9 as u8).push(11 as u8);
    let vec_byte = byte_through(bytes.unsafe_data_ptr(), 2);
    let vec_len = bytes.len();

    should_be(owned_first, 104)
        .and_then(|| should_be(owned_last, 111))
        .and_then(|| should_be(owned_len, 5))
        .and_then(|| should_be(literal, 111))
        .and_then(|| should_be(text_byte, 99))
        .and_then(|| should_be(view_byte, 101))
        .and_then(|| should_be(text_len, 6))
        .and_then(|| should_be(vec_byte, 11))
        .and_then(|| should_be(vec_len, 3))
}

// ------------------------------ Model helpers ------------------------------

fn list_append_u8(a : List<u8>, b : List<u8>) -> List<u8> {
    match a {
        List::Nil => b,
        List::Cons(x, xs) => List::Cons { x, list_append_u8(xs, b) }
    }
}

fn utf8_encode_char(ch : char) -> List<u8> {
    let cp = ch as u32;
    if cp < 128 {
        List::Cons { cp as u8, List::Nil }
    } else {
        if cp < 2048 {
            let b0 = (192 | (cp >> 6)) as u8;
            let b1 = (128 | (cp & 63)) as u8;
            List::Cons { b0, List::Cons { b1, List::Nil } }
        } else {
            if cp < 65536 {
                let b0 = (224 | (cp >> 12)) as u8;
                let b1 = (128 | ((cp >> 6) & 63)) as u8;
                let b2 = (128 | (cp & 63)) as u8;
                List::Cons { b0, List::Cons { b1, List::Cons { b2, List::Nil } } }
            } else {
                let b0 = (240 | (cp >> 18)) as u8;
                let b1 = (128 | ((cp >> 12) & 63)) as u8;
                let b2 = (128 | ((cp >> 6) & 63)) as u8;
                let b3 = (128 | (cp & 63)) as u8;
                List::Cons {
                    b0,
                    List::Cons { b1, List::Cons { b2, List::Cons { b3, List::Nil } } }
                }
            }
        }
    }
}

fn char_utf8_len(ch : char) -> u64 {
    let cp = ch as u32;
    if cp < 128 {
        1
    } else {
        if cp < 2048 {
            2
        } else {
            if cp < 65536 { 3 } else { 4 }
        }
    }
}

fn string_to_bytes_from(s : String, idx : u64) -> List<u8> {
    if idx >= s.len() {
        List::Nil
    } else {
        List::Cons { s.byte_at(idx), string_to_bytes_from(s, idx + 1) }
    }
}

fn str_range_to_bytes(lit : str, idx : u64, end : u64) -> List<u8> {
    if idx >= end {
        List::Nil
    } else {
        List::Cons {
            core::intrinsic::str::byte_at(lit, idx),
            str_range_to_bytes(lit, idx + 1, end)
        }
    }
}

fn string_matches_bytes_at(s : String, idx : u64, model : List<u8>) -> bool {
    match model {
        List::Nil => idx == s.len(),
        List::Cons(b, rest) =>
            idx < s.len()
                && s.byte_at(idx) == b
                && string_matches_bytes_at(s, idx + 1, rest)
    }
}

fn string_matches_model(s : String, model : List<u8>) -> bool {
    s.len() == model.len()
        && s.is_empty() == model.is_nil()
        && s.eq_str("") == model.is_nil()
        && (s == s)
        && string_matches_bytes_at(s, 0, model)
}

fn is_utf8_boundary_in_string(s : String, pos : u64) -> bool {
    if pos > s.len() {
        false
    } else {
        if pos == s.len() {
            true
        } else {
            let b = s.byte_at(pos);
            b < 128 || b >= 192
        }
    }
}

fn snap_to_char_boundary(s : String, raw_pos : u64) -> u64 {
    let clamped = if raw_pos > s.len() { s.len() } else { raw_pos };
    while [p = clamped] (p > 0 && !is_utf8_boundary_in_string(s, p)) {
        p - 1
    }
}

fn pick_char(chars : List<char>, idx : u64) -> char {
    match chars {
        List::Nil => 'x',
        List::Cons(h, t) => if idx == 0 { h } else { pick_char(t, idx - 1) }
    }
}

fn pick_string(strings : List<String>, idx : u64) -> String {
    match strings {
        List::Nil => String::from_str("fallback"),
        List::Cons(h, t) => if idx == 0 { h } else { pick_string(t, idx - 1) }
    }
}

// Valid UTF-8 boundary table for the 11-byte literal "aλ猫🦀z":
// [0, 1, 3, 6, 10, 11]
fn sample_lit_boundary(slot : u8) -> u64 {
    match slot % 6 {
        0 => 0,
        1 => 1,
        2 => 3,
        3 => 6,
        4 => 10,
        _ => 11
    }
}

// ------------------------ Fuzz 1: COW & byte model ------------------------

fn apply_string_ops(
    ops : Vec<u8>,
    chars : List<char>,
    chunks : List<String>,
    idx : u64,
    cur : String,
    cur_model : List<u8>,
    saved : String,
    saved_model : List<u8>
) -> bool {
    if !string_matches_model(cur, cur_model) {
        false
    } else {
        if idx >= ops.len() {
            string_matches_model(saved, saved_model)
                && (cur == saved) == (cur.len() == saved.len() && string_matches_bytes_at(cur, 0, saved_model))
        } else {
            let b = ops.get(idx).unwrap_or(0);
            let kind = b % 9;
            let arg = b / 9;
            if kind == 0 || kind == 1 {
                // push_char with UTF-8 char
                let ch = if chars.is_nil() {
                    'a'
                } else {
                    pick_char(chars, (arg as u64) % chars.len())
                };
                let next_s = cur.push_char(ch);
                let next_m = list_append_u8(cur_model, utf8_encode_char(ch));
                apply_string_ops(ops, chars, chunks, idx + 1, next_s, next_m, saved, saved_model)
            } else {
                if kind == 2 {
                    // push_string with an input chunk (bounded to avoid exponential blowup)
                    let chunk = if chunks.is_nil() {
                        String::from_str("λ")
                    } else {
                        pick_string(chunks, (arg as u64) % chunks.len())
                    };
                    if cur.len() + chunk.len() <= 512 {
                        let next_s = cur.push_string(chunk);
                        let next_m = list_append_u8(cur_model, string_to_bytes_from(chunk, 0));
                        apply_string_ops(ops, chars, chunks, idx + 1, next_s, next_m, saved, saved_model)
                    } else {
                        apply_string_ops(ops, chars, chunks, idx + 1, cur, cur_model, saved, saved_model)
                    }
                } else {
                    if kind == 3 {
                        // push_str_range from a multi-byte static literal
                        let lit = "aλ猫🦀z";
                        let b1 = sample_lit_boundary(arg);
                        let b2 = sample_lit_boundary(arg / 6);
                        let (lo, hi) = if b1 <= b2 { (b1, b2) } else { (b2, b1) };
                        let next_s = cur.push_str_range(lit, lo, hi);
                        let next_m = list_append_u8(cur_model, str_range_to_bytes(lit, lo, hi));
                        apply_string_ops(ops, chars, chunks, idx + 1, next_s, next_m, saved, saved_model)
                    } else {
                        if kind == 4 {
                            // push_string_range from `saved` (or self when `saved` shares with `cur`)
                            let r1 = snap_to_char_boundary(saved, (arg as u64) % (saved.len() + 1));
                            let r2 = snap_to_char_boundary(saved, ((arg as u64) * 7 + 3) % (saved.len() + 1));
                            let (lo, hi) = if r1 <= r2 { (r1, r2) } else { (r2, r1) };
                            if cur.len() + (hi - lo) <= 512 {
                                let sub = String::new().push_string_range(saved, lo, hi);
                                let next_s = cur.push_string_range(saved, lo, hi);
                                let next_m = list_append_u8(cur_model, string_to_bytes_from(sub, 0));
                                string_matches_model(saved, saved_model)
                                    && apply_string_ops(
                                        ops,
                                        chars,
                                        chunks,
                                        idx + 1,
                                        next_s,
                                        next_m,
                                        saved,
                                        saved_model
                                    )
                            } else {
                                apply_string_ops(ops, chars, chunks, idx + 1, cur, cur_model, saved, saved_model)
                            }
                        } else {
                            if kind == 5 {
                                // Snapshot `cur` into `saved` so subsequent mutations exercise COW cloning!
                                apply_string_ops(ops, chars, chunks, idx + 1, cur, cur_model, cur, cur_model)
                            } else {
                                if kind == 6 {
                                    // Fork `cur` back from `saved` while keeping `saved` alive!
                                    string_matches_model(saved, saved_model)
                                        && apply_string_ops(
                                            ops,
                                            chars,
                                            chunks,
                                            idx + 1,
                                            saved,
                                            saved_model,
                                            saved,
                                            saved_model
                                        )
                                } else {
                                    if kind == 7 {
                                        // Self-append (`cur.push_string(cur)`) when small
                                        if cur.len() <= 128 {
                                            let doubled = cur.push_string(cur);
                                            let doubled_m = list_append_u8(cur_model, cur_model);
                                            string_matches_model(cur, cur_model)
                                                && apply_string_ops(
                                                    ops,
                                                    chars,
                                                    chunks,
                                                    idx + 1,
                                                    doubled,
                                                    doubled_m,
                                                    saved,
                                                    saved_model
                                                )
                                        } else {
                                            apply_string_ops(
                                                ops,
                                                chars,
                                                chunks,
                                                idx + 1,
                                                String::new(),
                                                List::Nil,
                                                saved,
                                                saved_model
                                            )
                                        }
                                    } else {
                                        // Raw handle round-trip + `push_str`
                                        let rt = String::from_raw(cur.into_raw()).push_str("!");
                                        let next_m = list_append_u8(
                                            cur_model,
                                            List::Cons { 33, List::Nil }
                                        );
                                        apply_string_ops(
                                            ops,
                                            chars,
                                            chunks,
                                            idx + 1,
                                            rt,
                                            next_m,
                                            saved,
                                            saved_model
                                        )
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

fn fuzz_cow_and_byte_model(
    input : (Vec<u8>, List<char>, List<String>)
) -> Outcome {
    let (ops, chars, chunks) = input;
    expect(
        apply_string_ops(
            ops,
            chars,
            chunks,
            0,
            String::new(),
            List::Nil,
            String::new(),
            List::Nil
        ),
        "String COW operation stream diverged from byte-list model"
    )
}

// ---------------- Fuzz 2: UTF-8 scalar roundtrip & boundaries ----------------

fn build_from_chars(chars : List<char>, acc : String) -> String {
    match chars {
        List::Nil => acc,
        List::Cons(c, rest) => build_from_chars(rest, acc.push_char(c))
    }
}

fn expected_utf8_byte_len(chars : List<char>, acc : u64) -> u64 {
    match chars {
        List::Nil => acc,
        List::Cons(c, rest) => expected_utf8_byte_len(rest, acc + char_utf8_len(c))
    }
}

fn verify_forward_decode(
    text : Text,
    offset : u64,
    expected : List<char>
) -> bool {
    match expected {
        List::Nil => offset == text.len() && text.decode_char(offset).is_none(),
        List::Cons(exp_ch, rest) => {
            let width = char_utf8_len(exp_ch);
            // Every interior continuation byte must reject `decode_char`.
            let (_, mids_ok) = while [k = (1 as u64), ok = true] (k < width && ok) {
                (k + 1, text.decode_char(offset + k).is_none())
            };
            match text.decode_char(offset) {
                Option::None => false,
                Option::Some(decoded) => {
                    let (got_ch, next_off) = decoded;
                    mids_ok
                        && got_ch == exp_ch
                        && next_off == offset + width
                        && verify_forward_decode(text, next_off, rest)
                }
            }
        }
    }
}

fn verify_backward_view(view : TextView, expected_rev : List<char>) -> bool {
    match expected_rev {
        List::Nil =>
            view.is_empty()
                && view.last_char().is_none()
                && view.init_char().is_none(),
        List::Cons(exp_ch, rest) => {
            let last_ok = match view.last_char() {
                Option::Some(c) => c == exp_ch,
                Option::None => false
            };
            match view.init_char() {
                Option::None => false,
                Option::Some(prefix) => last_ok && verify_backward_view(prefix, rest)
            }
        }
    }
}

fn fuzz_utf8_char_roundtrip(chars : List<char>) -> Outcome {
    let built = build_from_chars(chars, String::new());
    let exp_len = expected_utf8_byte_len(chars, 0);
    let text = Text::from_string(built);
    let view = text.view();
    let materialized = match view.to_string() {
        Option::Some(s) => s == built,
        Option::None => false
    };
    expect(
        built.len() == exp_len
            && verify_forward_decode(text, 0, chars)
            && verify_backward_view(view, chars.reverse())
            && materialized,
        "UTF-8 push_char / decode_char / TextView roundtrip failed"
    )
}

// ------------- Fuzz 3: Concatenation monoid & range algebra -------------

fn fuzz_concat_monoid_algebra(input : (String, String, String)) -> Outcome {
    let (a, b, c) = input;
    let a_snap = a;
    let b_snap = b;
    let c_snap = c;
    let ab = a.push_string(b);
    let bc = b.push_string(c);
    let ab_c = ab.push_string(c);
    let a_bc = a.push_string(bc);
    let left_id = String::new().push_string(a);
    let right_id = a.push_string(String::new());
    let lit_id = a.push_str("");
    let prefix_a = String::new().push_string_range(ab_c, 0, a.len());
    let middle_b = String::new().push_string_range(ab_c, a.len(), a.len() + b.len());
    let suffix_c = String::new().push_string_range(
        ab_c,
        a.len() + b.len(),
        ab_c.len()
    );
    expect(
        ab.len() == a.len() + b.len()
            && ab_c.len() == a.len() + b.len() + c.len()
            && ab_c == a_bc
            && left_id == a
            && right_id == a
            && lit_id == a
            && prefix_a == a
            && middle_b == b
            && suffix_c == c
            && a == a_snap
            && b == b_snap
            && c == c_snap
            && (a == b) == (b == a),
        "String concatenation monoid or push_string_range law failed"
    )
}

// -------- Fuzz 4: Arbitrary byte slicing & UTF-8 boundary validation --------

fn string_range_bytes_eq(
    src : String,
    start : u64,
    end : u64,
    dst : String,
    dst_offset : u64
) -> bool {
    let (_, ok) = while [i = start, ok = true] (i < end && ok) {
        (i + 1, src.byte_at(i) == dst.byte_at(dst_offset + (i - start)))
    };
    ok
}

fn fuzz_byte_slicing_boundaries(input : (String, u64, u64)) -> Outcome {
    let (s, i, j) = input;
    let view = Text::from_string(s).view();
    let in_bounds = i <= j && j <= s.len();
    let valid_utf8_bounds = in_bounds
        && is_utf8_boundary_in_string(s, i)
        && is_utf8_boundary_in_string(s, j);
    let slice_opt = view.slice_byte(i, j);
    let write_opt = view.write(String::from_str("pre:"), i, j);
    let slice_ok = match slice_opt {
        Option::None => !in_bounds,
        Option::Some(sub) => {
            let sub_str_opt = sub.to_string();
            let to_str_ok = match sub_str_opt {
                Option::None => !valid_utf8_bounds,
                Option::Some(sub_s) =>
                    valid_utf8_bounds
                        && sub_s.len() == j - i
                        && string_range_bytes_eq(s, i, j, sub_s, 0)
            };
            sub.len() == j - i && sub.offset() == i && to_str_ok
        }
    };
    let write_ok = match write_opt {
        Option::None => !valid_utf8_bounds,
        Option::Some(written) => {
            let expected_direct = String::from_str("pre:").push_string_range(s, i, j);
            valid_utf8_bounds
                && written.len() == 4 + (j - i)
                && written == expected_direct
                && string_range_bytes_eq(s, i, j, written, 4)
        }
    };
    expect(
        slice_ok && write_ok,
        "Owned String byte-slice or UTF-8 boundary validation failed"
    )
}

fn suite() -> TestTree {
    TestTree::group("string")
        .with_case("build", test_build)
        .with_case("cow", test_cow)
        .with_case("eq", test_eq)
        .with_case("unicode", test_unicode)
        .with_case("ranges and raw roundtrip", test_ranges_and_raw)
        .with_case("data pointers", test_data_ptr)
        .with_fuzz(
            "cow operations & byte-list model (fuzz)",
            tuple3(
                u8_domain().vec().max_len(48),
                char_domain().utf8().list_with_len(0, 16),
                string().utf8().max_len(16).list_with_len(0, 8)
            ),
            fuzz_cow_and_byte_model
        )
        .with_fuzz(
            "utf8 char roundtrip & scalar boundaries (fuzz)",
            char_domain().utf8().list_with_len(0, 32),
            fuzz_utf8_char_roundtrip
        )
        .with_fuzz(
            "concatenation monoid & range algebra (fuzz)",
            tuple3(
                string().utf8().max_len(24),
                string().utf8().max_len(24),
                string().utf8().max_len(24)
            ),
            fuzz_concat_monoid_algebra
        )
        .with_fuzz(
            "byte slicing & utf8 boundary validation (fuzz)",
            tuple3(
                string().utf8().max_len(32),
                u64_domain().in_range_u64(0, 40),
                u64_domain().in_range_u64(0, 40)
            ),
            fuzz_byte_slicing_boundaries
        )
}

pub fn fuzz_entry() {
    fuzz_init(suite());
}

extern "C" trampoline "reussir_fuzz_init" = fuzz_entry;
