{
  package = {
    name = "std_integration",
    version = "0.1.0",
  },
  dependencies = {
    std = { path = "../../../library/std", version = "^0.1" },
    test_utils = { path = "../../../library/test_utils", version = "^0.1" },
    test = { path = "../../../library/test", version = "^0.1" },
  },
  profiles = {
    fuzz = {
      opt = "aggressive",
      fuzzer = true,
    },
  },
  targets = {
    cow_hash = { kind = 'executable, path = "cow_hash.rr" },
    cow_ordered = { kind = 'executable, path = "cow_ordered.rr" },
    cow_seq = { kind = 'executable, path = "cow_seq.rr" },
    env = { kind = 'executable, path = "env.rr" },
    fingertree = { kind = 'executable, path = "fingertree.rr", fuzzer = true },
    format = { kind = 'executable, path = "format.rr" },
    format_cases = { kind = 'executable, path = "format_cases.rr" },
    hash = { kind = 'executable, path = "hash.rr" },
    hashmap = { kind = 'executable, path = "hashmap.rr" },
    hashset = { kind = 'executable, path = "hashset.rr" },
    heap = { kind = 'executable, path = "heap.rr", fuzzer = true },
    intmap = { kind = 'executable, path = "intmap.rr" },
    list = { kind = 'executable, path = "list.rr", fuzzer = true },
    option = { kind = 'executable, path = "option.rr" },
    random = { kind = 'executable, path = "random.rr" },
    rtqueue = { kind = 'executable, path = "rtqueue.rr" },
    string = { kind = 'executable, path = "string.rr" },
    test_cli = { kind = 'executable, path = "test_cli.rr" },
    test_fuzz = { kind = 'executable, path = "test_fuzz.rr", fuzzer = true },
    test_runner = { kind = 'executable, path = "test_runner.rr" },
    test_tree = { kind = 'executable, path = "test_tree.rr" },
    text_view = { kind = 'executable, path = "text_view.rr" },
    wavl = { kind = 'executable, path = "wavl.rr", fuzzer = true },
  },
}
