// RUN: %rene build --manifest-path %S/rene.ncl --build-dir %std_rene_build --profile release --bin hashset %rrc_linker | %FileCheck %s --check-prefix=LISTING
// LISTING: release{{[/\\]}}hashset

// RUN: %std_rene_build/release/hashset%exe_ext | %FileCheck %s
// CHECK:      hashset
// CHECK-NEXT:   ✔ basics
// CHECK-NEXT:   ✔ algebra
// CHECK-NEXT:   ✔ transforms
// CHECK-NEXT:   ✔ adaptive
// CHECK-NEXT:   ✔ churn
// CHECK-NEXT:   ✔ model equivalence (fuzz)
// CHECK-EMPTY:
// CHECK-NEXT: 6 examples, 0 failures

import std::collections::pure::hashset::HashSet;
import std::collections::pure::hashset::TakeResult;
import std::collections::pure::list::List;
import std::collections::pure::wavlset::WavlSet;
import std::hash::Hash;
import std::hash::Hasher;
import std::option::Option;
import test::domain::i64_domain;
import test::domain::list_of;
import test::expect::Outcome;
import test::expect::expect;
import test::expect::should_be;
import test::tree::TestTree;

pub struct [value] Key {
    id : i64,
    digest : u64
}

impl PartialEq for Key {
    fn eq(self : Self, other : Self) -> bool { self.id == other.id }
}

impl Eq for Key {}

impl Hash for Key {
    fn hash<H : Hasher>(self : Self, state : H) -> H {
        state.write_u64(self.digest)
    }
}

fn controlled(id : i64, digest : u64) -> Key {
    Key { id, digest }
}

fn int_key(id : i64) -> Key {
    controlled(id, id as u64)
}

fn test_basics() -> Outcome {
    let empty : HashSet<Key> = HashSet::new();
    let seeded : HashSet<Key> = HashSet::with_seed(88);
    let set = empty.insert(int_key(1)).insert(int_key(2)).insert(int_key(2));
    let shape = empty.is_empty() && empty.len() == 0 && set.len() == 2
        && !set.is_empty() && seeded.hash_seed() == 88
        && seeded.clear().hash_seed() == 88;
    let membership = set.contains(int_key(1)) && set.contains(int_key(2))
        && !set.contains(int_key(3))
        && match set.get(int_key(2)) {
            Option::Some(value) => value.id == 2,
            Option::None => false
        }
        && HashSet::singleton(int_key(9)).contains(int_key(9))
        && HashSet::singleton_seeded(int_key(8), 44).hash_seed() == 44;
    let taken = match set.take(int_key(2)) {
        TakeResult::Taken(value, rest) =>
            value.id == 2 && rest.len() == 1 && !rest.contains(int_key(2)),
        TakeResult::Missing(_) => false
    };
    let missing = match set.take(int_key(7)) {
        TakeResult::Missing(original) => original.len() == 2,
        TakeResult::Taken(_, _) => false
    };
    expect(shape, "shape checks failed")
        .and_then(|| expect(membership, "membership checks failed"))
        .and_then(|| expect(taken, "take Taken checks failed"))
        .and_then(|| expect(missing, "take Missing checks failed"))
}

fn test_algebra() -> Outcome {
    let left : HashSet<Key> = HashSet::new()
        .insert(int_key(1)).insert(int_key(2)).insert(int_key(3));
    let right : HashSet<Key> = HashSet::with_seed(71)
        .insert(int_key(3)).insert(int_key(4));
    let union = left.union(right);
    let intersection = left.intersection(right);
    let difference = left.difference(right);
    let symmetric = left.symmetric_difference(right);
    let subset : HashSet<Key> = HashSet::new().insert(int_key(1)).insert(int_key(3));
    let equal : HashSet<Key> = HashSet::with_seed(999)
        .insert(int_key(3)).insert(int_key(2)).insert(int_key(1));
    let disjoint : HashSet<Key> = HashSet::new().insert(int_key(8)).insert(int_key(9));
    let values = union.len() == 4 && union.contains(int_key(1))
        && union.contains(int_key(4))
        && intersection.len() == 1 && intersection.contains(int_key(3))
        && difference.len() == 2 && difference.contains(int_key(1))
        && difference.contains(int_key(2))
        && symmetric.len() == 3 && symmetric.contains(int_key(1))
        && symmetric.contains(int_key(2)) && symmetric.contains(int_key(4))
        && !symmetric.contains(int_key(3));
    let relations = subset.is_subset(left) && left.is_superset(subset)
        && subset.is_proper_subset(left) && left.is_proper_superset(subset)
        && left.is_disjoint(disjoint) && left.equals(equal)
        && left == equal && left != right;
    expect(values, "algebra values checks failed")
        .and_then(|| expect(relations, "algebra relations checks failed"))
}

fn sample_values() -> List<Key> {
    List::Cons {
        int_key(1),
        List::Cons {
            int_key(2),
            List::Cons {
                int_key(3),
                List::Cons { int_key(2), List::Cons { int_key(4), List::Nil } }
            }
        }
    }
}

fn test_transforms() -> Outcome {
    let set : HashSet<Key> = HashSet::from_list_seeded(sample_values(), 123);
    let evens = set.filter(|value| value.id % 2 == 0);
    let parity = set.map(|value| int_key(value.id % 2));
    let traversal = set.to_list().len() == 4
        && set.fold_left(0, |sum, value| sum + value.id) == 10;
    let transforms = evens.len() == 2 && evens.contains(int_key(2))
        && evens.contains(int_key(4))
        && evens.hash_seed() == 123 && parity.len() == 2
        && parity.contains(int_key(0)) && parity.contains(int_key(1));
    let predicates = set.count_if(|value| value.id >= 3) == 2
        && set.any(|value| value.id == 4) && set.all(|value| value.id > 0)
        && match set.find(|value| value.id == 3) {
            Option::Some(value) => value.id == 3,
            Option::None => false
        };
    expect(traversal, "traversal checks failed")
        .and_then(|| expect(transforms, "transforms checks failed"))
        .and_then(|| expect(predicates, "predicates checks failed"))
}

fn insert_slots(
    set : HashSet<Key>,
    current : i64,
    end : i64
) -> HashSet<Key> {
    if current >= end {
        set
    } else {
        insert_slots(set.insert(controlled(current, current as u64)), current + 1, end)
    }
}

fn check_slots(set : HashSet<Key>, current : i64, end : i64) -> bool {
    if current >= end {
        true
    } else {
        set.contains(controlled(current, current as u64))
            && check_slots(set, current + 1, end)
    }
}

fn insert_collisions(
    set : HashSet<Key>,
    current : i64,
    end : i64
) -> HashSet<Key> {
    if current >= end {
        set
    } else {
        insert_collisions(set.insert(controlled(current, 13)), current + 1, end)
    }
}

fn remove_collisions(
    set : HashSet<Key>,
    current : i64,
    end : i64
) -> HashSet<Key> {
    if current >= end {
        set
    } else {
        remove_collisions(set.remove(controlled(current, 13)), current + 1, end)
    }
}

fn test_adaptive() -> Outcome {
    let empty : HashSet<Key> = HashSet::new();
    let four = insert_slots(empty, 0, 4);
    let five = insert_slots(four, 4, 5);
    let demoted = five.remove(controlled(4, 4));
    let grown = insert_slots(demoted, 5, 40);
    let collisions = insert_collisions(grown, 100, 116);
    let collapsed = remove_collisions(collisions, 100, 115);
    let persistent = five.contains(controlled(4, 4))
        && !demoted.contains(controlled(4, 4));
    should_be(four.len(), 4)
        .and_then(|| should_be(five.len(), 5))
        .and_then(|| should_be(demoted.len(), 4))
        .and_then(|| should_be(grown.len(), 39))
        .and_then(|| expect(check_slots(four, 0, 4), "four slots check failed"))
        .and_then(|| expect(check_slots(five, 0, 5), "five slots check failed"))
        .and_then(|| expect(check_slots(demoted, 0, 4), "demoted slots check failed"))
        .and_then(|| expect(check_slots(grown, 0, 4) && check_slots(grown, 5, 40), "grown slots check failed"))
        .and_then(|| expect(!demoted.contains(controlled(4, 4)), "demoted should not contain removed key"))
        .and_then(|| should_be(collisions.len(), 55))
        .and_then(|| should_be(collapsed.len(), 40))
        .and_then(|| expect(collapsed.contains(controlled(115, 13)), "collapsed should retain 115"))
        .and_then(|| expect(collisions.contains(controlled(100, 13)), "collisions should retain 100"))
        .and_then(|| expect(collisions.contains(controlled(115, 13)), "collisions should retain 115"))
        .and_then(|| expect(persistent, "five/demoted persistence check failed"))
}

fn lcg(seed : i64) -> i64 {
    (seed * 1103515245 + 12345) % 2147483648
}

fn agree(
    set : HashSet<Key>,
    model : WavlSet<i64>,
    value : i64,
    end : i64
) -> bool {
    if value >= end {
        true
    } else {
        set.contains(int_key(value)) == model.contains(value)
            && agree(set, model, value + 1, end)
    }
}

fn churn(
    set : HashSet<Key>,
    model : WavlSet<i64>,
    seed : i64,
    steps : i64
) -> bool {
    if steps == 0 {
        set.len() == model.len() && agree(set, model, 0, 128)
    } else {
        let next = lcg(seed);
        let value = next % 128;
        if next % 4 == 0 {
            churn(set.remove(int_key(value)), model.remove(value), next, steps - 1)
        } else {
            churn(set.insert(int_key(value)), model.insert(value), next, steps - 1)
        }
    }
}

fn test_churn() -> Outcome {
    let set : HashSet<Key> = HashSet::new();
    expect(churn(set, WavlSet::new(), 20260810, 1200), "HashSet churn should match WavlSet")
}

fn model_equivalence(ops : List<i64>) -> Outcome {
    let (set, model) = ops.fold_left(
        (HashSet::new(), WavlSet::new()),
        |state : (HashSet<Key>, WavlSet<i64>), op : i64| {
            let (s, w) = state;
            let k = op >> 2;
            if (op & 3) == 0 {
                (s.remove(int_key(k)), w.remove(k))
            } else {
                (s.insert(int_key(k)), w.insert(k))
            }
        }
    );
    let all_match = ops.all(|op : i64| {
        let k = op >> 2;
        set.contains(int_key(k)) == model.contains(k)
    });
    should_be(set.len(), model.len())
        .and_then(|| expect(all_match, "HashSet and WavlSet membership should match"))
}

#[main]
pub fn main() {
    test::runner::run_main(TestTree::group("hashset")
        .with_case("basics", test_basics)
        .with_case("algebra", test_algebra)
        .with_case("transforms", test_transforms)
        .with_case("adaptive", test_adaptive)
        .with_case("churn", test_churn)
        .with_fuzz(
            "model equivalence (fuzz)",
            list_of(i64_domain()),
            model_equivalence
        ))
}
