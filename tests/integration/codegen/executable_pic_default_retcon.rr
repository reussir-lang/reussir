// REQUIRES: linux
// As `executable_pic_default.rr`, for a program without closures: the
// destructor of a recursive value (`Tree`, with two recursive fields) uses
// retcon tables, which also hold code addresses. Without `--relocation-mode`,
// the executable must have no text relocations, and the dynlib must link.
//
// The IR check makes sure that the program has such a table. The tables are
// private constants without a symbol, so `llvm-nm` cannot show their section.

// RUN: %rrc %s -o %t.ll --emit llvm-ir -O none
// RUN: %FileCheck %s --check-prefix=IR < %t.ll

// RUN: %rrc %s -o %t.exe --emit executable -O none %rrc_linker
// RUN: %t.exe
// RUN: %llvm-readobj --dynamic-table %t.exe | %FileCheck %s

// `__reussir_main` is the dynlib's one export, so the link uses lld.
// RUN: %rrc %s -o %t.so --emit dynlib -O none %rrc_linker
// RUN: %llvm-readobj --dynamic-table %t.so | %FileCheck %s

// IR: {{\.retcon\.[a-z0-9.]+}} = private constant {{.*}}ptr @

// CHECK: DynamicSection [
// CHECK-NOT: TEXTREL

enum Tree {
    Leaf,
    Node(Tree, u64, Tree)
}

fn build(n : u64) -> Tree {
    if n == 0 { Tree::Leaf } else { Tree::Node{build(n - 1), n, build(n - 1)} }
}

#[main]
fn main() { let t = build(10); }
