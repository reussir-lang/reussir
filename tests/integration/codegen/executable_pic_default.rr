// REQUIRES: linux
// `rrc --emit executable` and `--emit dynlib` have rustc link a
// position-independent executable or a shared object, so without
// `--relocation-mode` the driver compiles their code position-independent
// too. With LLVM's own default on ELF, static code, a closure vtable went to
// read-only `.rodata` with absolute relocations: GNU ld gave the executable
// text relocations (DT_TEXTREL), and lld, which the dynlib link pins on Linux,
// refused to link ("relocation R_AARCH64_ABS64 cannot be used against local
// symbol; recompile with -fPIC"). On x86-64 the code itself also holds
// absolute addresses. An explicit `--relocation-mode` is kept as given.
//
// `-O none` keeps the indirect call, and so the vtable. The vtable must be in
// writable data (`.data.rel.ro`, which RELRO then makes read-only), not in
// `.rodata`.

// RUN: %rrc %s -o %t.exe --emit executable -O none %rrc_linker
// RUN: %t.exe
// RUN: %llvm-readobj --dynamic-table %t.exe | %FileCheck %s
// RUN: %llvm-nm %t.exe | %FileCheck %s --check-prefix=NM

// `__reussir_main` is the dynlib's one export, so the link uses lld.
// RUN: %rrc %s -o %t.so --emit dynlib -O none %rrc_linker
// RUN: %llvm-readobj --dynamic-table %t.so | %FileCheck %s

// CHECK: DynamicSection [
// CHECK-NOT: TEXTREL

// NM: {{ [dD] .*}}closure6vtable

fn pick(i : u64) -> u64 -> u64 {
    if i == 0 { |x : u64| x + 1 } else { |x : u64| x * 2 }
}
fn ap(f : u64 -> u64, x : u64) -> u64 { f(x) }

#[main]
fn main() { let r = ap(pick(1), 3); }
