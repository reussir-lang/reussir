// CHECK: store { ptr, ptr }
// CHECK: ret void
// CHECK: define private void @{{.*}}.resume.0.callback(ptr {{.*}}, i1 zeroext {{.*}}, ptr {{.*}})
// CHECK: store { ptr, ptr }
// CHECK: ret void
