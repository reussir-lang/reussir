// RUN: %FileCheck %s < %t.i686-unknown-linux-gnu.ll
// RUN: %llc %t.i686-unknown-linux-gnu.ll -filetype=obj -o %t.i686-unknown-linux-gnu.o
// RUN: %rrc %s --target-triple wasm32-wasip1 -Onone --emit llvm-ir -o %t.wasm32-wasip1.ll
// RUN: %FileCheck %s < %t.wasm32-wasip1.ll
// RUN: %llc %t.wasm32-wasip1.ll -filetype=obj -o %t.wasm32-wasip1.o
// RUN: %rrc %s --target-triple riscv64-unknown-linux-gnu -Onone --emit llvm-ir -o %t.riscv64-unknown-linux-gnu.ll
// RUN: %FileCheck %s < %t.riscv64-unknown-linux-gnu.ll
// RUN: %llc %t.riscv64-unknown-linux-gnu.ll -filetype=obj -o %t.riscv64-unknown-linux-gnu.o

enum Tree { Leaf, Branch(Tree, Tree) }
fn consume(tree: Tree) -> u64 { match tree { Tree::Leaf => 0, _ => 1 } }
extern "C" trampoline "consume" = consume;

