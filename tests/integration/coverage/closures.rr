// REQUIRES: profile-runtime
// RUN: %rrc %s --package-name closures --instrument-coverage --emit obj --relocation-mode pic -o %t.o
// RUN: %cc -fprofile-instr-generate %t.o %S/Inputs/reussir_main.c -o %t.exe -L%library_path -lreussir_rt %rpath_flag %extra_sys_libs
// RUN: env LLVM_PROFILE_FILE=%t.profraw %t.exe
// RUN: %llvm-profdata merge -sparse %t.profraw -o %t.profdata
// RUN: %llvm-profdata show --counts --all-functions %t.profdata | %FileCheck %s --check-prefix=COUNTS
// RUN: %llvm-cov export -format=lcov %t.exe -instr-profile=%t.profdata | %FileCheck %s --check-prefix=LINES

// The counter of a closure body counts the runs of the closure, not its
// creations. `entry` makes each of the first three closures one time. They
// run 0 times, 1 time and 4 times. The fourth closure runs 2 times, and
// each run makes the fifth closure, which runs 3 times. The combinators get
// the closures as arguments and call them. Counter 0 counts the entry of
// `entry`, and counters 1 to 5 count the closure bodies in the order of the
// source.

// COUNTS-LABEL: 5entry:
// COUNTS: Function count: 1
// COUNTS-NEXT: Block counts: [0, 1, 4, 2, 6]

enum Choice {
    No,
    Yes(i64)
}

fn apply_n(n : i64, acc : i64, f : i64 -> i64) -> i64 {
    if n <= 0 { acc } else { apply_n(n - 1, f(acc), f) }
}

fn choose(c : Choice, f : i64 -> i64) -> i64 {
    match c {
        Choice::No => 0,
        Choice::Yes(x) => f(x)
    }
}

#[main]
pub fn entry() {
    let never = choose(Choice::No, |x : i64|
        // LINES: DA:[[# @LINE + 1]],0{{$}}
        x * 2);
    let once = choose(Choice::Yes { 3 }, |x : i64|
        // LINES: DA:[[# @LINE + 1]],1{{$}}
        x + 1);
    let many = apply_n(4, 0, |x : i64|
        // LINES: DA:[[# @LINE + 1]],4{{$}}
        x + 3);
    let nested = apply_n(2, 0, |x : i64| {
        // LINES: DA:[[# @LINE + 1]],2{{$}}
        let y = x + 1;
        apply_n(3, y, |z : i64|
            // LINES: DA:[[# @LINE + 1]],6{{$}}
            z + 1)
    });
}
