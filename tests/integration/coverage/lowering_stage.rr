// The counters are lowered before the LLVM pipeline, as clang and rustc do.
// Then the optimizer sees plain counter updates: it moves the counter update
// of the loop body out of the loop, and then it removes the loop.
// RUN: %rrc %s --instrument-coverage --emit llvm-ir -o %t.ll
// RUN: %FileCheck %s < %t.ll

// CHECK-LABEL: define {{.*}}@{{"?}}_RC5count{{"?}}(
// CHECK-NOT: !llvm.loop
// CHECK: ret i64
// CHECK-NEXT: }

pub fn count(n: u64) -> u64 {
    while [i = 0] (i < n) {
        i + 1
    }
}

extern "C" trampoline "count" = count;
